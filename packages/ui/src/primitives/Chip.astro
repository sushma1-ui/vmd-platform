---
/** Chip — pill (999px). Used for subclass tags, outcome tags, filters (§11.6). */
interface Props {
  tone?: 'neutral' | 'positive' | 'caution' | 'critical';
  class?: string;
}
const { tone = 'neutral', class: className = '' } = Astro.props;
---

<span class:list={['chip', `chip--${tone}`, className]}><slot /></span>
<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding-inline: var(--space-3);
    padding-block: var(--space-1);
    border-radius: var(--radius-chip);
    font-family: var(--font-body);
    font-size: var(--type-caption);
    font-weight: 500;
    letter-spacing: 0.02em;
    border: 1px solid var(--color-emphasis);
    color: var(--color-text);
    background: var(--color-ground-warm);
  }
  /* Colour never carries meaning alone — tone changes the border + adds a label. */
  .chip--positive {
    border-color: var(--color-success);
    color: var(--color-success);
  }
  .chip--caution {
    border-color: var(--color-caution);
    color: var(--color-caution);
  }
  .chip--critical {
    border-color: var(--color-critical);
    color: var(--color-critical);
  }
</style>
