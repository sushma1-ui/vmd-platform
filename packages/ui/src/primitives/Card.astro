---
/**
 * Card — situation/service/article card. Whole card clickable via a stretched link
 * on the heading (one focus stop, correct semantics). Hover: gold border + 2px lift.
 *
 * Optional leading `icon` (an SVG path `d` string) renders a branded gold chip for
 * wayfinding — matches the TrustBar icon language for a cohesive system. A directional
 * arrow signals the card is clickable and nudges on hover. Both are decorative
 * (aria-hidden); the accessible name is the heading link. Reduced-motion safe.
 */
interface Props {
  title: string;
  href: string;
  eyebrow?: string;
  /** Optional leading icon: an SVG path `d` string (24x24 viewBox). */
  icon?: string;
  class?: string;
}
const { title, href, eyebrow, icon, class: className = '' } = Astro.props;
---

<article class:list={['card', className]}>
  {
    icon && (
      <span class="card__icon" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path
            d={icon}
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>
    )
  }
  {eyebrow && <p class="card__eyebrow">{eyebrow}</p>}
  <h3 class="card__title">
    <a class="card__link" href={href}>{title}</a>
  </h3>
  <div class="card__body"><slot /></div>
  <span class="card__go" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path
        d="M5 12h14m-6-6 6 6-6 6"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</article>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-ground-light);
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-subtle);
    transition:
      transform var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard);
  }
  .card:hover {
    transform: translateY(-2px);
    border-color: var(--color-emphasis);
    box-shadow: var(--shadow-raised);
  }
  .card:focus-within {
    border-color: var(--color-emphasis);
  }
  .card__icon {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    color: var(--color-emphasis-text);
    background: color-mix(in srgb, var(--color-emphasis) 14%, transparent);
    margin-block-end: var(--space-1);
  }
  .card__eyebrow {
    margin: 0;
    font-size: var(--type-caption);
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }
  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-h3);
    color: var(--color-action);
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  /* stretched link — whole card is the target, single focusable element */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__link:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: 2px;
  }
  .card__body {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--color-text);
  }
  /* directional affordance: signals the card is a link, nudges right on hover */
  .card__go {
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    display: inline-flex;
    align-items: center;
    color: var(--color-interactive-strong);
    transition: transform var(--motion-fast) var(--ease-standard);
  }
  .card:hover .card__go,
  .card:focus-within .card__go {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover,
    .card__go,
    .card:hover .card__go {
      transition: none;
      transform: none;
    }
  }
</style>
