---
/**
 * TrustStrip — every item CHECKABLE (Blueprint §10). Identity (MARN, location,
 * regulator) is single-sourced from @vmd/config. The Google Reviews item shows
 * "★★★★★ Google Reviews" with NO review count: counts are never hardcoded, and a
 * live figure will come from the Google Business Profile API when it is wired.
 */
import { PRACTICE } from '@vmd/config';
interface Props {
  reviewUrl?: string;
  tone?: 'light' | 'dark';
}
const { reviewUrl, tone = 'light' } = Astro.props;
const marnUrl = PRACTICE.regulator.registerUrl;
---

<ul class:list={['trust', `trust--${tone}`]}>
  <li class="trust__item">
    <a href={marnUrl} rel="noopener" target="_blank"
      >Registered Migration Agent (RMA): {PRACTICE.principal.name} · MARN {
        PRACTICE.principal.marn
      }</a
    >
  </li>
  <li class="trust__sep" aria-hidden="true"></li>
  <li class="trust__item">{PRACTICE.address.locality} CBD</li>
  <li class="trust__sep" aria-hidden="true"></li>
  <li class="trust__item"><a href={marnUrl} rel="noopener" target="_blank">Code of Conduct</a></li>
  {
    reviewUrl != null && (
      <>
        <li class="trust__sep" aria-hidden="true" />
        <li class="trust__item">
          <a href={reviewUrl} rel="noopener" target="_blank">
            <span aria-hidden="true">★★★★★</span> Google Reviews
          </a>
        </li>
      </>
    )
  }
</ul>
<style>
  .trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--type-caption);
    letter-spacing: 0.02em;
  }
  .trust__item {
    color: var(--color-text);
  }
  .trust__item a {
    color: inherit;
    text-decoration: none;
    border-block-end: 1px solid var(--color-emphasis);
  }
  .trust__sep {
    inline-size: 1px;
    block-size: var(--space-3);
    background: var(--color-emphasis);
  }
  .trust--dark .trust__item {
    color: var(--color-text-inverse);
  }
</style>
