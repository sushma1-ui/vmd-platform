{
  "name": "vmd-platform",
  "version": "0.0.0",
  "private": true,
  "description": "Visa & Migration Doctors \u2014 digital platform monorepo. Astro (public) + Payload (admin/content API), token-driven design system, modularity enforced in CI.",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,astro,js,mjs,cjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,astro,js,mjs,cjs,json,md,css}\"",
    "boundaries": "depcruise --config .dependency-cruiser.cjs packages apps",
    "duplication": "jscpd",
    "stylelint": "stylelint \"packages/**/*.css\" \"apps/**/*.{astro,css}\"",
    "check:secrets": "bash scripts/check-no-service-role.sh",
    "check:contract": "node scripts/check-cms-contract.mjs",
    "tokens:build": "pnpm --filter @vmd/tokens build",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run boundaries && pnpm run stylelint && pnpm run duplication && pnpm run check:contract && pnpm run check:secrets && pnpm run build",
    "prepare": "husky",
    "test:unit": "node --experimental-strip-types --test \"packages/**/*.test.ts\""
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "dependency-cruiser": "^16.4.2",
    "husky": "^9.1.6",
    "jscpd": "^4.0.5",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^16.10.0",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3",
    "@playwright/test": "^1.48.0",
    "@axe-core/playwright": "^4.10.0"
  }
}