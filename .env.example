# ─────────────────────────────────────────────────────────────────────────────
# VMD Platform — environment. Copy to .env and fill in. NEVER commit .env.
# Validated by @vmd/config/env (Zod). Server vs public split is enforced:
# only PUBLIC_* may reach the browser; everything else is SERVER-ONLY.
#
# Legend:  [REQUIRED] must be set to boot/serve   [OPTIONAL] feature-gated, safe to omit
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Public (safe for the browser) ────────────────────────────────────────────
PUBLIC_SITE_URL=https://migrationdoctors.com.au        # [OPTIONAL] defaults to this
PUBLIC_CMS_URL=http://localhost:3000                   # [OPTIONAL] defaults to this
PLAUSIBLE_DOMAIN=migrationdoctors.com.au               # [OPTIONAL] defaults to this
PUBLIC_TURNSTILE_SITE_KEY=                             # [OPTIONAL] spam widget (client key)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # [OPTIONAL] client area
PUBLIC_SUPABASE_ANON_KEY=                              # [OPTIONAL] client area (public anon key)

# ── Database — Supabase Postgres (Sydney). Payload uses the POOLED url on Vercel.
DATABASE_URL=postgresql://user:pass@host:5432/postgres                 # [REQUIRED]
DATABASE_POOL_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true  # [OPTIONAL] preferred on serverless

# ── Payload ──────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=change-me-to-a-long-random-string-min-32-chars  # [REQUIRED] min 32 chars, SERVER-ONLY
PAYLOAD_API_KEY=agent-service-user-api-key                     # [OPTIONAL] server->CMS lead writes; without it leads are not persisted
REVALIDATE_SECRET=change-me                                    # [OPTIONAL] on-demand ISR (web <- cms revalidate hook)

# ── Supabase — SERVICE_ROLE is SERVER-ONLY. Never expose to the client. ───────
SUPABASE_URL=https://your-project.supabase.co   # [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=                       # [REQUIRED] SERVER-ONLY
SUPABASE_STORAGE_BUCKET=vmd-media                # [OPTIONAL] defaults to vmd-media

# ── Supabase Storage, S3-compatible (Storage settings -> S3 access keys) ──────
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3  # [OPTIONAL] media uploads
S3_REGION=ap-southeast-2                                    # [OPTIONAL] defaults to ap-southeast-2
S3_ACCESS_KEY_ID=                                           # [OPTIONAL] media uploads
S3_SECRET_ACCESS_KEY=                                       # [OPTIONAL] media uploads, SERVER-ONLY

# ── Email (Postmark, packages/email) ──────────────────────────────────────────
# Both must be set for the lead workflow to send admin + client emails.
POSTMARK_SERVER_TOKEN=                                # [OPTIONAL] SERVER-ONLY; enables outbound email
POSTMARK_FROM_EMAIL=sunil@migrationdoctors.com.au    # [OPTIONAL] verified Postmark sender
ADMIN_NOTIFICATION_EMAIL=adminsupport@migrationdoctors.com.au  # [OPTIONAL] new-lead admin alerts; defaults to the practice email

# ── CRM (HubSpot, ADR-0005) ───────────────────────────────────────────────────
# Server-only Private App token. Absent => manual (no-op) CRM; present => every
# Free Visa Health Check upserts a HubSpot Contact. No code change to activate.
HUBSPOT_ACCESS_TOKEN=                                # [OPTIONAL] SERVER-ONLY

# ── Analytics (server-side GA4 Measurement Protocol) ──────────────────────────
GA4_MEASUREMENT_ID=                                  # [OPTIONAL]
GA4_API_SECRET=                                      # [OPTIONAL] SERVER-ONLY

# ── Google Reviews (official Places API New) ──────────────────────────────────
# Both required to display live reviews. Absent => the reviews section renders a
# neutral "read on Google" state (never a hardcoded rating/count). Server-only.
# Key: Google Cloud console → enable "Places API (New)" → create an API key,
#   then RESTRICT it to the Places API (New) and to your deploy domains.
# Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACES_API_KEY=                               # [OPTIONAL] SERVER-ONLY
GOOGLE_PLACE_ID=                                     # [OPTIONAL] SERVER-ONLY

# ── Spam / rate limiting ──────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=                                # [OPTIONAL] SERVER-ONLY (Cloudflare Turnstile)
UPSTASH_REDIS_REST_URL=                              # [OPTIONAL] rate limiting
UPSTASH_REDIS_REST_TOKEN=                            # [OPTIONAL] rate limiting, SERVER-ONLY

# ── Scheduling (ADR-0001): manual | calcom | calendly | google | outlook ──────
SCHEDULING_PROVIDER=manual                           # [OPTIONAL] defaults to manual
