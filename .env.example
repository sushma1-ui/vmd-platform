# ─────────────────────────────────────────────────────────────────────────────
# VMD Platform — environment. Copy to .env and fill in. NEVER commit .env.
# Validated at boot by @vmd/config/env (Zod). Server vs public split is enforced.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development

# Public (safe for the browser)
PUBLIC_SITE_URL=https://migrationdoctors.com.au
PUBLIC_TURNSTILE_SITE_KEY=
PLAUSIBLE_DOMAIN=migrationdoctors.com.au
PUBLIC_CMS_URL=http://localhost:3000
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=

# Database — Supabase Postgres (region: Sydney). Payload uses the POOLED url on Vercel.
DATABASE_URL=postgresql://user:pass@host:5432/postgres
DATABASE_POOL_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true

# Payload (min 32 chars)
PAYLOAD_SECRET=change-me-to-a-long-random-string-min-32-chars

# Supabase — SERVICE_ROLE is SERVER-ONLY. Never expose to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vmd-media

# Supabase Storage S3 access (Storage settings -> S3 access keys)
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email (Postmark)
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=sunil@migrationdoctors.com.au

# Analytics
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Spam / rate limiting
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduling (ADR-0001): manual | calcom | calendly | google | outlook
SCHEDULING_PROVIDER=manual

# On-demand ISR shared secret (web <- cms revalidate hook)
REVALIDATE_SECRET=change-me
PAYLOAD_API_KEY=agent-service-user-api-key
