# Strictness is the point. A package cannot import a dependency it did not
# declare, which is what makes the dependency graph in ARCHITECTURE.md real
# rather than aspirational.
strict-peer-dependencies=false
auto-install-peers=true
dedupe-peer-dependents=true
# Do NOT hoist workspace-internal packages into a shared node_modules root;
# keep boundaries honest.
shamefully-hoist=false
prefer-workspace-packages=true
link-workspace-packages=deep
