{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.json", "packages/config/**"],
  "globalEnv": [
    "NODE_ENV",
    "PUBLIC_SITE_URL",
    "PUBLIC_CMS_URL",
    "PUBLIC_SUPABASE_URL",
    "PUBLIC_SUPABASE_ANON_KEY",
    "PUBLIC_CLIENT",
    "DATABASE_URL",
    "DATABASE_POOL_URL",
    "PAYLOAD_SECRET",
    "PAYLOAD_API_KEY",
    "REVALIDATE_SECRET",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_STORAGE_BUCKET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "POSTMARK_SERVER_TOKEN",
    "POSTMARK_FROM_EMAIL",
    "ADMIN_NOTIFICATION_EMAIL",
    "HUBSPOT_ACCESS_TOKEN",
    "GA4_MEASUREMENT_ID",
    "GA4_API_SECRET",
    "PLAUSIBLE_DOMAIN",
    "GOOGLE_PLACES_API_KEY",
    "GOOGLE_PLACE_ID",
    "TURNSTILE_SECRET_KEY",
    "PUBLIC_TURNSTILE_SITE_KEY",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "SCHEDULING_PROVIDER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
    },
    "@vmd/web#build": {
      "dependsOn": ["^build"],
      "outputs": [".vercel/**", "dist/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
