---
import '../styles/fonts.css';
import '@vmd/ui/styles/base.css';
import { buildMeta, organizationSchema } from '@vmd/seo';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import MobileActionBar from '../components/sections/MobileActionBar.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  schemas?: unknown[];
  breadcrumbs?: { name: string; path: string }[];
}
const { title, description, noindex = false, type = 'website', schemas = [] } = Astro.props;
const meta = buildMeta({ title, description, path: Astro.url.pathname, noindex, type });
const jsonLd = [organizationSchema(), ...schemas];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#16294C" />
    <title>{meta.title}</title>
    <link rel="canonical" href={meta.canonical} />
    {meta.tags.map((t) => <meta name={t.name} property={t.property} content={t.content} />)}
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <MobileActionBar />
  </body>
</html>
