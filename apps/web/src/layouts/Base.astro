---
import '../styles/fonts.css';
import '@vmd/ui/styles/base.css';
import { buildMeta, organizationSchema } from '@vmd/seo';
import Header from '../components/sections/Header.astro';
import UpdatesBar from '../components/sections/UpdatesBar.astro';
import Footer from '../components/sections/Footer.astro';
import MobileActionBar from '../components/sections/MobileActionBar.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  schemas?: unknown[];
  breadcrumbs?: { name: string; path: string }[];
}
const { title, description, noindex = false, type = 'website', schemas = [] } = Astro.props;
const meta = buildMeta({ title, description, path: Astro.url.pathname, noindex, type });
const jsonLd = [organizationSchema(), ...schemas];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Mark JS available before paint so the reveal hidden-state only applies with JS. */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#16294C" />
    <title>{meta.title}</title>
    <link rel="canonical" href={meta.canonical} />
    {meta.tags.map((t) => <meta name={t.name} property={t.property} content={t.content} />)}
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <UpdatesBar />
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <MobileActionBar />

    <style is:global>
      /* Scroll-reveal — enhancement only. The hidden state applies ONLY when JS is
         active (html.js) and the visitor hasn't requested reduced motion, so content
         is always visible and layout-stable otherwise (no SEO/a11y/CLS cost). */
      @media (prefers-reduced-motion: no-preference) {
        html.js [data-reveal] {
          opacity: 0;
          transform: translateY(14px);
          transition:
            opacity 0.55s var(--ease-standard, ease),
            transform 0.55s var(--ease-standard, ease);
        }
        html.js [data-reveal].is-visible {
          opacity: 1;
          transform: none;
        }
      }
    </style>
    <script>
      // Reveal elements once as they enter the viewport; fail open to fully visible.
      const els = document.querySelectorAll('[data-reveal]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
