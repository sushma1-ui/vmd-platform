---
/** Newsletter as an ALERT, not marketing (Blueprint §9.4). Posts to /api/lead. */
---
<form class="nl" data-nl novalidate>
  <label for="nl-email">Get notified when Home Affairs changes the rules that affect you</label>
  <div class="nl__row">
    <input id="nl-email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="name@email.com" required />
    <button type="submit">Notify me</button>
  </div>
  <input type="text" name="company" tabindex="-1" class="nl__hp" aria-hidden="true" autocomplete="off" />
  <p class="nl__err" data-err role="alert" hidden></p>
  <p class="nl__ok" data-ok hidden role="status">Done — we'll email you when the rules change.</p>
</form>
<style>
  .nl label { display: block; font-weight: 500; margin-block-end: var(--space-2); }
  .nl__row { display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .nl input { flex: 1; min-inline-size: 220px; min-block-size: calc(var(--space-6) + var(--space-2)); padding-inline: var(--space-3); border: 1px solid var(--color-text-muted); border-radius: var(--radius-control); font-size: var(--type-body); }
  .nl button { min-block-size: calc(var(--space-6) + var(--space-2)); padding-inline: var(--space-4); background: var(--color-action); color: var(--color-text-inverse); border: 0; border-radius: var(--radius-control); font-weight: 500; cursor: pointer; }
  .nl__hp { position: absolute; left: -9999px; }
  .nl__err { color: var(--color-critical); font-size: var(--type-body-sm); } .nl__ok { color: var(--color-success); font-size: var(--type-body-sm); }
</style>
<script>
  const form = document.querySelector('[data-nl]');
  const err = form?.querySelector('[data-err]'); const ok = form?.querySelector('[data-ok]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault(); err.hidden = true;
    const fd = new FormData(form);
    const payload = { source: 'newsletter', firstName: 'Subscriber', email: fd.get('email'), marketingConsent: true, company: fd.get('company') || undefined };
    if (!payload.email) return;
    try { const r = await fetch('/api/lead', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) }); if (!r.ok) throw new Error(); }
    catch { err.textContent = 'Could not subscribe. Try again.'; err.hidden = false; return; }
    form.querySelectorAll('input,button').forEach((el) => (el.disabled = true)); ok.hidden = false;
  });
</script>
