---
/** Newsletter as an ALERT, not marketing (Blueprint §9.4). Posts to /api/lead. */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="nl" data-nl novalidate>
  <label for="nl-email">Get notified when Home Affairs changes the rules that affect you</label>
  <div class="nl__row">
    <input
      id="nl-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      placeholder="name@email.com"
      required
    />
    <button type="submit">Notify me</button>
  </div>
  <input
    type="text"
    name="company"
    tabindex="-1"
    class="nl__hp"
    aria-hidden="true"
    autocomplete="off"
  />
  {
    turnstileSiteKey && (
      <div class="cf-turnstile nl__ts" data-sitekey={turnstileSiteKey} data-size="flexible" />
    )
  }
  <p class="nl__privacy">
    We use your email only to send rule-change alerts, and you can unsubscribe anytime. See our{' '}
    <a href="/privacy/">Privacy Policy</a>.
  </p>
  <p class="nl__err" data-err role="alert" hidden></p>
  <p class="nl__ok" data-ok hidden role="status">Done — we'll email you when the rules change.</p>
</form>
{
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
  )
}
<style>
  .nl label {
    display: block;
    font-weight: 500;
    margin-block-end: var(--space-2);
  }
  .nl__row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .nl input {
    flex: 1;
    min-inline-size: 220px;
    min-block-size: calc(var(--space-6) + var(--space-2));
    padding-inline: var(--space-3);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-control);
    font-size: var(--type-body);
  }
  .nl button {
    min-block-size: calc(var(--space-6) + var(--space-2));
    padding-inline: var(--space-4);
    background: var(--color-action);
    color: var(--color-text-inverse);
    border: 0;
    border-radius: var(--radius-control);
    font-weight: 500;
    cursor: pointer;
  }
  .nl__hp {
    position: absolute;
    left: -9999px;
  }
  .nl__err {
    color: var(--color-critical);
    font-size: var(--type-body-sm);
  }
  .nl__privacy {
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
    margin-block: var(--space-2) 0;
    line-height: 1.5;
  }
  .nl__privacy a {
    color: var(--color-action);
  }
  .nl__ok {
    color: var(--color-success);
    font-size: var(--type-body-sm);
  }
</style>
<script>
  const form = document.querySelector('[data-nl]');
  const err = form?.querySelector('[data-err]');
  const ok = form?.querySelector('[data-ok]');
  const submit = form?.querySelector('button[type="submit"]');
  const submitLabel = submit ? submit.textContent : '';
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const fd = new FormData(form);
    const payload = {
      source: 'newsletter',
      firstName: 'Subscriber',
      email: fd.get('email'),
      marketingConsent: true,
      company: fd.get('company') || undefined,
      turnstileToken: fd.get('cf-turnstile-response') || undefined,
    };
    if (!payload.email) return;
    if (submit) {
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.textContent = 'Sending…';
    }
    try {
      const r = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!r.ok) throw new Error();
    } catch {
      err.textContent = 'Could not subscribe. Try again.';
      err.hidden = false;
      if (submit) {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        submit.textContent = submitLabel;
      }
      return;
    }
    if (submit) {
      submit.hidden = true;
      submit.removeAttribute('aria-busy');
    }
    form.querySelectorAll('input').forEach((el) => (el.disabled = true));
    ok.hidden = false;
  });
</script>
