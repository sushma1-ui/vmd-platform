---
/**
 * Free Visa Health Check — a multi-step LEAD-CAPTURE wizard (Blueprint §9.4).
 *
 * It collects the information a Registered Migration Agent needs to review a case
 * and hands off to the team. It is NOT an assessment tool: it never computes or
 * shows eligibility, a score, an indicative position, or migration advice. On
 * submit it posts to /api/health-check and redirects to the thank-you page with
 * the returned reference. Lightweight vanilla-JS island; progressive per step.
 *
 * Abuse protection: a hidden honeypot field, plus a Cloudflare Turnstile widget
 * rendered only when PUBLIC_TURNSTILE_SITE_KEY is configured. The server also
 * rate-limits by IP + email; all validation is server-side.
 */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div class="hc" data-hc>
  <div
    class="hc__progress"
    role="progressbar"
    aria-valuemin="1"
    aria-valuemax="8"
    aria-valuenow="1"
  >
    <div class="hc__bar" data-hc-bar></div>
  </div>

  <form data-hc-form novalidate aria-label="Free Visa Health Check">
    {/* Honeypot — must stay empty. Hidden from users and assistive tech. */}
    <div class="hc__hp" aria-hidden="true">
      <label for="hc-website">Do not fill this field</label>
      <input id="hc-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <!-- 1 · Situation -->
    <fieldset class="hc__step" data-step="1">
      <legend class="hc__q">What best describes your situation?</legend>
      <div class="hc__opts">
        <button type="button" data-next data-set="situation:skilled-professional">
          I'm a skilled professional
        </button>
        <button type="button" data-next data-set="situation:student">I'm a student</button>
        <button type="button" data-next data-set="situation:partnered-to-australian">
          I've an Australian Partner (Citizen or Permanent Resident)
        </button>
        <button type="button" data-next data-set="situation:employer">I'm an employer</button>
        <button type="button" data-next data-set="situation:visa-refused"
          >My visa was refused</button
        >
        <button type="button" data-next data-set="situation:bridging-visa">
          I'm on a bridging visa
        </button>
      </div>
    </fieldset>

    <!-- 2 · Location -->
    <fieldset class="hc__step" data-step="2" hidden>
      <legend class="hc__q">Where are you now?</legend>
      <div class="hc__opts">
        <button type="button" data-next data-set="location:australia">In Australia</button>
        <button type="button" data-next data-set="location:offshore">Offshore</button>
      </div>
    </fieldset>

    <!-- 3 · About you (identity) -->
    <fieldset class="hc__step" data-step="3" hidden>
      <legend class="hc__q">About you</legend>
      <label class="hc__label" for="hc-country">Country of residence</label>
      <input
        class="hc__input"
        id="hc-country"
        name="country"
        autocomplete="country-name"
        required
      />
      <label class="hc__label" for="hc-nationality">Nationality</label>
      <input class="hc__input" id="hc-nationality" name="nationality" required />
      <label class="hc__label" for="hc-visa">Current Australian visa (if any)</label>
      <input class="hc__input" id="hc-visa" name="currentVisa" placeholder="e.g. Subclass 500" />
      <p class="hc__err" data-step-err role="alert" hidden></p>
      <button type="button" class="hc__continue" data-continue>Continue</button>
    </fieldset>

    <!-- 4 · Destination goal -->
    <fieldset class="hc__step" data-step="4" hidden>
      <legend class="hc__q">What are you hoping to achieve?</legend>
      <div class="hc__opts">
        <button type="button" data-next data-set="goal:permanent-residence">
          Permanent residence
        </button>
        <button type="button" data-next data-set="goal:temporary-work">Work in Australia</button>
        <button type="button" data-next data-set="goal:study">Study in Australia</button>
        <button type="button" data-next data-set="goal:family-partner">Join or bring family</button>
        <button type="button" data-next data-set="goal:visitor">Visit Australia</button>
        <button type="button" data-next data-set="goal:business-investment">
          Business or investment
        </button>
        <button type="button" data-next data-set="goal:not-sure">I'm not sure yet</button>
      </div>
    </fieldset>

    <!-- 5 · Age bracket -->
    <fieldset class="hc__step" data-step="5" hidden>
      <legend class="hc__q">Your age</legend>
      <div class="hc__opts">
        <button type="button" data-next data-set="ageBracket:under-25">Under 25</button>
        <button type="button" data-next data-set="ageBracket:25-32">25–32</button>
        <button type="button" data-next data-set="ageBracket:33-39">33–39</button>
        <button type="button" data-next data-set="ageBracket:40-44">40–44</button>
        <button type="button" data-next data-set="ageBracket:45-plus">45+</button>
      </div>
    </fieldset>

    <!-- 6 · English test + skills assessment -->
    <fieldset class="hc__step" data-step="6" hidden>
      <legend class="hc__q">Have you completed these?</legend>
      <p class="hc__sub" id="hc-eng-label">An English test (e.g. IELTS, PTE)</p>
      <div class="hc__opts hc__opts--row" role="group" aria-labelledby="hc-eng-label">
        <button type="button" data-choice data-set="englishTest:yes">Yes</button>
        <button type="button" data-choice data-set="englishTest:no">No</button>
        <button type="button" data-choice data-set="englishTest:not-sure">Not sure</button>
      </div>
      <p class="hc__sub" id="hc-skills-label">A skills assessment</p>
      <div class="hc__opts hc__opts--row" role="group" aria-labelledby="hc-skills-label">
        <button type="button" data-choice data-set="skillsAssessment:yes">Yes</button>
        <button type="button" data-choice data-set="skillsAssessment:no">No</button>
        <button type="button" data-choice data-set="skillsAssessment:not-sure">Not sure</button>
      </div>
      <p class="hc__err" data-step-err role="alert" hidden></p>
      <button type="button" class="hc__continue" data-continue>Continue</button>
    </fieldset>

    <!-- 7 · Refusal history -->
    <fieldset class="hc__step" data-step="7" hidden>
      <legend class="hc__q">Has a visa ever been refused or cancelled?</legend>
      <div class="hc__opts">
        <button type="button" data-next data-set="everRefusedOrCancelled:no">No</button>
        <button type="button" data-next data-set="everRefusedOrCancelled:yes">Yes</button>
        <button type="button" data-next data-set="everRefusedOrCancelled:not-sure">Not sure</button>
      </div>
    </fieldset>

    <!-- 8 · Contact details -->
    <fieldset class="hc__step" data-step="8" hidden>
      <legend class="hc__q">Where should our team send your response?</legend>
      <label class="hc__label" for="hc-name">First name</label>
      <input class="hc__input" id="hc-name" name="firstName" autocomplete="given-name" required />
      <label class="hc__label" for="hc-email">Email</label>
      <input
        class="hc__input"
        id="hc-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
      />
      <label class="hc__label" for="hc-mobile">Mobile (optional)</label>
      <input
        class="hc__input"
        id="hc-mobile"
        name="mobile"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
      />
      <label class="hc__label" for="hc-contact">Preferred contact</label>
      <select class="hc__input" id="hc-contact" name="preferredContact">
        <option value="email">Email</option>
        <option value="phone">Phone</option>
        <option value="whatsapp">WhatsApp</option>
      </select>
      <label class="hc__consent">
        <input type="checkbox" name="sensitive" required />
        I understand this form collects my details so a Registered Migration Agent can review my enquiry,
        and that no migration advice is provided until then.
      </label>
      {
        turnstileSiteKey && (
          <div
            class="hc__turnstile cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="light"
          />
        )
      }
      <p class="hc__err" data-hc-err role="alert" hidden></p>
      <p class="hc__privacy">
        We collect these details only to review your submission and respond. See our{' '}
        <a href="/privacy/">Privacy Policy</a>.
      </p>
      <button class="hc__submit" type="submit" data-submit>Submit my Free Visa Health Check</button>
    </fieldset>
  </form>
  {
    turnstileSiteKey && (
      <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
    )
  }

  <div class="hc__foot">
    <button type="button" data-hc-back hidden>← Back</button>
    <span data-hc-count>Step 1 of 8</span>
  </div>
</div>

<style>
  .hc {
    max-inline-size: var(--container-prose);
    margin-inline: auto;
  }
  .hc__progress {
    block-size: 4px;
    background: var(--color-ground-warm);
    border-radius: var(--radius-chip);
    overflow: hidden;
  }
  .hc__bar {
    block-size: 100%;
    inline-size: 12.5%;
    background: var(--color-action);
    transition: inline-size var(--motion-base) var(--ease-standard);
  }
  .hc__step {
    border: 0;
    padding: var(--space-2) 0;
    margin: 0;
  }
  .hc__q {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: 1.2;
    color: var(--color-action);
    padding: 0;
    margin-block-end: var(--space-2);
  }
  .hc__sub {
    font-weight: 500;
    margin-block: var(--space-4) var(--space-2);
  }
  .hc__opts {
    display: grid;
    gap: var(--space-2);
  }
  .hc__opts--row {
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
  }
  .hc__opts button,
  .hc__submit,
  .hc__continue {
    text-align: start;
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--type-body);
    font-family: var(--font-body);
    background: var(--color-ground-light);
    color: var(--color-text);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-control);
    cursor: pointer;
    min-block-size: 2.75rem;
    line-height: 1.3;
  }
  .hc__opts--row button {
    text-align: center;
    justify-content: center;
  }
  .hc__opts button:hover,
  .hc__opts button:focus-visible {
    border-color: var(--color-emphasis);
  }
  .hc__opts button[aria-pressed='true'] {
    border-color: var(--color-action);
    background: color-mix(in srgb, var(--color-action) 8%, var(--color-ground-light));
    font-weight: 600;
  }
  .hc__label {
    display: block;
    font-weight: 500;
    margin-block: var(--space-3) var(--space-1);
  }
  .hc__input {
    display: block;
    inline-size: 100%;
    min-block-size: calc(var(--space-6) + var(--space-2));
    padding-inline: var(--space-3);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-control);
    font-size: var(--type-body);
  }
  .hc__input:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 1px;
  }
  .hc__consent {
    display: flex;
    gap: var(--space-2);
    align-items: start;
    margin-block: var(--space-4);
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .hc__privacy {
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
    margin-block: var(--space-2) 0;
    line-height: 1.5;
  }
  .hc__privacy a {
    color: var(--color-action);
  }
  .hc__continue,
  .hc__submit {
    text-align: center;
    /* Approved primary treatment: gold fill with dark ink text — the same warm
       CTA the client signed off on for the hero. Ink-on-gold clears WCAG AA. */
    background: var(--color-emphasis);
    color: var(--color-text);
    border-color: transparent;
    font-weight: 600;
    margin-block-start: var(--space-4);
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hc__continue:hover,
    .hc__submit:hover {
      background: color-mix(in srgb, var(--color-emphasis) 88%, black);
      transform: translateY(-1px);
    }
  }
  .hc__submit[aria-busy='true'] {
    opacity: 0.7;
    cursor: progress;
  }
  .hc__err {
    color: var(--color-critical);
    font-size: var(--type-body-sm);
    margin-block-start: var(--space-2);
  }
  .hc__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: var(--space-2);
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .hc__foot button {
    background: none;
    border: 0;
    color: var(--color-action);
    cursor: pointer;
    font-size: var(--type-body-sm);
  }
  /* Honeypot: visually and functionally hidden, but present in the DOM for bots. */
  .hc__hp {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .hc__turnstile {
    margin-block: var(--space-4) 0;
  }
</style>

<script>
  const root = document.querySelector('[data-hc]');
  if (root instanceof HTMLElement) {
    const KEY = 'vmd-health-check';
    const total = 8;
    let state: Record<string, unknown> = {};
    try {
      state = JSON.parse(localStorage.getItem(KEY) || '{}');
    } catch {
      state = {};
    }
    let step = 1;

    const bar = root.querySelector<HTMLElement>('[data-hc-bar]');
    const progress = root.querySelector<HTMLElement>('.hc__progress');
    const count = root.querySelector<HTMLElement>('[data-hc-count]');
    const back = root.querySelector<HTMLButtonElement>('[data-hc-back]');
    const form = root.querySelector<HTMLFormElement>('[data-hc-form]');
    const steps = Array.from(root.querySelectorAll<HTMLElement>('.hc__step'));

    // Attribution: captured once on load (UTM + referrer + landing page + device).
    const params = new URLSearchParams(location.search);
    const width = window.innerWidth;
    state.attribution = {
      utmSource: params.get('utm_source') ?? undefined,
      utmMedium: params.get('utm_medium') ?? undefined,
      utmCampaign: params.get('utm_campaign') ?? undefined,
      landingPage: location.pathname,
      referrer: document.referrer || undefined,
      device: width < 640 ? 'mobile' : width < 1024 ? 'tablet' : 'desktop',
    };

    const persist = () => localStorage.setItem(KEY, JSON.stringify(state));

    const show = (n: number) => {
      step = n;
      for (const f of steps) f.hidden = Number(f.dataset.step) !== n;
      if (bar) bar.style.inlineSize = `${Math.round((n / total) * 100)}%`;
      if (progress) progress.setAttribute('aria-valuenow', String(n));
      if (count) count.textContent = `Step ${n} of ${total}`;
      if (back) back.hidden = n === 1;
      const focusable = steps[n - 1]?.querySelector<HTMLElement>('button, input, select');
      focusable?.focus();
    };

    // Auto-advance choice buttons.
    root.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const [k, v] = (btn.dataset.set ?? '').split(':');
        if (k) state[k] = v;
        persist();
        if (step < total) show(step + 1);
      });
    });

    // Single-select choice buttons (radio behaviour within a group).
    root.querySelectorAll<HTMLButtonElement>('[data-choice]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const [k, v] = (btn.dataset.set ?? '').split(':');
        if (!k) return;
        state[k] = v;
        persist();
        const group = btn.closest('[role="group"]');
        group
          ?.querySelectorAll('[data-choice]')
          .forEach((b) => b.setAttribute('aria-pressed', 'false'));
        btn.setAttribute('aria-pressed', 'true');
      });
    });

    const stepError = (n: number, msg: string) => {
      const el = steps[n - 1]?.querySelector<HTMLElement>('[data-step-err]');
      if (el) {
        el.textContent = msg;
        el.hidden = false;
      }
    };
    const clearStepError = (n: number) => {
      const el = steps[n - 1]?.querySelector<HTMLElement>('[data-step-err]');
      if (el) el.hidden = true;
    };

    // Validate + advance for input / grouped-choice steps.
    root.querySelectorAll<HTMLButtonElement>('[data-continue]').forEach((btn) => {
      btn.addEventListener('click', () => {
        clearStepError(step);
        if (step === 3) {
          const country = (root.querySelector<HTMLInputElement>('#hc-country')?.value ?? '').trim();
          const nationality = (
            root.querySelector<HTMLInputElement>('#hc-nationality')?.value ?? ''
          ).trim();
          const currentVisa = (
            root.querySelector<HTMLInputElement>('#hc-visa')?.value ?? ''
          ).trim();
          if (!country || !nationality) {
            stepError(3, 'Please enter your country of residence and nationality.');
            return;
          }
          state.country = country;
          state.nationality = nationality;
          if (currentVisa) state.currentVisa = currentVisa;
        }
        if (step === 6) {
          if (!state.englishTest || !state.skillsAssessment) {
            stepError(6, 'Please answer both questions.');
            return;
          }
        }
        persist();
        if (step < total) show(step + 1);
      });
    });

    back?.addEventListener('click', () => {
      if (step > 1) show(step - 1);
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const errEl = root.querySelector<HTMLElement>('[data-hc-err]');
      const submit = root.querySelector<HTMLButtonElement>('[data-submit]');
      if (errEl) errEl.hidden = true;

      const fd = new FormData(form);
      state.firstName = String(fd.get('firstName') ?? '').trim();
      state.email = String(fd.get('email') ?? '').trim();
      const mobile = String(fd.get('mobile') ?? '').trim();
      if (mobile) state.mobile = mobile;
      state.preferredContact = String(fd.get('preferredContact') ?? 'email');
      state.sensitiveInfoAcknowledged = fd.get('sensitive') === 'on';
      // Abuse signals: honeypot (must be empty) + Turnstile token (when enabled).
      state.website = String(fd.get('website') ?? '');
      const tsToken = String(fd.get('cf-turnstile-response') ?? '');
      if (tsToken) state.turnstileToken = tsToken;

      const emailOk = /.+@.+\..+/.test(String(state.email));
      if (!state.firstName || !emailOk) {
        if (errEl) {
          errEl.textContent = 'Please enter your first name and a valid email.';
          errEl.hidden = false;
        }
        return;
      }
      if (!state.sensitiveInfoAcknowledged) {
        if (errEl) {
          errEl.textContent = 'Please tick the box to continue.';
          errEl.hidden = false;
        }
        return;
      }

      if (submit) {
        submit.setAttribute('aria-busy', 'true');
        submit.disabled = true;
        submit.textContent = 'Submitting…';
      }
      try {
        const res = await fetch('/api/health-check', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(state),
        });
        const data: { ok?: boolean; submissionId?: string } = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error('submit-failed');
        localStorage.removeItem(KEY);
        const ref = data.submissionId ? `?ref=${encodeURIComponent(data.submissionId)}` : '';
        location.assign(`/thank-you/${ref}`);
      } catch {
        if (errEl) {
          errEl.textContent =
            'Something went wrong sending your enquiry. Please try again, or call our office.';
          errEl.hidden = false;
        }
        if (submit) {
          submit.removeAttribute('aria-busy');
          submit.disabled = false;
          submit.textContent = 'Submit my Free Visa Health Check';
        }
      }
    });

    show(1);
  }
</script>
