---
/** Consultation request. Timezone-aware (AWST default). Posts to /api/booking. */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="bk" data-bk novalidate>
  <div class="bk__grid">
    <div class="bk__f bk__f--wide">
      <label for="bk-journey">Where are you in your journey?</label>
      <select id="bk-journey" name="journeyStage">
        <option value="">Select…</option>
        <option value="planning-study">I'm planning to study in Australia</option>
        <option value="currently-studying">I'm currently studying in Australia</option>
        <option value="working">I'm working in Australia</option>
        <option value="planning-work">I'm planning to work in Australia</option>
        <option value="planning-pr">I'm planning to apply for permanent residency</option>
        <option value="australian-partner">I have an Australian partner</option>
        <option value="employer">I'm an employer/business looking to sponsor an employee</option>
        <option value="refused">My visa has been refused or cancelled</option>
        <option value="in-australia-next-visa">
          I'm already in Australia and need advice about my next visa
        </option>
        <option value="unsure">I'm not sure which pathway is right for me</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="bk__f bk__f--wide">
      <label for="bk-matter">Matter to be discussed</label>
      <select id="bk-matter" name="matter">
        <option value="">Select…</option>
        <option value="student-500">Student Visa (500)</option>
        <option value="graduate-485">Temporary Graduate Visa (485)</option>
        <option value="gsm">General Skilled Migration</option>
        <option value="employer-sponsored">Employer Sponsored Visa</option>
        <option value="sponsoring-employee">Sponsoring an Employee</option>
        <option value="partner">Partner Visa</option>
        <option value="visitor">Visitor Visa</option>
        <option value="skills-assessment">Skills Assessment</option>
        <option value="refusal">Visa Refusal / Cancellation</option>
        <option value="extension">Visa Extension / Further Stay</option>
        <option value="citizenship">Australian Citizenship</option>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="bk__f">
      <label for="bk-type">Consultation type</label>
      <select id="bk-type" name="type"
        ><option value="initial">Initial Consultation</option><option value="second-opinion"
          >Second Opinion</option
        ><option value="follow-up">Follow-up</option><option value="educational"
          >Educational Consultation — FREE</option
        ></select
      >
    </div>
    <div class="bk__f">
      <label for="bk-name">First name</label><input
        id="bk-name"
        name="firstName"
        autocomplete="given-name"
        required
      />
    </div>
    <div class="bk__f">
      <label for="bk-email">Email</label><input
        id="bk-email"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        required
      />
    </div>
    <div class="bk__f">
      <label for="bk-mobile">Mobile</label><input
        id="bk-mobile"
        name="mobile"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        required
      />
    </div>
    <div class="bk__f">
      <label for="bk-when">Preferred date/time (optional)</label><input
        id="bk-when"
        name="requestedStartUtc"
        type="datetime-local"
      />
    </div>
  </div>
  <div class="bk__edu" data-edu-fields hidden>
    <p class="bk__edu-h">A few details to make your free education session useful (optional)</p>
    <div class="bk__grid">
      <div class="bk__f">
        <label for="bk-contact">Preferred contact method</label>
        <select id="bk-contact" name="contactMethod">
          <option value="">No preference</option>
          <option>Email</option>
          <option>Phone call</option>
          <option>WhatsApp</option>
        </select>
      </div>
      <div class="bk__f">
        <label for="bk-level">Current education level</label><input
          id="bk-level"
          name="educationLevel"
          autocomplete="off"
          placeholder="e.g. Year 12, Bachelor’s"
        />
      </div>
      <div class="bk__f">
        <label for="bk-course">Intended study / course</label><input
          id="bk-course"
          name="intendedCourse"
          placeholder="e.g. Nursing, IT, Business"
        />
      </div>
      <div class="bk__f">
        <label for="bk-city">Preferred city / institution (if known)</label><input
          id="bk-city"
          name="preferredCity"
        />
      </div>
      <div class="bk__f">
        <label for="bk-intake">Approximate intake / timing</label><input
          id="bk-intake"
          name="intake"
          placeholder="e.g. Semester 1, 2027"
        />
      </div>
    </div>
  </div>
  <div class="bk__f">
    <label for="bk-notes">Tell us where you are now and what you'd like to achieve</label><textarea
      id="bk-notes"
      name="notes"
      rows="4"
      data-bk-notes
      placeholder="Example: I'm currently studying in Australia, my student visa expires in October, and I'd like to understand my options to stay longer and eventually apply for permanent residency."
    ></textarea>
  </div>
  <input
    type="text"
    name="company"
    tabindex="-1"
    autocomplete="off"
    class="bk__hp"
    aria-hidden="true"
  />
  {
    turnstileSiteKey && (
      <div class="cf-turnstile bk__ts" data-sitekey={turnstileSiteKey} data-size="flexible" />
    )
  }
  <p class="bk__err" data-err role="alert" hidden></p>
  <p class="bk__privacy">
    We collect these details only to arrange your consultation. See our{' '}
    <a href="/privacy/">Privacy Policy</a>.
  </p>
  <button type="submit">Request consultation</button>
  <div class="bk__ok" data-ok hidden role="status">
    Requested. We'll confirm your time (AWST) and send a preparation checklist by email.
  </div>
</form>
{
  turnstileSiteKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />
  )
}
<style>
  .bk__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }
  .bk__f {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-block-end: var(--space-3);
  }
  /* Journey + matter span the full width so the long labels read on one line and
     read as the first, framing questions. */
  .bk__f--wide {
    grid-column: 1 / -1;
  }
  .bk textarea::placeholder {
    color: var(--color-text-muted);
    opacity: 0.8;
  }
  .bk__f label {
    font-weight: 500;
    font-size: var(--type-body-sm);
  }
  .bk input,
  .bk select,
  .bk textarea {
    min-block-size: calc(var(--space-6) + var(--space-2));
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-control);
    font-size: var(--type-body);
    font-family: var(--font-body);
  }
  .bk textarea {
    min-block-size: auto;
  }
  .bk button {
    min-block-size: var(--space-6);
    padding-inline: var(--space-4);
    background: var(--color-action);
    color: var(--color-text-inverse);
    border: 0;
    border-radius: var(--radius-control);
    font-weight: 500;
    cursor: pointer;
  }
  .bk__edu {
    margin-block-end: var(--space-3);
    padding: var(--space-3) var(--space-4) 0;
    border: 1px dashed var(--color-emphasis);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, var(--color-emphasis) 6%, transparent);
  }
  .bk__edu-h {
    margin: 0 0 var(--space-3);
    font-size: var(--type-body-sm);
    font-weight: 600;
    color: var(--color-emphasis-text);
  }
  .bk__hp {
    position: absolute;
    left: -9999px;
  }
  .bk__err {
    color: var(--color-critical);
    font-size: var(--type-body-sm);
  }
  .bk__privacy {
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
    margin-block: var(--space-2) var(--space-3);
    line-height: 1.5;
  }
  .bk__privacy a {
    color: var(--color-action);
  }
  .bk__ok {
    margin-block-start: var(--space-4);
    border-inline-start: 3px solid var(--color-success);
    background: color-mix(in srgb, var(--color-success) 8%, var(--color-ground-light));
    padding: var(--space-3) var(--space-4);
  }
  @media (min-width: 640px) {
    .bk__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
<script>
  const form = document.querySelector('[data-bk]');
  const err = form?.querySelector('[data-err]');
  const ok = form?.querySelector('[data-ok]');
  const submit = form?.querySelector('button[type="submit"]');
  const submitLabel = submit ? submit.textContent : '';
  // Educational Consultation reveals a few optional study-specific fields.
  const typeSel = form?.querySelector('#bk-type');
  const eduFields = form?.querySelector('[data-edu-fields]');
  const toggleEdu = () => {
    if (eduFields) eduFields.hidden = typeSel?.value !== 'educational';
  };
  typeSel?.addEventListener('change', toggleEdu);
  toggleEdu();

  // --- Context-aware "Matter to be discussed" + dynamic example placeholder ---
  const journeySel = form?.querySelector('#bk-journey');
  const matterSel = form?.querySelector('#bk-matter');
  const notes = form?.querySelector('[data-bk-notes]');
  // Snapshot the matter options once so reordering is always from the full set.
  const matterAll = matterSel
    ? Array.from(matterSel.querySelectorAll('option')).map((o) => ({
        value: o.value,
        label: o.textContent || '',
      }))
    : [];
  // Which matters to surface first for each journey (the rest still follow, in order).
  const MATTER_PRIORITY = {
    'planning-study': ['student-500', 'graduate-485', 'skills-assessment', 'gsm'],
    'currently-studying': ['student-500', 'graduate-485', 'extension', 'gsm'],
    working: ['gsm', 'employer-sponsored', 'skills-assessment', 'extension'],
    'planning-work': ['employer-sponsored', 'gsm', 'skills-assessment', 'student-500'],
    'planning-pr': ['gsm', 'employer-sponsored', 'partner', 'skills-assessment'],
    'australian-partner': ['partner'],
    employer: ['employer-sponsored', 'sponsoring-employee'],
    refused: ['refusal', 'extension'],
    'in-australia-next-visa': ['extension', 'gsm', 'student-500', 'graduate-485', 'partner'],
    unsure: ['gsm', 'student-500', 'graduate-485', 'partner', 'employer-sponsored'],
  };
  const reorderMatter = () => {
    if (!matterSel || !matterAll.length) return;
    const journey = journeySel?.value || '';
    const priority = MATTER_PRIORITY[journey] || [];
    const chosen = matterSel.value;
    const rank = (v) => {
      if (v === '') return -1; // keep the "Select…" placeholder first
      const i = priority.indexOf(v);
      return i === -1 ? priority.length + matterAll.findIndex((o) => o.value === v) : i;
    };
    const ordered = [...matterAll].sort((a, b) => rank(a.value) - rank(b.value));
    matterSel.innerHTML = '';
    for (const o of ordered) {
      const opt = document.createElement('option');
      opt.value = o.value;
      opt.textContent = o.label;
      matterSel.appendChild(opt);
    }
    matterSel.value = chosen; // preserve any current selection
  };

  const EXAMPLES = {
    student:
      "Example: I'm currently studying in Australia and my student visa expires in October. I'd like to understand my options to extend my stay or apply for a Temporary Graduate visa.",
    graduate:
      "Example: I'm an international student completing my bachelor's degree and I want to know whether I'm eligible for a Temporary Graduate visa after graduation.",
    skilled:
      "Example: I'm a professional with 5 years of experience in Australia and 5 years of experience in my home country in my field. I'd like to understand my options for permanent residency.",
    employer:
      "Example: I own a business and would like to sponsor an employee so we can retain them for the foreseeable future. I'd like to understand the available sponsorship options.",
    refusal:
      "Example: My visa application was recently refused. I'd like to understand why it was refused and what options I have from here.",
    partner:
      "Example: My partner is an Australian permanent resident and we've been together for 3 years. I'd like to understand my partner visa options.",
    unsure:
      "Example: I'm currently working in Australia and have several years of experience in my occupation, but I'm not sure which pathway to permanent residency would suit me.",
    generic:
      "Example: I'm currently studying in Australia, my student visa expires in October, and I'd like to understand my options to stay longer and eventually apply for permanent residency.",
  };
  const JOURNEY_EXAMPLE = {
    'planning-study': 'student',
    'currently-studying': 'student',
    working: 'skilled',
    'planning-work': 'skilled',
    'planning-pr': 'skilled',
    'in-australia-next-visa': 'skilled',
    'australian-partner': 'partner',
    employer: 'employer',
    refused: 'refusal',
    unsure: 'unsure',
  };
  const updateExample = () => {
    if (!notes) return;
    const matter = matterSel?.value || '';
    const journey = journeySel?.value || '';
    // The matter answer refines the example where it's more specific than the journey.
    let key = JOURNEY_EXAMPLE[journey] || 'generic';
    if (matter === 'graduate-485') key = 'graduate';
    else if (matter === 'partner') key = 'partner';
    else if (matter === 'refusal') key = 'refusal';
    else if (matter === 'employer-sponsored' || matter === 'sponsoring-employee') key = 'employer';
    notes.setAttribute('placeholder', EXAMPLES[key] || EXAMPLES.generic);
  };
  journeySel?.addEventListener('change', () => {
    reorderMatter();
    updateExample();
  });
  matterSel?.addEventListener('change', updateExample);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const fd = new FormData(form);
    let when = fd.get('requestedStartUtc');
    const payload = {
      type: fd.get('type'),
      journeyStage: fd.get('journeyStage') || undefined,
      matter: fd.get('matter') || undefined,
      firstName: fd.get('firstName'),
      email: fd.get('email'),
      mobile: fd.get('mobile'),
      timezone: 'Australia/Perth',
      requestedStartUtc: when ? new Date(when).toISOString() : undefined,
      notes: fd.get('notes') || undefined,
      company: fd.get('company') || undefined,
      turnstileToken: fd.get('cf-turnstile-response') || undefined,
    };
    if (payload.type === 'educational') {
      const lines = [];
      const push = (label, name) => {
        const v = fd.get(name);
        if (v) lines.push(label + ': ' + v);
      };
      push('Preferred contact', 'contactMethod');
      push('Education level', 'educationLevel');
      push('Intended course', 'intendedCourse');
      push('Preferred city/institution', 'preferredCity');
      push('Intake/timing', 'intake');
      const msg = fd.get('notes');
      payload.notes =
        [
          '[Educational Consultation — Study in Australia]',
          lines.join('\n'),
          msg ? 'Message: ' + msg : '',
        ]
          .filter(Boolean)
          .join('\n') || undefined;
    }
    if (!payload.firstName || !payload.email || !payload.mobile) {
      err.textContent = 'Please enter your name, email and mobile.';
      err.hidden = false;
      return;
    }
    if (submit) {
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.textContent = 'Sending…';
    }
    try {
      const r = await fetch('/api/booking', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!r.ok) throw new Error();
    } catch {
      err.textContent = 'Could not send your request. Please call us on +61 493 719 431.';
      err.hidden = false;
      if (submit) {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        submit.textContent = submitLabel;
      }
      return;
    }
    // Success: drop the "Sending…" button so it never reads as stuck, lock the
    // fields, and surface the confirmation clearly.
    if (submit) {
      submit.hidden = true;
      submit.removeAttribute('aria-busy');
    }
    form.querySelectorAll('input,select,textarea').forEach((el) => (el.disabled = true));
    ok.hidden = false;
    ok.setAttribute('tabindex', '-1');
    ok.focus();
  });
</script>
