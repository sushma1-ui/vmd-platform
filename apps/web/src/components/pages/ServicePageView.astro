---
/**
 * Shared renderer for an "Our Services" page (service-pages collection). Used by the
 * /visas/[slug], /services/[slug] and /initial-consultation routes so every service
 * renders identically. Content comes verbatim from the CMS; nothing here rewrites it.
 */
import Base from '../../layouts/Base.astro';
import { PRACTICE, RMA_STATEMENT } from '@vmd/config';
import { serviceSchema, breadcrumbSchema, faqSchema } from '@vmd/seo';
import { lexicalToHtml } from '../../lib/lexical.ts';
import { getCtaLinks } from '../../lib/cms.ts';
import { servicePageHref, type ServiceDoc } from '../../lib/servicePages.ts';

interface Props {
  page: ServiceDoc;
  allPages: ServiceDoc[];
}

const { page, allPages } = Astro.props;
const path = Astro.url.pathname;

// CMS-configurable CTA destinations (falls back to @vmd/config defaults). A page may
// override the primary Book destination via cta.buttonHref (e.g. the initial-
// consultation page points its own button at the booking form, not at itself).
const { bookUrl, healthCheckUrl } = await getCtaLinks();
const pageBookUrl = page.cta?.buttonHref || bookUrl;
const bookLabel = page.cta?.buttonLabel || 'Book a Consultation';

const pageHref = servicePageHref;

// Body: Lexical -> HTML, add ids to H2/H3, collect a table of contents.
const rawHtml = lexicalToHtml(page.content as Parameters<typeof lexicalToHtml>[0]);
const words = rawHtml
  .replace(/<[^>]+>/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const readingTime = page.readingTime ?? Math.max(1, Math.round(words / 200));

const toc: { id: string; text: string; level: number }[] = [];
const bodyHtml = rawHtml.replace(/<(h2|h3)>([\s\S]*?)<\/\1>/g, (_m, tag, inner) => {
  const raw = String(inner).replace(/<[^>]+>/g, '');
  const id = raw
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
  // Strip any author-written leading list number so the <ol> is the single source
  // of numbering — no "○ 1." double markers.
  const text = raw.replace(/^\s*\d+[.)]\s+/, '');
  toc.push({ id, text, level: tag === 'h2' ? 2 : 3 });
  return `<${tag} id="${id}">${inner}</${tag}>`;
});

const faq = (page.faq ?? []).filter(
  (f): f is { question: string; answer: string } => Boolean(f?.question) && Boolean(f?.answer),
);

// Resolve "Related:" labels to internal links where a page clearly matches (shared
// visa number, or ≥2 shared slug tokens). Unresolved labels render as plain text.
const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
function resolveRelated(label: string): { label: string; href: string | null } {
  const labelTokens = slugify(label).split('-').filter(Boolean);
  const labelNums = labelTokens.filter((t) => /^\d+$/.test(t));
  let best: ServiceDoc | null = null;
  let bestScore = 0;
  for (const p of allPages) {
    const pTokens = p.slug.split('-');
    if (labelNums.length && !labelNums.some((n) => pTokens.includes(n))) continue;
    const score = labelTokens.filter((t) => pTokens.includes(t)).length;
    if (score > bestScore) {
      best = p;
      bestScore = score;
    }
  }
  return { label, href: best && bestScore >= 2 ? pageHref(best) : null };
}
const related = (page.relatedLinks ?? [])
  .map((r) => r?.label)
  .filter((l): l is string => Boolean(l))
  .map(resolveRelated);

// CTA body: known bracket placeholders become real links; **bold** becomes strong.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
function ctaHtml(text: string): string {
  return esc(text)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[Book a consultation\]/g, `<a href="${pageBookUrl}">Book a consultation</a>`)
    .replace(
      /\[Check your eligibility\]/g,
      `<a href="${healthCheckUrl}">Check your eligibility</a>`,
    );
}
const cta = page.cta ?? null;

const trail =
  page.section === 'root'
    ? [
        { name: 'Home', path: '/' },
        { name: page.title, path },
      ]
    : [
        { name: 'Home', path: '/' },
        { name: 'Our Services', path: '/services/' },
        { name: page.title, path },
      ];

const fmtDate = (d?: string | null) =>
  d
    ? new Date(d).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })
    : '';

const schemas = [
  serviceSchema({
    name: page.title,
    description: page.seo?.metaDescription || page.subtitle || page.title,
    path,
    serviceType: 'Migration advice',
  }),
  breadcrumbSchema(trail),
  ...(faq.length ? [faqSchema(faq)] : []),
];
---

<Base
  title={page.seo?.metaTitle || page.title}
  description={page.seo?.metaDescription || page.subtitle || page.title}
  type="article"
  noindex={page.seo?.noindex ?? false}
  schemas={schemas}
>
  <article class="svc">
    <nav class="crumbs" aria-label="Breadcrumb">
      {
        trail.map((t, i) => (
          <span>
            {i > 0 && <span aria-hidden="true"> / </span>}
            {i === trail.length - 1 ? (
              <span aria-current="page">{t.name}</span>
            ) : (
              <a href={t.path}>{t.name}</a>
            )}
          </span>
        ))
      }
    </nav>

    <header class="svc__head">
      <h1 class="svc__title">{page.title}</h1>
      {page.subtitle && <p class="svc__subtitle">{page.subtitle}</p>}
      <p class="svc__meta">
        {page.publishedAt && <>Published {fmtDate(page.publishedAt)} · </>}
        {page.updatedAt && <>Last updated {fmtDate(page.updatedAt)} · </>}
        {readingTime} min read
      </p>
    </header>

    {
      toc.length > 2 && (
        <nav class="svc__toc" aria-label="On this page">
          <p class="svc__toc-h">On this page</p>
          <ol>
            {toc.map((h) => (
              <li class={h.level === 3 ? 'svc__toc-l3' : ''}>
                <a href={`#${h.id}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <div class="svc__body" set:html={bodyHtml} />

    {
      faq.length > 0 && (
        <section class="svc__faq">
          <h2>Frequently asked questions</h2>
          {faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </section>
      )
    }

    {
      cta && (cta.heading || cta.body) && (
        <section class="svc__cta">
          {cta.heading && <h2>{cta.heading}</h2>}
          {cta.body && <p set:html={ctaHtml(cta.body)} />}
          <div class="svc__cta-actions">
            <a class="svc__cta-btn" href={pageBookUrl}>
              {bookLabel}
            </a>
            <a class="svc__cta-link" href={healthCheckUrl}>
              or take the Free Visa Health Check →
            </a>
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="svc__related">
          <h2>Related</h2>
          <ul>
            {related.map((r) => (
              <li>{r.href ? <a href={r.href}>{r.label}</a> : <span>{r.label}</span>}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="svc__contact" aria-labelledby="svc-contact-h">
      <h2 id="svc-contact-h">Speak to us about your matter</h2>
      <p class="svc__contact-lead">
        {RMA_STATEMENT} Based in {PRACTICE.address.locality} CBD, assisting clients Australia-wide.
      </p>
      <ul class="svc__contact-list">
        <li>
          <span>Phone</span>
          <a href={`tel:${PRACTICE.contact.phone}`}>{PRACTICE.contact.phoneDisplay}</a>
        </li>
        <li>
          <span>Email</span>
          <a href={`mailto:${PRACTICE.contact.email}`}>{PRACTICE.contact.email}</a>
        </li>
        <li>
          <span>Office</span>
          <span>
            {PRACTICE.address.street}, {PRACTICE.address.locality}
            {PRACTICE.address.region}
            {PRACTICE.address.postcode}
          </span>
        </li>
      </ul>
      <a class="svc__contact-cta" href="/contact/">Contact the practice →</a>
    </section>

    {page.disclaimer && <p class="svc__disclaimer">{page.disclaimer}</p>}
  </article>
</Base>

<style>
  .svc {
    max-inline-size: var(--container-prose);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4) var(--space-9);
  }
  .crumbs {
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .svc__title {
    font-size: var(--type-display-2, var(--type-h1));
    line-height: 1.15;
    margin-block: var(--space-2) var(--space-3);
  }
  .svc__subtitle {
    font-size: var(--type-body-lg, var(--type-body));
    color: var(--color-text-muted);
    margin-block-end: var(--space-2);
  }
  .svc__meta {
    color: var(--color-text-muted);
    font-size: var(--type-body-sm);
  }
  .svc__toc {
    margin-block: var(--space-6);
    padding: var(--space-4);
    background: var(--color-ground-warm);
    border-radius: var(--radius-card);
  }
  .svc__toc-h {
    font-weight: 600;
    margin-block-end: var(--space-2);
  }
  .svc__toc ol {
    margin: 0;
    padding-inline-start: var(--space-4);
  }
  .svc__toc-l3 {
    margin-inline-start: var(--space-3);
  }
  .svc__body :global(h2) {
    margin-block: var(--space-6) var(--space-3);
    scroll-margin-block-start: var(--space-8);
  }
  .svc__body :global(h3) {
    margin-block: var(--space-4) var(--space-2);
    scroll-margin-block-start: var(--space-8);
  }
  .svc__body :global(p),
  .svc__body :global(ul),
  .svc__body :global(ol) {
    margin-block: var(--space-3);
    line-height: 1.7;
  }
  .svc__body :global(li) {
    margin-block: var(--space-1);
  }
  .svc__faq {
    margin-block-start: var(--space-7);
  }
  .svc__faq details {
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    padding-block: var(--space-3);
  }
  .svc__faq summary {
    font-weight: 600;
    cursor: pointer;
  }
  .svc__cta {
    margin-block-start: var(--space-7);
    padding: var(--space-5);
    background: var(--color-ground-warm);
    border-radius: var(--radius-card);
  }
  .svc__cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-block-start: var(--space-3);
  }
  .svc__cta-btn {
    display: inline-block;
    background: var(--color-action);
    color: var(--color-action-contrast);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-control);
    text-decoration: none;
    font-weight: 500;
  }
  .svc__cta-link {
    color: var(--color-text-muted);
  }
  .svc__related {
    margin-block-start: var(--space-7);
  }
  .svc__related ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .svc__contact {
    margin-block-start: var(--space-7);
    padding: var(--space-5);
    background: var(--color-ground-warm);
    border-radius: var(--radius-card);
  }
  .svc__contact h2 {
    margin-block-end: var(--space-2);
  }
  .svc__contact-lead {
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
    max-inline-size: 60ch;
  }
  .svc__contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: grid;
    gap: var(--space-2);
  }
  .svc__contact-list li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--type-body-sm);
  }
  .svc__contact-list span:first-child {
    min-inline-size: 4rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: var(--type-caption);
  }
  .svc__contact-cta {
    font-weight: 600;
    color: var(--color-action);
    text-decoration: underline;
  }
  .svc__disclaimer {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    font-size: var(--type-caption);
    font-style: italic;
    color: var(--color-text-muted);
  }
</style>
