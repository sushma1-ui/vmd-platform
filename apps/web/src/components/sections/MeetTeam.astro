---
/**
 * MeetTeam — a homepage glimpse of the featured professionals: a left-aligned
 * header and two horizontal cards (photo · name · role · short bio), leading to
 * the full "Meet the Team" page. Shares the same data source as /about/team/.
 */
import { cms } from '../../lib/cms.ts';
import { resolveTeam, roleOf, bioOf, photoUrlOf, initialsOf } from '../../lib/team.ts';

let cmsMembers: Awaited<ReturnType<typeof cms.teamMembers>> = [];
try {
  cmsMembers = await cms.teamMembers();
} catch {
  /* fall back to featured defaults */
}
const team = resolveTeam(cmsMembers).slice(0, 2);
---

<section data-reveal class="mt section--bone" aria-labelledby="mt-h">
  <div class="mt__inner">
    <header class="mt__head">
      <p class="eyebrow">The people behind your matter</p>
      <h2 class="mt__h" id="mt-h">
        You work <span class="hl">directly</span> with the people preparing your case
      </h2>
    </header>

    <ul class="mt__grid" role="list">
      {
        team.map((m) => {
          const photo = photoUrlOf(m);
          const title = roleOf(m);
          const bio = bioOf(m);
          return (
            <li class="mtc">
              <figure class:list={['mtc__portrait', photo && 'mtc__portrait--photo']}>
                {photo ? (
                  <img
                    class="mtc__img"
                    src={photo}
                    alt={`${m.name} — ${title}`}
                    loading="lazy"
                    decoding="async"
                    width="176"
                    height="176"
                  />
                ) : (
                  <span class="mtc__mono" aria-hidden="true">
                    {initialsOf(m.name)}
                  </span>
                )}
              </figure>
              <div class="mtc__body">
                <h3 class="mtc__name">{m.name}</h3>
                <p class="mtc__role">
                  {title}
                  {m.credential && <span class="mtc__cred"> · {m.credential}</span>}
                </p>
                {bio && <p class="mtc__bio">{bio}</p>}
              </div>
            </li>
          );
        })
      }
    </ul>

    <a class="mt__more" href="/about/team/"
      >Meet the entire team <span aria-hidden="true">→</span></a
    >
  </div>
</section>

<style>
  /* Warm bone ground — part of the homepage's alternating section rhythm. */
  .mt {
    background: var(--color-ground-warm);
  }
  .mt__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: clamp(var(--space-6), 4vw, var(--space-7)) var(--space-4);
  }
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis-text);
    font-weight: 700;
    margin: 0;
  }
  .mt__head {
    max-inline-size: 60ch;
    margin-block-end: var(--space-5);
  }
  .mt__h {
    font-size: var(--type-h2);
    line-height: 1.15;
    margin: var(--space-2) 0 0;
    color: var(--color-action);
    text-wrap: balance;
  }
  .mt__h .hl {
    color: var(--color-emphasis-text);
    font-style: italic;
  }

  /* Two horizontal member cards. */
  .mt__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .mt__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .mtc {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    padding: var(--space-4);
  }
  .mtc__portrait {
    flex: none;
    margin: 0;
    inline-size: 5.25rem;
    block-size: 5.25rem;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-ground-warm);
    display: grid;
    place-items: center;
  }
  .mtc__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .mtc__portrait--photo .mtc__img {
    filter: saturate(0.96) contrast(1.02);
  }
  .mtc__mono {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    font-weight: 600;
    color: var(--color-emphasis-text);
  }
  .mtc__body {
    min-inline-size: 0;
  }
  .mtc__name {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: 1.15;
    margin: 0 0 2px;
    color: var(--color-action);
  }
  .mtc__role {
    margin: 0 0 var(--space-2);
    font-size: var(--type-body-sm);
    font-weight: 600;
    color: var(--color-emphasis-text);
    line-height: 1.35;
  }
  .mtc__cred {
    white-space: nowrap;
  }
  .mtc__bio {
    margin: 0;
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }
  .mt__more {
    display: inline-block;
    margin-block-start: var(--space-5);
    font-weight: 600;
    color: var(--color-interactive-strong);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: border-color var(--motion-fast, 180ms) var(--ease-standard, ease);
  }
  .mt__more span {
    display: inline-block;
    transition: transform var(--motion-fast, 180ms) var(--ease-standard, ease);
  }
  .mt__more:hover,
  .mt__more:focus-visible {
    border-block-end-color: currentColor;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mt__more:hover span {
      transform: translateX(3px);
    }
  }
</style>
