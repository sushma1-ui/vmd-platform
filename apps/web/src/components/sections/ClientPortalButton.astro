---
/**
 * Client Portal navigation button — a premium brand-blue CTA distinct from the content
 * nav links. Label, destination, colour and visibility come from the CMS Settings
 * global (getClientPortal), falling back to @vmd/config defaults. Renders nothing when
 * disabled. The optional CMS colour is hex-validated in getClientPortal before it ever
 * reaches the style attribute.
 */
import { getClientPortal } from '../../lib/cms.ts';

interface Props {
  variant?: 'desktop' | 'mobile';
}
const { variant = 'desktop' } = Astro.props;
const cp = await getClientPortal();
// The portal lives on an external system (Migration Manager), so open it in a new
// tab with rel="noopener noreferrer". Internal URLs (if ever configured) open in place.
const isExternal = /^https?:\/\//i.test(cp.url);
---

{
  cp.enabled && (
    <a
      class:list={['cpbtn', `cpbtn--${variant}`]}
      href={cp.url}
      target={isExternal ? '_blank' : undefined}
      rel={isExternal ? 'noopener noreferrer' : undefined}
      style={cp.color ? `--cp-bg:${cp.color}` : undefined}
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect
          x="4"
          y="10"
          width="16"
          height="10"
          rx="2"
          stroke="currentColor"
          stroke-width="1.75"
        />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.75" />
      </svg>
      {cp.label}
    </a>
  )
}

<style>
  .cpbtn {
    --cp-bg: var(--color-interactive-strong);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-block-size: var(--space-6);
    padding-inline: var(--space-4);
    padding-block: var(--space-2);
    background: var(--cp-bg);
    color: var(--color-text-inverse);
    border: 1px solid transparent;
    border-radius: var(--radius-chip);
    font-family: var(--font-body);
    font-size: var(--type-body-sm);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 1px 2px color-mix(in srgb, var(--cp-bg) 35%, transparent);
    transition:
      transform var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard);
  }
  .cpbtn:hover {
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--cp-bg) 90%, black);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--cp-bg) 45%, transparent);
  }
  .cpbtn:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }
  .cpbtn svg {
    flex: none;
  }
  .cpbtn--mobile {
    inline-size: 100%;
  }
  @media (prefers-reduced-motion: reduce) {
    .cpbtn {
      transition: none;
    }
    .cpbtn:hover {
      transform: none;
    }
  }
</style>
