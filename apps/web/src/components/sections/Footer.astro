---
import { PRACTICE, RMA_LINE } from '@vmd/config';
import { Disclaimer } from '@vmd/ui';
import SocialLinks from './SocialLinks.astro';
const cols = [
  {
    h: 'Our Services',
    links: [
      ['All services', '/services/'],
      ['Skilled Independent (189)', '/visas/subclass-189-skilled-independent-visa'],
      ['Employer Sponsored (482)', '/visas/subclass-482-skills-in-demand-visa'],
      ['Partner visas', '/visas/partner-visa-onshore-820-801'],
      ['Skills Assessment', '/services/skills-assessment'],
      ['Refusals & Appeals', '/services/art-review-applications'],
    ],
  },
  {
    h: 'Practice',
    links: [
      ['About', '/about/'],
      ['Sunil Uprety, RMA', '/about/sunil-uprety/'],
      ['Our Fees', '/about/fees/'],
      ['Contact', '/contact/'],
    ],
  },
  {
    h: 'Checkable',
    links: [
      [`${RMA_LINE} · OMARA register`, PRACTICE.regulator.registerUrl],
      ['Code of Conduct', PRACTICE.regulator.registerUrl],
      ['Complaints & Feedback', '/complaints/'],
      ['Client Reviews', '/results/reviews/'],
    ],
  },
  {
    h: 'Legal',
    links: [
      ['Privacy Policy', '/privacy/'],
      ['Terms', '/terms/'],
      ['Accessibility', '/accessibility/'],
      ['Sitemap', '/sitemap/'],
    ],
  },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <p class="footer__name">{PRACTICE.legalName}</p>
      <p class="footer__nap">
        {PRACTICE.address.street}, {PRACTICE.address.locality}
        {PRACTICE.address.region}
        {PRACTICE.address.postcode}
      </p>
      <p class="footer__nap">
        <a href={`tel:${PRACTICE.contact.phone}`}>{PRACTICE.contact.phoneDisplay}</a> · <a
          href={`mailto:${PRACTICE.contact.email}`}>{PRACTICE.contact.email}</a
        >
      </p>
      <p class="footer__nap">{RMA_LINE}</p>
      <div class="footer__social">
        <SocialLinks label={`Follow ${PRACTICE.legalName} on social media`} />
      </div>
    </div>
    {
      cols.map((c) => (
        <nav class="footer__col" aria-label={c.h}>
          <p class="footer__h">{c.h}</p>
          {c.links.map(([label, href]) => (
            <a class="footer__link" href={href}>
              {label}
            </a>
          ))}
        </nav>
      ))
    }
  </div>
  <div class="footer__legal">
    <Disclaimer variant="outcomes" />
    <p class="footer__copy">
      © {new Date().getFullYear()}
      {PRACTICE.legalName} — a migration practice led by Registered Migration Agent (RMA) {
        PRACTICE.principal.name
      } (MARN: {PRACTICE.principal.marn}), bound by the Migration Agents Code of Conduct (OMARA).
    </p>
  </div>
</footer>
<style>
  .footer {
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
    margin-block-start: var(--space-9);
  }
  .footer__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: var(--type-h3);
  }
  .footer__nap {
    font-size: var(--type-body-sm);
    color: color-mix(in srgb, var(--color-text-inverse) 82%, transparent);
    margin-block-start: var(--space-1);
  }
  .footer__nap a {
    color: inherit;
  }
  .footer__social {
    margin-block-start: var(--space-4);
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer__h {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-emphasis);
  }
  .footer__link {
    color: color-mix(in srgb, var(--color-text-inverse) 88%, transparent);
    text-decoration: none;
    font-size: var(--type-body-sm);
  }
  .footer__link:hover {
    color: var(--color-text-inverse);
  }
  .footer__legal {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--space-4) var(--space-8);
  }
  .footer__copy {
    font-size: var(--type-caption);
    color: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
    margin-block-start: var(--space-3);
  }
  @media (min-width: 768px) {
    .footer__inner {
      grid-template-columns: 1.4fr repeat(4, 1fr);
    }
  }
</style>
