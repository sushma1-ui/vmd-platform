---
import { PRACTICE, RMA_LINE } from '@vmd/config';
import { Disclaimer } from '@vmd/ui';
import SocialLinks from './SocialLinks.astro';
import { getFooterColumns } from '../../lib/cms.ts';
const colsFallback = [
  {
    h: 'Our Services',
    links: [
      ['All services', '/services/'],
      ['Skilled Independent (189)', '/visas/subclass-189-skilled-independent-visa'],
      ['Employer Sponsored (482)', '/visas/subclass-482-skills-in-demand-visa'],
      ['Partner visas', '/visas/partner-visa-onshore-820-801'],
      ['Skills Assessment', '/services/skills-assessment'],
      ['Second Opinion', '/services/second-opinion/'],
      ['Refusal Recovery', '/services/refusal-recovery/'],
    ],
  },
  {
    h: 'Practice',
    links: [
      ['About', '/about/'],
      ['Sunil Uprety, RMA', '/about/sunil-uprety/'],
      ['Contact', '/contact/'],
    ],
  },
  {
    h: 'Checkable',
    links: [
      [`${RMA_LINE} · OMARA register`, PRACTICE.regulator.registerSearchUrl],
      ['Code of Conduct', PRACTICE.regulator.codeOfConductUrl],
      ['Complaints & Feedback', '/complaints/'],
      ['Client Reviews', '/results/reviews/'],
    ],
  },
  {
    h: 'Legal',
    links: [
      ['Privacy Policy', '/privacy/'],
      ['Terms', '/terms/'],
      ['Accessibility', '/accessibility/'],
      ['Sitemap', '/sitemap/'],
    ],
  },
];
// Prefer CMS-managed footer columns; fall back to the built-in defaults.
const cmsCols = await getFooterColumns();
const cols = cmsCols
  ? cmsCols.map((c) => ({ h: c.heading, links: c.links.map((l) => [l.label, l.href] as const) }))
  : colsFallback;

// Acknowledgement of Country — single source of truth. Update this wording here
// if the practice relocates or opens offices on other Country; the relevant
// Traditional Custodians differ by location (the practice currently sits on
// Whadjuk Noongar Country, Perth WA). No layout change is needed to edit it.
const ACKNOWLEDGEMENT =
  'We acknowledge and respect the Traditional Custodians of the lands, seas, skies and waterways where we are privileged to live and work, including the Whadjuk Noongar people on whose land our practice sits.';
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <img
        class="footer__logo"
        src="/logo-vmd.png"
        alt=""
        width="96"
        height="96"
        loading="lazy"
        decoding="async"
      />
      <p class="footer__name">{PRACTICE.legalName}</p>
      <p class="footer__nap">
        {PRACTICE.address.street}, {PRACTICE.address.locality}
        {PRACTICE.address.region}
        {PRACTICE.address.postcode}
      </p>
      <p class="footer__nap">
        <a href={`tel:${PRACTICE.contact.phone}`}>{PRACTICE.contact.phoneDisplay}</a> · <a
          href={`mailto:${PRACTICE.contact.email}`}>{PRACTICE.contact.email}</a
        >
      </p>
      <p class="footer__nap">{RMA_LINE}</p>
      <div class="footer__social">
        <SocialLinks label={`Follow ${PRACTICE.legalName} on social media`} />
      </div>
    </div>
    {
      cols.map((c) => (
        <nav class="footer__col" aria-label={c.h}>
          <p class="footer__h">{c.h}</p>
          {c.links.map(([label, href]) => (
            <a class="footer__link" href={href}>
              {label}
            </a>
          ))}
        </nav>
      ))
    }
  </div>
  <section class="ack" aria-label="Acknowledgement of Country">
    <div class="ack__inner">
      <p class="ack__label">Acknowledgement of Country</p>
      <p class="ack__body">{ACKNOWLEDGEMENT}</p>
    </div>
  </section>
  <div class="footer__legal">
    <Disclaimer variant="outcomes" />
    <p class="footer__copy">
      © {new Date().getFullYear()}
      {PRACTICE.legalName} — a migration practice led by Registered Migration Agent (RMA) {
        PRACTICE.principal.name
      } (MARN: {PRACTICE.principal.marn}), bound by the Migration Agents Code of Conduct (OMARA).
    </p>
  </div>
</footer>
<style>
  .footer {
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
    margin-block-start: var(--space-9);
  }
  .footer__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }
  .footer__logo {
    inline-size: 3rem;
    block-size: 3rem;
    object-fit: contain;
    display: block;
    margin-block-end: var(--space-3);
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: var(--type-h3);
  }
  .footer__nap {
    font-size: var(--type-body-sm);
    color: color-mix(in srgb, var(--color-text-inverse) 82%, transparent);
    margin-block-start: var(--space-1);
  }
  .footer__nap a {
    color: inherit;
  }
  .footer__social {
    margin-block-start: var(--space-4);
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .footer__h {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-emphasis);
  }
  .footer__link {
    color: color-mix(in srgb, var(--color-text-inverse) 88%, transparent);
    text-decoration: none;
    font-size: var(--type-body-sm);
    overflow-wrap: anywhere;
  }
  .footer__link:hover {
    color: var(--color-text-inverse);
  }
  /* Acknowledgement of Country — a considered statement between the footer nav
     and the copyright. Understated, readable, generously spaced; a single thin
     divider separates it from the navigation above. No icons, no heavy borders. */
  .ack {
    border-block-start: 1px solid color-mix(in srgb, var(--color-text-inverse) 12%, transparent);
  }
  .ack__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4);
  }
  .ack__label {
    margin: 0 0 var(--space-2);
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-emphasis-text);
  }
  .ack__body {
    margin: 0;
    max-inline-size: 72ch;
    font-size: 0.85rem;
    line-height: 1.75;
    color: color-mix(in srgb, var(--color-text-inverse) 90%, transparent);
  }
  .footer__legal {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--space-4) var(--space-8);
  }
  .footer__copy {
    font-size: var(--type-caption);
    color: color-mix(in srgb, var(--color-text-inverse) 70%, transparent);
    margin-block-start: var(--space-3);
  }
  /* Tablet: a roomy 2-column layout. The tight 5-column row only kicks in once
     there is genuinely room for it, so nothing overflows around 768px. */
  @media (min-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 960px) {
    .footer__inner {
      grid-template-columns: 1.4fr repeat(4, 1fr);
    }
  }
</style>
