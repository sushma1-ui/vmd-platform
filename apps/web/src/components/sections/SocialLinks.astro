---
/**
 * Social links — icon-only, shared by the header utility bar and the footer.
 * Minimal single-path glyphs (currentColor, no icon library). Each profile is
 * only rendered when its URL is set in PRACTICE.social; external links open in a
 * new tab with rel="noopener noreferrer" and an accessible label.
 */
import { PRACTICE } from '@vmd/config';
import { getSocialLinks } from '../../lib/cms.ts';

interface Props {
  label?: string;
}
const { label = `Follow ${PRACTICE.legalName}` } = Astro.props;

// Prefer CMS-managed URLs (Social Media global); fall back to @vmd/config.
const cms = await getSocialLinks();
const url = (key: 'facebook' | 'instagram' | 'linkedin' | 'tiktok' | 'youtube') =>
  cms[key] || (PRACTICE.social as Record<string, string | undefined>)[key];

const socials = [
  {
    label: 'Facebook',
    href: url('facebook'),
    path: 'M13.5 21v-7h2.3l.4-2.8h-2.7V9.4c0-.8.2-1.4 1.4-1.4H16V5.5c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5v1.9H8.2V14h2.4v7h2.9z',
  },
  {
    label: 'Instagram',
    href: url('instagram'),
    path: 'M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.9A3.1 3.1 0 1 1 12 8.9a3.1 3.1 0 0 1 0 6.2zM17 5.6a1.12 1.12 0 1 0 0 2.24 1.12 1.12 0 0 0 0-2.24zM20.4 8.9c-.1-1-.3-1.9-1-2.6-.7-.7-1.6-.9-2.6-1C15.7 5.2 15.3 5.2 12 5.2s-3.7 0-4.8.1c-1 .1-1.9.3-2.6 1-.7.7-.9 1.6-1 2.6C3.5 10 3.5 10.4 3.5 12s0 3.7.1 4.8c.1 1 .3 1.9 1 2.6.7.7 1.6.9 2.6 1 1.1.1 1.5.1 4.8.1s3.7 0 4.8-.1c1-.1 1.9-.3 2.6-1 .7-.7.9-1.6 1-2.6.1-1.1.1-1.5.1-4.8s0-3.7-.1-4.8zm-2 9.4a2.5 2.5 0 0 1-1.4 1.4c-1 .4-3.3.3-4.9.3s-3.9.1-4.9-.3a2.5 2.5 0 0 1-1.4-1.4c-.4-1-.3-3.3-.3-4.9s-.1-3.9.3-4.9A2.5 2.5 0 0 1 7.1 6.7c1-.4 3.3-.3 4.9-.3s3.9-.1 4.9.3a2.5 2.5 0 0 1 1.4 1.4c.4 1 .3 3.3.3 4.9s.1 3.9-.3 4.9z',
  },
  {
    label: 'LinkedIn',
    href: url('linkedin'),
    path: 'M6.94 8.5H4.3V21h2.64V8.5zM5.62 4.2A1.53 1.53 0 1 0 5.6 7.26a1.53 1.53 0 0 0 .02-3.06zM21 21h-2.63v-6.1c0-1.46-.03-3.33-2.03-3.33-2.03 0-2.34 1.58-2.34 3.22V21H11.4V8.5h2.52v1.7h.04c.35-.66 1.2-1.36 2.48-1.36 2.66 0 3.15 1.75 3.15 4.02V21z',
  },
  {
    label: 'TikTok',
    href: url('tiktok'),
    path: 'M16.5 3c.3 1.9 1.4 3.4 3.5 3.6v2.4c-1.2 0-2.4-.4-3.4-1.1v5.6c0 3.4-2.6 5.8-5.7 5.5-2.8-.3-4.9-2.7-4.6-5.5.2-2.4 2.2-4.3 4.6-4.3.3 0 .6 0 .9.1v2.5c-.3-.1-.6-.2-.9-.2-1.3 0-2.3 1.1-2.2 2.4.1 1.2 1.1 2.1 2.3 2 1.2 0 2.1-1 2.1-2.2V3h2.9z',
  },
  {
    label: 'YouTube',
    href: url('youtube'),
    path: 'M21.6 7.2a2.5 2.5 0 0 0-1.76-1.77C18.28 5 12 5 12 5s-6.28 0-7.84.43A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.76 1.77C5.72 19 12 19 12 19s6.28 0 7.84-.43A2.5 2.5 0 0 0 21.6 16.8 26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3-5.2 3z',
  },
].filter((s) => s.href);
---

{
  socials.length > 0 && (
    <ul class="social" aria-label={label}>
      {socials.map((s) => (
        <li>
          <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={s.path} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }
  .social a {
    display: grid;
    place-items: center;
    inline-size: 1.9rem;
    block-size: 1.9rem;
    border-radius: 50%;
    color: color-mix(in srgb, var(--color-text-inverse) 82%, transparent);
    transition:
      color var(--motion-base, 150ms) var(--ease-standard, ease),
      background var(--motion-base, 150ms) var(--ease-standard, ease);
  }
  .social a:hover,
  .social a:focus-visible {
    color: var(--color-ground-deep);
    background: var(--color-emphasis);
  }
  .social svg {
    display: block;
  }
</style>
