---
/**
 * GoogleReviews — live Google Business Profile reviews on the homepage.
 *
 * Pulls the aggregate rating, total count and latest reviews from the official
 * Places API via `getGoogleReviews()` (server-side, cached). Nothing is
 * hardcoded: if reviews are configured and present we show real cards + the real
 * average; otherwise we degrade to a neutral "read the reviews on Google" panel.
 *
 * A `profileUrl` prop lets the caller supply the CMS-configured Business Profile
 * link as a fallback for the "read on Google" CTA when the API doesn't return one.
 */
import { getGoogleReviews, googleReviewsUrl } from '../../lib/google-reviews.ts';

interface Props {
  /** Fallback Google profile URL (from CMS Settings) if the API omits one. */
  profileUrl?: string | null;
  /** How many review cards to show (Google exposes up to 5). CMS-controlled. */
  limit?: number;
  /** Section heading (CMS-controlled). */
  heading?: string | null;
  /** Intro line under the heading (CMS-controlled). */
  intro?: string | null;
  /** Curated real reviews (CMS pinned reviews) shown when no live API data. */
  pinned?:
    | {
        reviewerName?: string | null;
        rating?: number | null;
        text?: string | null;
        reviewDate?: string | null;
      }[]
    | null;
}

const {
  profileUrl = null,
  limit = 3,
  heading = 'Google Reviews',
  intro = 'Placed here, after the evidence and the person, reviews read as corroboration — not advertising.',
  pinned = null,
} = Astro.props;

const data = await getGoogleReviews();
const reviews = data.reviews.slice(0, limit);
const hasLive = reviews.length > 0;
const href = data.profileUrl || profileUrl || googleReviewsUrl;
const ratingLabel = data.rating != null ? data.rating.toFixed(1) : null;

// Prefer live API reviews; otherwise show the curated pinned reviews from the CMS so
// the section always shows real content (never an empty placeholder).
const cards = hasLive
  ? reviews.map((r) => ({ author: r.author, rating: r.rating, text: r.text, when: r.when }))
  : (pinned ?? []).slice(0, limit).map((p) => ({
      author: p.reviewerName ?? '',
      rating: p.rating ?? 5,
      text: p.text ?? '',
      when: p.reviewDate ?? '',
    }));
const hasCards = cards.length > 0;

const stars = (n: number) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
---

<div class="reviews">
  <div class="grid grid--2 reviews__grid">
    <div>
      <p class="eyebrow">Attested — third parties speak</p>
      <h2 class="section__h" id="reviews-h">
        <span aria-hidden="true">★★★★★</span>
        {heading}
      </h2>
      {
        ratingLabel && data.total != null && (
          <p class="reviews__agg">
            <strong>{ratingLabel}</strong> ★ average from{' '}
            <strong>{data.total.toLocaleString('en-AU')}</strong> Google reviews
          </p>
        )
      }
      {intro && <p class="section__sub">{intro}</p>}
      <a
        class="reviews__link"
        href={href}
        rel="noopener"
        target={href.startsWith('http') ? '_blank' : null}
      >
        Read the reviews on Google →
      </a>
    </div>

    {
      hasCards ? (
        <ul class="reviews__list" role="list">
          {cards.map((r) => (
            <li class="rev-card">
              <div class="rev-card__top">
                <p class="rev-card__stars" aria-label={`${r.rating} out of 5`}>
                  <span aria-hidden="true">{stars(r.rating)}</span>
                </p>
                {r.when && <span class="rev-card__when">{r.when}</span>}
              </div>
              <p class="rev-card__text">{r.text}</p>
              <p class="rev-card__author">— {r.author}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="reviews__cta">
          <p class="reviews__cta-stars" aria-hidden="true">
            ★★★★★
          </p>
          <p class="reviews__cta-text">
            Our clients tell their own stories on our Google Business Profile — in their words,
            verified by Google.
          </p>
          <a
            class="reviews__cta-btn"
            href={href}
            rel="noopener"
            target={href.startsWith('http') ? '_blank' : null}
          >
            Read our Google reviews →
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  .reviews__agg {
    font-size: var(--type-body-lg);
    color: var(--color-text);
    margin-block: var(--space-2) 0;
  }
  .reviews__agg strong {
    color: var(--color-emphasis-text);
  }
  .reviews__link {
    display: inline-block;
    margin-block-start: var(--space-4);
    color: var(--color-interactive-strong);
    font-weight: 600;
    text-decoration: none;
  }
  .reviews__link:hover {
    text-decoration: underline;
  }
  .reviews__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }
  .rev-card {
    border: 1px solid color-mix(in srgb, var(--color-emphasis) 22%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    background: var(--color-surface);
  }
  .rev-card__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .rev-card__stars {
    color: var(--color-emphasis-text);
    letter-spacing: 0.1em;
    margin: 0;
  }
  .rev-card__when {
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .rev-card__text {
    margin-block: var(--space-3) var(--space-3);
    color: var(--color-text);
  }
  .rev-card__author {
    margin: 0;
    font-weight: 600;
    color: var(--color-text);
  }
  .reviews__cta {
    border: 1px solid color-mix(in srgb, var(--color-emphasis) 22%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .reviews__cta-stars {
    margin: 0;
    color: var(--color-emphasis-text);
    letter-spacing: 0.15em;
    font-size: var(--type-h3);
  }
  .reviews__cta-text {
    margin: 0;
    color: var(--color-text);
    line-height: 1.5;
  }
  .reviews__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    margin-block-start: var(--space-1);
    background: var(--color-interactive-strong);
    color: var(--color-text-inverse);
    border-radius: var(--radius-control);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--motion-fast, 150ms) var(--ease-standard, ease);
  }
  .reviews__cta-btn:hover {
    background: color-mix(in srgb, var(--color-interactive-strong) 88%, black);
  }
  .reviews__cta-btn:focus-visible {
    outline: 3px solid var(--color-action);
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .reviews__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
