---
/**
 * GoogleReviews — live Google Business Profile reviews on the homepage.
 *
 * Pulls the aggregate rating, total count and latest reviews from the official
 * Places API via `getGoogleReviews()` (server-side, cached). Nothing is
 * hardcoded: if reviews are configured and present we show real cards + the real
 * average; otherwise we degrade to a neutral "read the reviews on Google" panel.
 *
 * A `profileUrl` prop lets the caller supply the CMS-configured Business Profile
 * link as a fallback for the "read on Google" CTA when the API doesn't return one.
 */
import { getGoogleReviews, googleReviewsUrl } from '../../lib/google-reviews.ts';

interface Props {
  /** Fallback Google profile URL (from CMS Settings) if the API omits one. */
  profileUrl?: string | null;
  /** How many review cards to show (Google exposes up to 5). CMS-controlled. */
  limit?: number;
  /** Section heading (CMS-controlled). */
  heading?: string | null;
  /** Intro line under the heading (CMS-controlled). */
  intro?: string | null;
  /** Curated real reviews (CMS pinned reviews) shown when no live API data. */
  pinned?:
    | {
        reviewerName?: string | null;
        rating?: number | null;
        text?: string | null;
        reviewDate?: string | null;
      }[]
    | null;
  /** Average rating (CMS Settings) — used when no live API aggregate. */
  rating?: number | null;
  /** Total review count (CMS Settings) — used when no live API aggregate. */
  count?: number | null;
}

const {
  profileUrl = null,
  limit = 3,
  heading = 'Google Reviews',
  intro = 'Placed here, after the evidence and the person, reviews read as corroboration — not advertising.',
  pinned = null,
  rating = null,
  count = null,
} = Astro.props;

const data = await getGoogleReviews();
const reviews = data.reviews.slice(0, limit);
const hasLive = reviews.length > 0;
const href = data.profileUrl || profileUrl || googleReviewsUrl;
// Aggregate: prefer the live API figures, otherwise the CMS-configured rating/count.
const aggRating =
  data.rating != null ? data.rating.toFixed(1) : rating != null ? rating.toFixed(1) : null;
const aggCount = data.total ?? count ?? null;

// Prefer live API reviews; otherwise show the curated pinned reviews from the CMS so
// the section always shows real content (never an empty placeholder).
const cards = hasLive
  ? reviews.map((r) => ({ author: r.author, rating: r.rating, text: r.text, when: r.when }))
  : (pinned ?? []).slice(0, limit).map((p) => ({
      author: p.reviewerName ?? '',
      rating: p.rating ?? 5,
      text: p.text ?? '',
      when: p.reviewDate ?? '',
    }));
const hasCards = cards.length > 0;

const stars = (n: number) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();
---

<div class="reviews">
  <div class="grid grid--2 reviews__grid">
    <div>
      <p class="eyebrow">Attested — third parties speak</p>
      <h2 class="section__h" id="reviews-h">
        <span aria-hidden="true">★★★★★</span>
        {heading}
      </h2>
      {
        aggRating && (
          <p class="reviews__agg">
            <strong>{aggRating}</strong> ★{' '}
            {aggCount != null ? (
              <>
                average from <strong>{aggCount.toLocaleString('en-AU')}</strong> Google reviews
              </>
            ) : (
              <>average on Google</>
            )}
          </p>
        )
      }
      {intro && <p class="section__sub">{intro}</p>}
      <a
        class="reviews__link"
        href={href}
        rel="noopener"
        target={href.startsWith('http') ? '_blank' : null}
      >
        Read the reviews on Google →
      </a>
    </div>

    {
      hasCards ? (
        <ul class="reviews__list" role="list">
          {cards.map((r) => (
            <li class="rev-card">
              <div class="rev-card__head">
                <span class="rev-card__av" aria-hidden="true">
                  {initials(r.author)}
                </span>
                <div class="rev-card__id">
                  <p class="rev-card__author">{r.author}</p>
                  <p class="rev-card__meta">
                    <span class="rev-card__stars" aria-label={`${r.rating} out of 5`}>
                      <span aria-hidden="true">{stars(r.rating)}</span>
                    </span>
                    {r.when && <span class="rev-card__when">{r.when}</span>}
                  </p>
                </div>
                <svg
                  class="rev-card__g"
                  viewBox="0 0 48 48"
                  width="18"
                  height="18"
                  aria-hidden="true"
                >
                  <path
                    fill="#4285F4"
                    d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
                  />
                  <path
                    fill="#34A853"
                    d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
                  />
                  <path
                    fill="#FBBC05"
                    d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"
                  />
                  <path
                    fill="#EA4335"
                    d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
                  />
                </svg>
              </div>
              <p class="rev-card__text">{r.text}</p>
            </li>
          ))}
        </ul>
      ) : (
        <div class="reviews__cta">
          <p class="reviews__cta-stars" aria-hidden="true">
            ★★★★★
          </p>
          <p class="reviews__cta-text">
            Our clients tell their own stories on our Google Business Profile — in their words,
            verified by Google.
          </p>
          <a
            class="reviews__cta-btn"
            href={href}
            rel="noopener"
            target={href.startsWith('http') ? '_blank' : null}
          >
            Read our Google reviews →
          </a>
        </div>
      )
    }
  </div>
</div>

<style>
  .reviews__agg {
    font-size: var(--type-body-lg);
    color: var(--color-text);
    margin-block: var(--space-2) 0;
  }
  .reviews__agg strong {
    color: var(--color-emphasis-text);
  }
  .reviews__link {
    display: inline-block;
    margin-block-start: var(--space-4);
    color: var(--color-interactive-strong);
    font-weight: 600;
    text-decoration: none;
  }
  .reviews__link:hover {
    text-decoration: underline;
  }
  .reviews__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
  }
  .rev-card {
    border: 1px solid color-mix(in srgb, var(--color-emphasis) 22%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    background: var(--color-surface);
  }
  .rev-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-3);
  }
  .rev-card__av {
    flex: none;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(150deg, var(--color-action), var(--color-ground-deep));
    color: var(--color-text-inverse);
    font-weight: 700;
    font-size: var(--type-body-sm);
    letter-spacing: 0.02em;
  }
  .rev-card__id {
    min-inline-size: 0;
  }
  .rev-card__author {
    margin: 0;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
  }
  .rev-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 2px 0 0;
  }
  .rev-card__stars {
    color: var(--color-emphasis-text);
    letter-spacing: 0.06em;
    margin: 0;
  }
  .rev-card__when {
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .rev-card__g {
    flex: none;
    margin-inline-start: auto;
    align-self: flex-start;
  }
  .rev-card__text {
    margin: 0;
    color: var(--color-text);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .reviews__cta {
    border: 1px solid color-mix(in srgb, var(--color-emphasis) 22%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }
  .reviews__cta-stars {
    margin: 0;
    color: var(--color-emphasis-text);
    letter-spacing: 0.15em;
    font-size: var(--type-h3);
  }
  .reviews__cta-text {
    margin: 0;
    color: var(--color-text);
    line-height: 1.5;
  }
  .reviews__cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    margin-block-start: var(--space-1);
    background: var(--color-interactive-strong);
    color: var(--color-text-inverse);
    border-radius: var(--radius-control);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--motion-fast, 150ms) var(--ease-standard, ease);
  }
  .reviews__cta-btn:hover {
    background: color-mix(in srgb, var(--color-interactive-strong) 88%, black);
  }
  .reviews__cta-btn:focus-visible {
    outline: 3px solid var(--color-action);
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .reviews__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }
</style>
