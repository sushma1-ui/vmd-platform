---
/**
 * Client Testimonials — three equal-height cards, each a consistent carousel:
 *   1) Google Reviews          — real pinned reviews (auto-advancing), → /results/reviews/
 *   2) Visa & Skill Assessments — real, consented, privacy-safe client graphics
 *      (names redacted in-image), click → lightbox; → dedicated gallery pages
 *   3) Client Stories          — elegant video placeholder ("Coming soon"),
 *      auto-upgrades to a carousel when videos exist
 *
 * Compliance: no "success / guaranteed / approved / certain outcome" wording in
 * our copy; the standing outcomes disclaimer is shown. Documents are the client's
 * own consented graphics. Performance: preview WebP + loading="lazy" + fixed
 * aspect so there is no layout shift. Carousels: CSS scroll-snap (native swipe),
 * prev/next, dots-or-counter, keyboard; reviews auto-advance (paused on hover/
 * focus and disabled for reduced motion). No external libraries.
 */
import { Disclaimer } from '@vmd/ui';
import { VISA_GRANTS, SKILLS_ASSESSMENTS, type SuccessMedia } from '../../lib/successMedia.ts';
import { googleReviewsUrl } from '../../lib/google-reviews.ts';

interface ReviewIn {
  reviewerName?: string | null;
  rating?: number | null;
  text?: string | null;
  reviewDate?: string | null;
  googleReviewUrl?: string | null;
}
interface Props {
  reviews?: ReviewIn[];
  profileUrl?: string | null;
}
const { reviews = [], profileUrl = null } = Astro.props;

const reviewCards = reviews
  .map((r) => ({
    name: (r.reviewerName || '').trim(),
    initials: (r.reviewerName || '?')
      .split(/\s+/)
      .map((w) => w[0])
      .filter(Boolean)
      .join('')
      .slice(0, 2)
      .toUpperCase(),
    rating: Math.round(r.rating ?? 5),
    text: (r.text || '').trim(),
    date: (r.reviewDate || '').trim(),
    url: (r.googleReviewUrl || '').trim(),
  }))
  .filter((r) => r.text || r.name);

// Card 2: grants first, then skills assessments — one carousel, one lightbox.
const documents: SuccessMedia[] = [...VISA_GRANTS, ...SKILLS_ASSESSMENTS];
const grantCount = VISA_GRANTS.length;
const skillCount = SKILLS_ASSESSMENTS.length;
const reviewsHref = '/results/reviews/';
// External link to the live reviews on Google — CMS profile URL, else the
// Place-ID fallback so it always resolves.
const googleHref = profileUrl || googleReviewsUrl;

const GoogleG = `<svg viewBox="0 0 48 48" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78z"/><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/></svg>`;
const chevron = (d: string) =>
  `<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="${d}"/></svg>`;
---

<section class="ctx ctx--photo ctx--dark section" data-reveal aria-labelledby="ctx-h">
  <div class="ctx__inner">
    <p class="eyebrow">Client testimonials</p>
    <h2 class="ctx__h" id="ctx-h">Real clients. Real experiences.</h2>
    <p class="ctx__sub">
      Read verified Google reviews, view genuine visa and skills assessment outcomes, and hear
      directly from the people we've helped.
    </p>

    <div class="ctx__grid">
      {/* ---- CARD 1 · GOOGLE REVIEWS ------------------------------------- */}
      <article class="card">
        <header class="card__head">
          <span class="card__ico card__ico--plain" set:html={GoogleG} />
          <div class="card__headtext">
            <h3 class="card__title">Google Reviews</h3>
            <p class="card__sub">Verified reviews from our clients.</p>
          </div>
        </header>

        <div class="card__body">
          {
            reviewCards.length ? (
              <div class="car" data-carousel data-autoscroll aria-roledescription="carousel">
                <div class="car__viewport">
                  <ul class="car__track" data-track role="list" aria-label="Google reviews">
                    {reviewCards.map((r) => (
                      <li class="car__slide">
                        <div class="rev">
                          <div class="rev__head">
                            <span class="rev__avatar" aria-hidden="true">
                              {r.initials}
                            </span>
                            <div>
                              <p class="rev__name">{r.name}</p>
                              <p class="rev__stars" aria-label={`${r.rating} out of 5`}>
                                {'★'.repeat(r.rating)}
                                {r.date && <span class="rev__date"> · {r.date}</span>}
                              </p>
                            </div>
                          </div>
                          {r.text && <blockquote class="rev__text">“{r.text}”</blockquote>}
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="car__ctrls">
                  <button
                    class="car__nav"
                    type="button"
                    data-prev
                    aria-label="Previous review"
                    set:html={chevron('M15 6l-6 6 6 6')}
                  />
                  <div class="car__dots" data-dots />
                  <button
                    class="car__nav"
                    type="button"
                    data-next
                    aria-label="Next review"
                    set:html={chevron('M9 6l6 6-6 6')}
                  />
                </div>
              </div>
            ) : (
              <div class="ctx__empty">
                <p class="ctx__empty-note">Verified, dated reviews from the people we've guided.</p>
              </div>
            )
          }
        </div>

        <footer class="card__foot card__foot--split">
          <a class="card__link" href={reviewsHref}>View all reviews →</a>
          <a class="card__link" href={googleHref} rel="noopener" target="_blank">Read on Google →</a
          >
        </footer>
      </article>

      {/* ---- CARD 2 · VISA & SKILL ASSESSMENTS --------------------------- */}
      <article class="card">
        <header class="card__head">
          <span class="card__ico" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z M14 3v5h5 M9 15l2 2 4-4"
              ></path>
            </svg>
          </span>
          <div class="card__headtext">
            <h3 class="card__title">Visa &amp; Skill Assessments</h3>
            <p class="card__sub">Real, consented outcomes — client details redacted.</p>
          </div>
        </header>

        <div class="card__body">
          <div class="car" data-carousel aria-roledescription="carousel">
            <div class="car__viewport">
              <ul
                class="car__track"
                data-track
                role="list"
                aria-label="Visa and skills assessment documents"
              >
                {
                  documents.map((d, i) => (
                    <li class="car__slide">
                      <button
                        class="doc"
                        type="button"
                        data-doc
                        data-index={i}
                        data-src={d.full}
                        data-alt={d.alt}
                        aria-label={`View ${d.category === 'visa-grant' ? 'visa' : 'skills assessment'}: ${d.label}`}
                      >
                        <span class="doc__frame">
                          <img
                            src={d.preview}
                            alt={d.alt}
                            width={d.width}
                            height={d.height}
                            loading={i === 0 ? 'eager' : 'lazy'}
                            decoding="async"
                          />
                          <span class="doc__zoom" aria-hidden="true">
                            <svg
                              viewBox="0 0 24 24"
                              width="16"
                              height="16"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                            >
                              <path d="M11 5a6 6 0 100 12 6 6 0 000-12zM20 20l-3.5-3.5M11 8v6M8 11h6" />
                            </svg>
                          </span>
                        </span>
                        <span class="doc__cap">
                          <span class="doc__tag">
                            {d.category === 'visa-grant' ? 'Visa' : 'Skills assessment'}
                          </span>
                          <span class="doc__label">
                            {d.label}
                            {d.sub ? ` · ${d.sub}` : ''}
                          </span>
                        </span>
                      </button>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="car__ctrls">
              <button
                class="car__nav"
                type="button"
                data-prev
                aria-label="Previous document"
                set:html={chevron('M15 6l-6 6 6 6')}
              />
              <div class="car__dots" data-dots></div>
              <button
                class="car__nav"
                type="button"
                data-next
                aria-label="Next document"
                set:html={chevron('M9 6l6 6-6 6')}
              />
            </div>
          </div>
        </div>

        <footer class="card__foot">
          <a class="card__link" href="/results/visa-grants/">
            View all {grantCount + skillCount} documents →
          </a>
        </footer>
      </article>

      {/* ---- CARD 3 · CLIENT STORIES ------------------------------------- */}
      <article class="card">
        <header class="card__head">
          <span class="card__ico" aria-hidden="true">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path
                d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13A1.5 1.5 0 0 1 18.5 20h-13A1.5 1.5 0 0 1 4 18.5z M10 9l5 3-5 3z"
              ></path>
            </svg>
          </span>
          <div class="card__headtext">
            <h3 class="card__title">Client Stories</h3>
            <p class="card__sub">Hear directly from the people we've helped.</p>
          </div>
        </header>

        <div class="card__body">
          <div class="story" aria-label="Client story videos — coming soon">
            <span class="story__play" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor"
                ><path d="M8 5v14l11-7z"></path></svg
              >
            </span>
            <span class="story__soon">Coming soon</span>
          </div>
        </div>

        <footer class="card__foot">
          <span class="card__link card__link--muted">Video stories in production</span>
        </footer>
      </article>
    </div>

    <Disclaimer variant="outcomes" />
  </div>

  {/* ---- Document lightbox ------------------------------------------------ */}
  {
    documents.length > 0 && (
      <dialog class="dlb" data-doc-lb aria-label="Client document">
        <button class="dlb__x" type="button" data-dlb-close aria-label="Close">
          ✕
        </button>
        <img class="dlb__img" data-dlb-img alt="" />
        <p class="dlb__count" data-dlb-count aria-live="polite" />
        <button
          class="dlb__nav dlb__nav--prev"
          type="button"
          data-dlb-prev
          aria-label="Previous"
          set:html={chevron('M15 6l-6 6 6 6')}
        />
        <button
          class="dlb__nav dlb__nav--next"
          type="button"
          data-dlb-next
          aria-label="Next"
          set:html={chevron('M9 6l6 6-6 6')}
        />
      </dialog>
    )
  }
</section>

<script>
  // ---- Carousels: transform-based (translateX) + drag/swipe + keyboard ------
  const DOTS_MAX = 8;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const dotsWrap = root.querySelector<HTMLElement>('[data-dots]');
    if (!track || !prev || !next || !dotsWrap) return;
    const count = track.children.length;
    if (!count) return;

    let index = 0;
    const useDots = count <= DOTS_MAX;
    let dots: HTMLElement[] = [];
    if (useDots) {
      for (let i = 0; i < count; i++) {
        const d = document.createElement('button');
        d.type = 'button';
        d.className = 'car__dot';
        d.setAttribute('aria-label', `Go to item ${i + 1} of ${count}`);
        d.addEventListener('click', () => go(i));
        dotsWrap.appendChild(d);
      }
      dots = Array.from(dotsWrap.children) as HTMLElement[];
    } else {
      dotsWrap.classList.add('car__dots--counter');
      dotsWrap.setAttribute('aria-live', 'polite');
    }

    const apply = () => {
      track.style.transform = `translateX(${-index * 100}%)`;
      if (useDots)
        dots.forEach((d, i) => d.setAttribute('aria-current', i === index ? 'true' : 'false'));
      else dotsWrap.textContent = `${index + 1} / ${count}`;
      prev.disabled = index <= 0;
      next.disabled = index >= count - 1;
      root.classList.toggle('car--single', count <= 1);
    };
    const go = (i: number) => {
      index = Math.max(0, Math.min(count - 1, i));
      apply();
    };

    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1);
      }
    });

    // Drag / swipe (pointer events). A real drag suppresses the click that would
    // otherwise open a document, so swiping never triggers the lightbox.
    let startX = 0,
      dx = 0,
      dragging = false,
      width = 0,
      moved = false;
    const down = (e: PointerEvent) => {
      dragging = true;
      moved = false;
      startX = e.clientX;
      dx = 0;
      width = track.getBoundingClientRect().width || 1;
      root.classList.add('is-dragging');
    };
    const move = (e: PointerEvent) => {
      if (!dragging) return;
      dx = e.clientX - startX;
      if (Math.abs(dx) > 6) moved = true;
      track.style.transform = `translateX(calc(${-index * 100}% + ${dx}px))`;
    };
    const up = () => {
      if (!dragging) return;
      dragging = false;
      root.classList.remove('is-dragging');
      if (Math.abs(dx) > width * 0.18) go(index + (dx < 0 ? 1 : -1));
      else apply();
      dx = 0;
    };
    track.addEventListener('pointerdown', down);
    track.addEventListener('pointermove', move);
    track.addEventListener('pointerup', up);
    track.addEventListener('pointercancel', up);
    track.addEventListener('pointerleave', up);
    track.addEventListener(
      'click',
      (e) => {
        if (moved) {
          e.preventDefault();
          e.stopPropagation();
          moved = false;
        }
      },
      true,
    );

    // Auto-advance (reviews only): paused on hover/focus/interaction, off for reduced motion.
    if (root.hasAttribute('data-autoscroll') && !reduceMotion && count > 1) {
      let timer = 0;
      const tick = () => go(index >= count - 1 ? 0 : index + 1);
      const start = () => {
        stop();
        timer = window.setInterval(tick, 7000);
      };
      const stop = () => {
        if (timer) {
          clearInterval(timer);
          timer = 0;
        }
      };
      ['pointerenter', 'focusin', 'pointerdown'].forEach((ev) => root.addEventListener(ev, stop));
      ['pointerleave', 'focusout', 'pointerup'].forEach((ev) => root.addEventListener(ev, start));
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      start();
    }

    apply();
  });

  // ---- Document lightbox ----------------------------------------------------
  const dlb = document.querySelector<HTMLDialogElement>('[data-doc-lb]');
  if (dlb) {
    const img = dlb.querySelector<HTMLImageElement>('[data-dlb-img]')!;
    const countEl = dlb.querySelector<HTMLElement>('[data-dlb-count]')!;
    const prevBtn = dlb.querySelector<HTMLButtonElement>('[data-dlb-prev]')!;
    const nextBtn = dlb.querySelector<HTMLButtonElement>('[data-dlb-next]')!;
    const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-doc]'));
    const docs = triggers.map((t) => ({ src: t.dataset.src || '', alt: t.dataset.alt || '' }));
    let current = 0;
    const render = (i: number) => {
      current = i;
      img.src = docs[i].src;
      img.alt = docs[i].alt;
      countEl.textContent = `${i + 1} / ${docs.length}`;
      prevBtn.disabled = i <= 0;
      nextBtn.disabled = i >= docs.length - 1;
      prevBtn.hidden = nextBtn.hidden = docs.length < 2;
    };
    triggers.forEach((t, i) =>
      t.addEventListener('click', () => {
        render(i);
        dlb.showModal();
      }),
    );
    prevBtn.addEventListener('click', () => current > 0 && render(current - 1));
    nextBtn.addEventListener('click', () => current < docs.length - 1 && render(current + 1));
    dlb.querySelector('[data-dlb-close]')?.addEventListener('click', () => dlb.close());
    dlb.addEventListener('click', (e) => {
      if (e.target === dlb) dlb.close();
    });
    dlb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && current > 0) render(current - 1);
      if (e.key === 'ArrowRight' && current < docs.length - 1) render(current + 1);
    });
  }
</script>

<style>
  .ctx__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
    position: relative;
    z-index: 1;
  }
  /* Slight dark-blue section — a refined navy ground (not the heavy near-black
     ink) with the family-reunion photo as subtle atmosphere behind it, and white
     text + light cards on top. */
  .ctx--dark {
    background: linear-gradient(
      180deg,
      var(--color-action),
      color-mix(in srgb, var(--color-action) 90%, black)
    );
    color: var(--color-text-inverse);
    padding-block: var(--space-5);
  }
  .ctx--photo {
    position: relative;
    isolation: isolate;
  }
  .ctx--photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Family-reunion backdrop (happy-people.avif is the graceful fallback). Biased
       slightly upward so the busiest faces sit lower — behind the cards. Kept faint
       so the dark blue clearly reads as the background. */
    background:
      url('/family-reunion.webp') center 28% / cover no-repeat,
      url('/happy-people.avif') center / cover no-repeat;
    opacity: 0.28;
    pointer-events: none;
  }
  .ctx--dark::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Navy veil — keeps the dark blue dominant and the white text crisp. */
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-action) 52%, transparent),
      color-mix(in srgb, var(--color-action) 72%, transparent)
    );
  }
  /* Tablet/mobile: dial the image back further so the cards stay the focus. */
  @media (max-width: 640px) {
    .ctx--photo::before {
      opacity: 0.18;
    }
  }
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis);
    font-weight: 700;
  }
  .ctx__h {
    font-size: var(--type-h2);
    margin-block: var(--space-2) var(--space-2);
    text-wrap: balance;
    color: var(--color-text-inverse);
  }
  .ctx__sub {
    font-size: var(--type-body);
    color: color-mix(in srgb, var(--color-text-inverse) 84%, transparent);
    max-inline-size: 64ch;
    margin-block-end: var(--space-5);
  }

  /* ---- Three equal-height cards ----------------------------------------- */
  .ctx__grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    align-items: stretch;
    margin-block-end: var(--space-3);
  }
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-action) 11%, transparent);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-subtle, 0 6px 22px -16px rgba(14, 26, 48, 0.34));
    overflow: hidden;
    transition:
      transform 180ms var(--ease-standard, ease),
      box-shadow 180ms var(--ease-standard, ease),
      border-color 180ms var(--ease-standard, ease);
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-3px);
    box-shadow: var(--shadow-raised, 0 22px 46px -26px rgba(14, 26, 48, 0.4));
    border-color: color-mix(in srgb, var(--color-emphasis) 34%, transparent);
  }
  .card__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-4) var(--space-2);
  }
  .card__ico {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--color-emphasis) 14%, transparent);
    color: var(--color-emphasis-text);
  }
  .card__ico--plain {
    background: color-mix(in srgb, var(--color-action) 6%, transparent);
  }
  .card__title {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--color-action);
    margin: 0;
    line-height: 1.15;
  }
  .card__sub {
    margin: 2px 0 0;
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .card__body {
    flex: 1 1 auto;
    display: flex;
    padding-inline: var(--space-4);
  }
  .card__foot {
    padding: var(--space-2) var(--space-4) var(--space-4);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 8%, transparent);
    margin-block-start: var(--space-3);
  }
  .card__foot--split {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .card__link {
    font-weight: 600;
    font-size: var(--type-body-sm);
    color: var(--color-emphasis-text);
    text-decoration: none;
  }
  .card__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card__link--muted {
    color: var(--color-text-muted);
    font-weight: 500;
  }

  /* ---- Carousel (shared) ------------------------------------------------- */
  .car {
    inline-size: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .car__viewport {
    overflow: hidden;
  }
  /* Transform-based track (JS-controlled translateX) — deterministic across
     browsers, no native-scroll quirks; drag/swipe handled in script. */
  .car__track {
