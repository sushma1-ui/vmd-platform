---
/**
 * Client Testimonials — a compact, Google-Reviews-only social-proof section.
 *
 * One elegant featured review at a time (mobile and desktop), carouselled with
 * subtle arrows + dots. Real data only: prefers the live Google Business Profile
 * reviews (getGoogleReviews), falling back to the CMS "pinned reviews" passed in
 * — never fabricated. If neither is available it degrades to a quiet "read on
 * Google" line, not an empty placeholder.
 *
 * Deliberately restrained: no background image, no dark overlay, no visa/skills
 * cards, no "coming soon" video. The visa-grant / skills-assessment content lives
 * on the dedicated /results/ pages and is unaffected by this section.
 */
import { getGoogleReviews, googleReviewsUrl } from '../../lib/google-reviews.ts';

interface ReviewIn {
  reviewerName?: string | null;
  rating?: number | null;
  text?: string | null;
  reviewDate?: string | null;
  googleReviewUrl?: string | null;
}
interface Props {
  /** CMS pinned reviews — used as a fallback when the live API returns nothing. */
  reviews?: ReviewIn[];
  /** Fallback Google profile URL (CMS Settings) if the API omits one. */
  profileUrl?: string | null;
}
const { reviews: pinned = [], profileUrl = null } = Astro.props;

// Curated GENUINE Google reviews supplied by the practice from its Google
// Business Profile. Real content — not fabricated. (These can be moved to the
// CMS pinned-reviews collection later; kept here for a reliable, premium
// carousel that doesn't depend on the live Places API being configured.)
const CURATED_REVIEWS = [
  {
    name: 'Utshab Bhusal',
    rating: 5,
    date: '4 months ago',
    text: 'I recently received my subclass 190 visa as a Chef. He really simplified the process and broke down each and every section, which relieved me from stress and gave me time to focus back on my work and wellbeing. He was very flexible with his schedule whenever I needed guidance and offered me the best service in Perth. I would recommend him as your migration agent based on my experience. I sincerely want to thank him for his efforts, which resulted in my permanent residency.',
  },
  {
    name: 'Saroj Naharki',
    rating: 5,
    date: '7 months ago',
    text: "I had a great experience applying for my mum's visa through Sunil. He was professional and always ready to help. Thanks to his guidance, I would definitely recommend him to others.",
  },
  {
    name: 'Bhumika Aryal',
    rating: 5,
    date: 'a year ago',
    text: "I had a great experience working with Sunil during my visa process. He proved to be a very reliable and trustworthy person throughout. He consistently kept me updated with all the documentation and every step of the process, which made everything smooth and stress-free. I'm very happy with his service and would highly recommend him to anyone looking for a professional for visa processing.",
  },
  {
    name: 'Shasank Pathak',
    rating: 5,
    date: '7 months ago',
    text: 'Thank you Visa & Migration Doctors for your honest advice and constant support. The whole process was smooth and well guided. We truly felt looked after. Highly recommended to anyone needing visa assistance.',
  },
  {
    name: 'Savyna GC',
    rating: 5,
    date: '2 months ago',
    text: 'Excellent team and outstanding service. Highly recommended for everyone who is struggling for trustworthy and reliable advice.',
  },
  {
    name: 'Laxmi Sharma',
    rating: 5,
    date: 'a year ago',
    text: "Sunil has been one of the most professional, efficient, and supportive individuals I've ever known. I highly recommend seeking his help if you're looking for excellent service.",
  },
];

const data = await getGoogleReviews();
const href = data.profileUrl || profileUrl || googleReviewsUrl;
const external = href.startsWith('http');

// Aggregate (only when we genuinely have it from the live API).
const aggRating = data.rating != null ? data.rating.toFixed(1) : null;
const aggCount = data.total ?? null;

// The carousel shows the curated genuine reviews. Live API / CMS pinned reviews
// are used only as a fallback if the curated list is ever emptied.
const live = data.reviews.map((r) => ({
  name: r.author,
  rating: Math.round(r.rating ?? 5),
  text: r.text,
  date: r.when,
}));
const fallback = pinned.map((p) => ({
  name: (p.reviewerName ?? '').trim(),
  rating: Math.round(p.rating ?? 5),
  text: (p.text ?? '').trim(),
  date: (p.reviewDate ?? '').trim(),
}));
const cards = (CURATED_REVIEWS.length ? CURATED_REVIEWS : live.length ? live : fallback).filter(
  (c) => c.text || c.name,
);

const clamp = (n: number) => Math.max(0, Math.min(5, n));
const filled = (n: number) => '★★★★★'.slice(0, clamp(n));
const empty = (n: number) => '★★★★★'.slice(0, 5 - clamp(n));
const initials = (name: string) =>
  (name || '?')
    .split(/\s+/)
    .filter(Boolean)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();

const GoogleG = `<svg viewBox="0 0 48 48" width="20" height="20" aria-hidden="true"><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78z"/><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/></svg>`;
---

<section class="rvs section" data-reveal aria-labelledby="rvs-h">
  <div class="rvs__inner">
    <p class="eyebrow">Client testimonials</p>
    <h2 class="rvs__h" id="rvs-h">Real experiences. Real clients.</h2>
    {
      aggRating && (
        <p class="rvs__agg">
          <span class="rvs__g" set:html={GoogleG} />
          <strong>{aggRating}</strong>
          <span class="rvs__agg-stars" aria-hidden="true">
            ★★★★★
          </span>
          {aggCount != null && (
            <span class="rvs__agg-count">
              from {aggCount.toLocaleString('en-AU')} Google reviews
            </span>
          )}
        </p>
      )
    }

    {
      cards.length ? (
        <div class="rvs__car" data-rvs aria-roledescription="carousel" aria-label="Google reviews">
          <div class="rvs__viewport">
            <ul class="rvs__track" data-rvs-track role="list">
              {cards.map((r) => (
                <li class="rvs__slide">
                  <article class="rvc">
                    <span class="rvc__g" aria-hidden="true" set:html={GoogleG} />
                    <p class="rvc__stars" aria-label={`${r.rating} out of 5`}>
                      <span class="rvc__stars-on" aria-hidden="true">
                        {filled(r.rating)}
                      </span>
                      <span class="rvc__stars-off" aria-hidden="true">
                        {empty(r.rating)}
                      </span>
                    </p>
                    {r.text && <blockquote class="rvc__quote">“{r.text}”</blockquote>}
                    <footer class="rvc__foot">
                      <span class="rvc__av" aria-hidden="true">
                        {initials(r.name)}
                      </span>
                      <span class="rvc__id">
                        <span class="rvc__name">{r.name}</span>
                      </span>
                    </footer>
                  </article>
                </li>
              ))}
            </ul>
          </div>

          {cards.length > 1 && (
            <div class="rvs__ctrls">
              <button class="rvs__nav" type="button" data-rvs-prev aria-label="Previous review">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    d="M15 6l-6 6 6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="rvs__dots" data-rvs-dots aria-hidden="true" />
              <button class="rvs__nav" type="button" data-rvs-next aria-label="Next review">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <path
                    d="M9 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
            </div>
          )}
        </div>
      ) : (
        <p class="rvs__empty">
          Read verified reviews from the people we’ve guided on our{' '}
          <a href={href} rel="noopener" target={external ? '_blank' : null}>
            Google Business Profile
          </a>
          .
        </p>
      )
    }

    <a class="rvs__all" href={href} rel="noopener" target={external ? '_blank' : null}>
      Read all Google Reviews →
    </a>
  </div>
</section>

<script>
  // Minimal, self-contained review carousel: one review per view, translateX,
  // prev/next + dots, wrap-around, keyboard, and gentle auto-advance that pauses
  // on hover/focus and is disabled under reduced-motion.
  document.querySelectorAll<HTMLElement>('[data-rvs]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-rvs-track]');
    const prev = root.querySelector<HTMLButtonElement>('[data-rvs-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-rvs-next]');
    const dotsWrap = root.querySelector<HTMLElement>('[data-rvs-dots]');
    if (!track) return;
    const count = track.children.length;
    if (count <= 1) return;

    let index = 0;
    const dots: HTMLButtonElement[] = [];
    if (dotsWrap) {
      for (let i = 0; i < count; i++) {
        const d = document.createElement('button');
        d.type = 'button';
        d.className = 'rvs__dot';
        d.setAttribute('aria-label', `Go to review ${i + 1} of ${count}`);
        d.addEventListener('click', () => go(i));
        dotsWrap.appendChild(d);
        dots.push(d);
      }
    }

    const apply = () => {
      track.style.transform = `translateX(${-index * 100}%)`;
      dots.forEach((d, i) => d.setAttribute('aria-current', i === index ? 'true' : 'false'));
    };
    const go = (i: number) => {
      index = ((i % count) + count) % count;
      apply();
    };

    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(index + 1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(index - 1);
      }
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      let timer = 0;
      const start = () => {
        stop();
        timer = window.setInterval(() => go(index + 1), 7000);
      };
      const stop = () => {
        if (timer) {
          clearInterval(timer);
          timer = 0;
        }
      };
      ['pointerenter', 'focusin'].forEach((ev) => root.addEventListener(ev, stop));
      ['pointerleave', 'focusout'].forEach((ev) => root.addEventListener(ev, start));
      document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
      start();
    }

    apply();
  });
</script>

<style>
  .rvs {
    background: var(--color-ground-light);
    padding-block: var(--space-6);
  }
  .rvs__inner {
    max-inline-size: 52rem;
    margin-inline: auto;
    padding-inline: var(--space-4);
    text-align: center;
  }
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis-text);
    font-weight: 700;
    margin: 0;
  }
  .rvs__h {
    font-size: var(--type-h2);
    color: var(--color-action);
    margin: var(--space-2) 0 0;
    text-wrap: balance;
  }
  .rvs__agg {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .rvs__g {
    display: inline-flex;
    line-height: 0;
  }
  .rvs__agg strong {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--color-action);
    line-height: 1;
  }
  .rvs__agg-stars {
    color: var(--color-emphasis-text);
    letter-spacing: 0.04em;
  }

  /* ---- Carousel ---------------------------------------------------------- */
  .rvs__car {
    margin-block-start: var(--space-5);
  }
  .rvs__viewport {
    overflow: hidden;
  }
  .rvs__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    transition: transform 420ms var(--ease-standard, ease);
  }
  .rvs__slide {
    flex: 0 0 100%;
    min-inline-size: 0;
    padding-inline: 2px;
    box-sizing: border-box;
  }
  .rvc {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    max-inline-size: 46rem;
    margin-inline: auto;
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-overlay, 0 22px 46px -26px rgba(16, 30, 60, 0.34));
  }
  .rvc__g {
    line-height: 0;
  }
  .rvc__stars {
    margin: 0;
    font-size: var(--type-body-lg);
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .rvc__stars-on {
    color: var(--color-emphasis-text);
  }
  .rvc__stars-off {
    color: color-mix(in oklab, var(--color-text-muted) 34%, transparent);
  }
  .rvc__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-body-lg);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text);
    text-wrap: pretty;
    /* Keep the featured review to a readable, uniform height. */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .rvc__foot {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-block-start: var(--space-1);
  }
  .rvc__av {
    flex: none;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--color-action) 8%, transparent);
    color: var(--color-action);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--type-body-sm);
  }
  .rvc__id {
    text-align: start;
    line-height: 1.25;
  }
  .rvc__name {
    display: block;
    font-weight: 600;
    color: var(--color-text);
  }

  /* ---- Controls ---------------------------------------------------------- */
  .rvs__ctrls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-4);
  }
  .rvs__nav {
    flex: none;
    inline-size: 2.4rem;
    block-size: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--color-hairline-strong);
    background: var(--color-surface);
    color: var(--color-action);
    cursor: pointer;
    transition: border-color 150ms var(--ease-standard, ease);
  }
  .rvs__nav:hover,
  .rvs__nav:focus-visible {
    border-color: var(--color-emphasis);
  }
  .rvs__nav:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }
  .rvs__dots {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .rvs__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-action) 20%, transparent);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      transform 150ms ease;
  }
  .rvs__dot[aria-current='true'] {
    background: var(--color-emphasis-text);
    transform: scale(1.35);
  }
  .rvs__dot:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: 2px;
  }

  .rvs__empty {
    margin-block-start: var(--space-4);
    color: var(--color-text-muted);
  }
  .rvs__empty a {
    color: var(--color-action);
  }
  .rvs__all {
    display: inline-block;
    margin-block-start: var(--space-5);
    font-weight: 600;
    color: var(--color-interactive-strong);
    text-decoration: none;
    border-block-end: 1px solid transparent;
    transition: border-color 150ms var(--ease-standard, ease);
  }
  .rvs__all:hover,
  .rvs__all:focus-visible {
    border-block-end-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .rvs__track {
      transition: none;
    }
  }
</style>
