---
/**
 * Trust & Success gateway — three premium "preview" cards that build trust fast
 * and route visitors to the dedicated Reviews & Testimonials hub, instead of a
 * wall of reviews on the homepage. Each card hints at the content inside:
 *   1) Google Reviews  — G mark, 5.0★, one short verbatim snippet
 *   2) Visa outcomes   — a privacy-safe, redacted "Granted" visual (no real doc)
 *   3) Client stories  — a video-thumbnail placeholder (video-ready, "coming soon")
 *
 * CSS-only hover (lift + deepen shadow); every card is a single semantic link.
 */
import { Disclaimer } from '@vmd/ui';

interface Props {
  heading?: string | null;
  intro?: string | null;
  rating?: number | null;
  count?: number | null;
  review?: { reviewerName?: string | null; text?: string | null } | null;
  href?: string;
}

const {
  heading = 'Real clients. Real experiences.',
  intro = 'A registered practice with verified reviews, real visa outcomes, and clients across Australia and the world.',
  rating = null,
  count = null,
  review = null,
  href = '/results/success-stories/',
} = Astro.props;

const snippet = (review?.text ?? '').trim();
const reviewer = (review?.reviewerName ?? '').trim();
---

<section class="ts section section--bone" data-reveal aria-labelledby="ts-h">
  <div class="ts__inner">
    <p class="eyebrow">Trust &amp; success</p>
    <h2 class="ts__h" id="ts-h">{heading}</h2>
    {intro && <p class="ts__sub">{intro}</p>}

    <ul class="ts__grid" role="list">
      {/* Card 1 — Google Reviews */}
      <li>
        <a class="tcard" href={href} aria-label="View all Google reviews">
          <div class="tcard__preview">
            <div class="tcard__ghead">
              <svg class="tcard__g" viewBox="0 0 48 48" width="24" height="24" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"
                ></path>
                <path
                  fill="#34A853"
                  d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"
                ></path>
                <path
                  fill="#FBBC05"
                  d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78z"
                ></path>
                <path
                  fill="#EA4335"
                  d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"
                ></path>
              </svg>
              <span class="tcard__stars" aria-hidden="true">★★★★★</span>
              {
                rating != null && (
                  <span class="tcard__rating">
                    <strong>{rating.toFixed(1)}</strong>
                    {count ? ` · ${count} reviews` : ' on Google'}
                  </span>
                )
              }
            </div>
            {
              snippet ? (
                <blockquote class="tcard__snippet">
                  “{snippet}”{reviewer && <cite>— {reviewer}</cite>}
                </blockquote>
              ) : (
                <p class="tcard__snippet tcard__snippet--muted">
                  Verified, dated reviews from the people we've guided — in their own words.
                </p>
              )
            }
          </div>
          <div class="tcard__body">
            <h3 class="tcard__title">Google Reviews</h3>
            <p class="tcard__text">Read verified reviews from clients we've helped.</p>
            <span class="tcard__cta">View all Google reviews →</span>
          </div>
        </a>
      </li>

      {/* Card 2 — Visa Grant Successes */}
      <li>
        <a class="tcard" href={href} aria-label="View successful visa outcomes">
          <div class="tcard__preview">
            <div class="grantmock" aria-hidden="true">
              <span class="grantmock__badge">Granted</span>
              <span class="grantmock__gov">Department of Home Affairs</span>
              <span class="grantmock__bar" style="inline-size:82%"></span>
              <span class="grantmock__bar" style="inline-size:66%"></span>
              <span class="grantmock__bar grantmock__bar--redact" style="inline-size:44%"></span>
              <span class="grantmock__bar" style="inline-size:74%"></span>
            </div>
            <ul class="tcard__chips" aria-hidden="true">
              <li>Skilled</li>
              <li>Student</li>
              <li>Employer sponsored</li>
              <li>Skills assessment</li>
            </ul>
          </div>
          <div class="tcard__body">
            <h3 class="tcard__title">Visa &amp; skills successes</h3>
            <p class="tcard__text">
              Real, consented client outcomes — sensitive details always masked.
            </p>
            <span class="tcard__cta">View successful outcomes →</span>
          </div>
        </a>
      </li>

      {/* Card 3 — Client Stories & Videos */}
      <li>
        <a class="tcard" href={href} aria-label="Watch client stories">
          <div class="tcard__preview">
            <div class="videomock" aria-hidden="true">
              <span class="videomock__play">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </span>
              <span class="videomock__soon">Video stories · coming soon</span>
            </div>
            <ul class="tcard__chips" aria-hidden="true">
              <li>Client story</li>
              <li>Visa journey</li>
              <li>Life in Australia</li>
            </ul>
          </div>
          <div class="tcard__body">
            <h3 class="tcard__title">Client stories</h3>
            <p class="tcard__text">The people behind the outcomes — in words now, on video soon.</p>
            <span class="tcard__cta">Watch client stories →</span>
          </div>
        </a>
      </li>
    </ul>

    <Disclaimer variant="outcomes" />
  </div>
</section>

<style>
  .ts__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis-text);
    font-weight: 600;
  }
  .ts__h {
    font-size: var(--type-h2);
    margin-block: var(--space-2) var(--space-2);
    text-wrap: balance;
    max-inline-size: 22ch;
  }
  .ts__sub {
    font-size: var(--type-body-lg);
    color: var(--color-text-muted);
    max-inline-size: 60ch;
    margin-block-end: var(--space-6);
  }

  .ts__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
  }

  /* Card — a single semantic link, equal height via grid stretch + flex column. */
  .tcard {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
    border-radius: var(--radius-card);
    overflow: hidden;
    text-decoration: none;
    color: var(--color-text);
    box-shadow: var(--shadow-subtle, 0 6px 20px -14px rgba(14, 26, 48, 0.35));
    transition:
      transform 180ms var(--ease-standard, ease),
      box-shadow 180ms var(--ease-standard, ease),
      border-color 180ms var(--ease-standard, ease);
  }
  .tcard:hover,
  .tcard:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-raised, 0 22px 46px -24px rgba(14, 26, 48, 0.42));
    border-color: color-mix(in srgb, var(--color-emphasis) 40%, transparent);
    outline: none;
  }
  .tcard:focus-visible {
    outline: 3px solid var(--color-action);
    outline-offset: 3px;
  }

  /* Preview area — the "hint of content inside". */
  .tcard__preview {
    padding: var(--space-5);
    background: var(--color-ground-warm);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 8%, transparent);
    min-block-size: 12.5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .tcard__ghead {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .tcard__stars {
    color: var(--color-emphasis-text);
    letter-spacing: 0.06em;
  }
  .tcard__rating {
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .tcard__rating strong {
    color: var(--color-emphasis-text);
  }
  .tcard__snippet {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-body-lg);
    line-height: 1.45;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tcard__snippet--muted {
    font-family: var(--font-body);
    font-size: var(--type-body);
    color: var(--color-text-muted);
  }
  .tcard__snippet cite {
    display: block;
    margin-block-start: var(--space-2);
    font-style: normal;
    font-family: var(--font-body);
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }

  /* Redacted "Granted" visual — no real document; privacy by design. */
  .grantmock {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-4);
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    border-radius: var(--radius-control);
  }
  .grantmock__badge {
    align-self: flex-start;
    font-size: var(--type-caption);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-inverse);
    background: var(--color-emphasis-text);
    padding: 0.24rem 0.6rem;
    border-radius: var(--radius-pill, 999px);
    margin-block-end: 0.2rem;
  }
  .grantmock__gov {
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-block-end: 0.2rem;
  }
  .grantmock__bar {
    block-size: 0.55rem;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-action) 14%, transparent);
  }
  .grantmock__bar--redact {
    background: repeating-linear-gradient(
      90deg,
      color-mix(in srgb, var(--color-action) 45%, transparent) 0 10px,
      transparent 10px 16px
    );
  }
  .tcard__chips {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tcard__chips li {
    font-size: var(--type-caption);
    font-weight: 600;
    color: var(--color-action);
    background: color-mix(in srgb, var(--color-action) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-action) 14%, transparent);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill, 999px);
  }

  /* Video-thumbnail placeholder — video-ready. */
  .videomock {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-control);
    background: linear-gradient(150deg, var(--color-action), var(--color-ground-deep));
    display: grid;
    place-items: center;
    gap: var(--space-2);
    overflow: hidden;
  }
  .videomock__play {
    display: grid;
    place-items: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: 50%;
    background: color-mix(in srgb, #fff 90%, transparent);
    color: var(--color-action);
    padding-inline-start: 3px;
  }
  .videomock__soon {
    font-size: var(--type-caption);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text-inverse) 82%, transparent);
  }

  .tcard__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1 1 auto;
  }
  .tcard__title {
    font-size: var(--type-h4);
    color: var(--color-action);
    margin: 0;
  }
  .tcard__text {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--type-body-sm);
    line-height: 1.55;
  }
  .tcard__cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
    font-weight: 600;
    color: var(--color-emphasis-text);
    transition: gap 180ms var(--ease-standard, ease);
  }
  .tcard:hover .tcard__cta {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (min-width: 640px) {
    .ts__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .ts__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tcard {
      transition: none;
    }
    .tcard:hover,
    .tcard:focus-visible {
      transform: none;
    }
  }
</style>
