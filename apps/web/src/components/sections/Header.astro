---
import { PRACTICE } from '@vmd/config';
import { Button } from '@vmd/ui';
const nav = [
  { label: 'Home', href: '/' },
  { label: 'Our Services', href: '/visa-services/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
const register = PRACTICE.regulator.registerSearchUrl;

// Icon-only social links (only rendered when a URL is configured). Minimal
// single-path glyphs, currentColor, no external icon library.
const socials = [
  {
    label: 'Facebook',
    href: PRACTICE.social.facebook,
    path: 'M13.5 21v-7h2.3l.4-2.8h-2.7V9.4c0-.8.2-1.4 1.4-1.4H16V5.5c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5v1.9H8.2V14h2.4v7h2.9z',
  },
  {
    label: 'Instagram',
    href: PRACTICE.social.instagram,
    path: 'M12 7.2A4.8 4.8 0 1 0 12 16.8 4.8 4.8 0 0 0 12 7.2zm0 7.9A3.1 3.1 0 1 1 12 8.9a3.1 3.1 0 0 1 0 6.2zM17 5.6a1.12 1.12 0 1 0 0 2.24 1.12 1.12 0 0 0 0-2.24zM20.4 8.9c-.1-1-.3-1.9-1-2.6-.7-.7-1.6-.9-2.6-1C15.7 5.2 15.3 5.2 12 5.2s-3.7 0-4.8.1c-1 .1-1.9.3-2.6 1-.7.7-.9 1.6-1 2.6C3.5 10 3.5 10.4 3.5 12s0 3.7.1 4.8c.1 1 .3 1.9 1 2.6.7.7 1.6.9 2.6 1 1.1.1 1.5.1 4.8.1s3.7 0 4.8-.1c1-.1 1.9-.3 2.6-1 .7-.7.9-1.6 1-2.6.1-1.1.1-1.5.1-4.8s0-3.7-.1-4.8zm-2 9.4a2.5 2.5 0 0 1-1.4 1.4c-1 .4-3.3.3-4.9.3s-3.9.1-4.9-.3a2.5 2.5 0 0 1-1.4-1.4c-.4-1-.3-3.3-.3-4.9s-.1-3.9.3-4.9A2.5 2.5 0 0 1 7.1 6.7c1-.4 3.3-.3 4.9-.3s3.9-.1 4.9.3a2.5 2.5 0 0 1 1.4 1.4c.4 1 .3 3.3.3 4.9s.1 3.9-.3 4.9z',
  },
  {
    label: 'LinkedIn',
    href: PRACTICE.social.linkedin,
    path: 'M6.94 8.5H4.3V21h2.64V8.5zM5.62 4.2A1.53 1.53 0 1 0 5.6 7.26a1.53 1.53 0 0 0 .02-3.06zM21 21h-2.63v-6.1c0-1.46-.03-3.33-2.03-3.33-2.03 0-2.34 1.58-2.34 3.22V21H11.4V8.5h2.52v1.7h.04c.35-.66 1.2-1.36 2.48-1.36 2.66 0 3.15 1.75 3.15 4.02V21z',
  },
  {
    label: 'TikTok',
    href: PRACTICE.social.tiktok,
    path: 'M16.5 3c.3 1.9 1.4 3.4 3.5 3.6v2.4c-1.2 0-2.4-.4-3.4-1.1v5.6c0 3.4-2.6 5.8-5.7 5.5-2.8-.3-4.9-2.7-4.6-5.5.2-2.4 2.2-4.3 4.6-4.3.3 0 .6 0 .9.1v2.5c-.3-.1-.6-.2-.9-.2-1.3 0-2.3 1.1-2.2 2.4.1 1.2 1.1 2.1 2.3 2 1.2 0 2.1-1 2.1-2.2V3h2.9z',
  },
].filter((s) => s.href);
---

<a class="skip-link" href="#main">Skip to content</a>
<div class="utility">
  <div class="utility__inner">
    <div class="utility__left">
      <a class="utility__item" href={`tel:${PRACTICE.contact.phone}`}>
        {PRACTICE.contact.phoneDisplay}
      </a>
      <a class="utility__item utility__email" href={`mailto:${PRACTICE.contact.email}`}>
        {PRACTICE.contact.email}
      </a>
      <a
        class="utility__item utility__marn"
        href={register}
        rel="noopener noreferrer"
        target="_blank"
      >
        RMA {PRACTICE.principal.name} | MARN {PRACTICE.principal.marn}
      </a>
    </div>
    <ul class="utility__social" aria-label={`Follow ${PRACTICE.legalName}`}>
      {
        socials.map((s) => (
          <li>
            <a href={s.href} aria-label={s.label} rel="noopener noreferrer" target="_blank">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
<header class="header" data-header>
  <div class="header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">VMD</span>
      <span class="brand__name">{PRACTICE.legalName}<small>{PRACTICE.descriptor}</small></span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        nav.map((n) => (
          <a class="nav__link" href={n.href}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="header__cta">
      <Button variant="secondary" href="/book/">Book</Button>
      <Button variant="primary" href="/health-check/">Free Visa Health Check</Button>
    </div>
    <button
      class="burger"
      data-burger
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"
        ><path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path></svg
      >
    </button>
  </div>
  <div class="mnav" id="mobile-nav" data-mobile-nav hidden>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <div class="mnav__cta">
      <Button variant="secondary" href="/book/">Book a consultation</Button>
      <Button variant="primary" href="/health-check/">Free Visa Health Check</Button>
    </div>
  </div>
</header>
<style>
  .utility {
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
  }
  .utility__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--type-caption);
  }
  .utility a {
    color: inherit;
    text-decoration: none;
  }
  .utility__left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-inline-size: 0;
  }
  .utility__item {
    white-space: nowrap;
    transition: color var(--motion-base, 150ms) var(--ease-standard, ease);
  }
  .utility__item:hover,
  .utility__item:focus-visible {
    color: var(--color-emphasis);
  }
  .utility__email,
  .utility__marn {
    display: none;
    color: color-mix(in srgb, var(--color-text-inverse) 80%, transparent);
  }
  .utility__social {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }
  .utility__social a {
    display: grid;
    place-items: center;
    inline-size: 1.9rem;
    block-size: 1.9rem;
    border-radius: 50%;
    color: color-mix(in srgb, var(--color-text-inverse) 82%, transparent);
    transition:
      color var(--motion-base, 150ms) var(--ease-standard, ease),
      background var(--motion-base, 150ms) var(--ease-standard, ease);
  }
  .utility__social a:hover,
  .utility__social a:focus-visible {
    color: var(--color-ground-deep);
    background: var(--color-emphasis);
  }
  .utility__social svg {
    display: block;
  }
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: var(--color-ground-light);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
  }
  .header__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    margin-inline-end: auto;
  }
  .brand__mark {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    background: var(--color-action);
    color: var(--color-text-inverse);
    border-radius: var(--radius-tile);
    font-weight: 800;
    letter-spacing: -0.06em;
    font-size: var(--type-caption);
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--color-action);
    line-height: 1;
    display: flex;
    flex-direction: column;
  }
  .brand__name small {
    font-family: var(--font-body);
    font-size: 0.5em;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-block-start: 3px;
  }
  .nav {
    display: none;
    gap: var(--space-4);
  }
  .nav__link {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body);
    padding-block: var(--space-1);
    border-block-end: 1px solid transparent;
  }
  .nav__link:hover {
    border-block-end-color: var(--color-emphasis);
  }
  .header__cta {
    display: none;
    gap: var(--space-2);
  }
  .burger {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-action) 20%, transparent);
    border-radius: var(--radius-control);
    color: var(--color-action);
    cursor: pointer;
  }
  .mnav {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-5);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .mnav[data-open] {
    display: flex;
  }
  .mnav a {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body-lg);
    padding-block: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 6%, transparent);
  }
  .mnav__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }
  @media (min-width: 640px) {
    .utility__email {
      display: inline;
    }
  }
  @media (min-width: 1024px) {
    .utility__marn {
      display: inline;
    }
    .nav,
    .header__cta {
      display: flex;
    }
    .burger,
    .mnav {
      display: none !important;
    }
  }
</style>
<script>
  const burger = document.querySelector('[data-burger]');
  const panel = document.querySelector('[data-mobile-nav]');
  if (burger && panel) {
    const toggle = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        panel.hidden = false;
        panel.setAttribute('data-open', '');
      } else {
        panel.removeAttribute('data-open');
        panel.hidden = true;
      }
    };
    burger.addEventListener('click', () => toggle(burger.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }
</script>
