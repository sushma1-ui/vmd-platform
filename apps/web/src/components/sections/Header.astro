---
import { PRACTICE, RMA_LINE } from '@vmd/config';
import { Button } from '@vmd/ui';
import SocialLinks from './SocialLinks.astro';
import ClientPortalButton from './ClientPortalButton.astro';
import { cms, getCtaLinks } from '../../lib/cms.ts';
import { buildServiceNav } from '../../lib/serviceNav.ts';
import type { ServiceDoc } from '../../lib/servicePages.ts';
const { bookUrl } = await getCtaLinks();

// "Our Services" mega-menu is built from the live CMS service pages (nothing hardcoded);
// if the CMS is unreachable at build the item degrades to a plain link to /services/.
let serviceNav = null;
try {
  const docs = (await cms.servicePages()) as unknown as ServiceDoc[];
  if (Array.isArray(docs) && docs.length) serviceNav = buildServiceNav(docs);
} catch {
  /* no CMS at build — "Our Services" stays a simple link */
}

const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/', about: true },
  { label: 'Our Services', href: '/services/', mega: true },
  { label: 'Resources', href: '/resources/', resources: true },
  { label: 'Contact Us', href: '/contact/' },
];

// "About" mega — a compact, self-describing information panel (not a plain dropdown).
const aboutNav = {
  intro: 'The people and principles guiding your journey to Australia.',
  moreHref: '/about/',
  items: [
    {
      href: '/about/',
      title: 'Our Story',
      desc: 'How Visa & Migration Doctors helps clients worldwide move to Australia.',
      icon: 'M4 5a2 2 0 0 1 2-2h6v18H6a2 2 0 0 0-2 2zM20 5a2 2 0 0 0-2-2h-6v18h6a2 2 0 0 1 2 2z',
    },
    {
      href: '/about/team/',
      title: 'Meet the Team',
      desc: 'The registered migration professionals behind your case.',
      icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
    },
    {
      href: '/about/why-vmd/',
      title: 'Why Choose VMD',
      desc: 'The reasons clients trust us with one of life’s biggest decisions.',
      icon: 'M12 2 4 5v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V5zM9 12l2 2 4-4',
    },
  ],
};
// "Resources" — a curated resource hub: our own learning content plus official
// Government & trusted third-party tools, grouped under subtle headings.
const resourcesNav = {
  note: 'Official Government and trusted third-party resources.',
  groups: [
    {
      heading: 'Learning',
      items: [
        { href: '/blog/', title: 'Blog & Insights' },
        { href: '/resources/visa-guides/', title: 'Visa Guides' },
        { href: '/resources/checklists/', title: 'Checklists' },
      ],
    },
    {
      heading: 'Official Government Tools',
      items: [
        {
          href: 'https://immi.homeaffairs.gov.au/',
          title: 'Department of Home Affairs',
          external: true,
        },
        {
          href: 'https://online.immi.gov.au/evo/firstParty?actionType=query',
          title: 'VEVO Check',
          external: true,
        },
        {
          href: 'https://immi.homeaffairs.gov.au/visas/visa-pricing-estimator',
          title: 'Visa Pricing Estimator',
          external: true,
        },
        {
          href: 'https://immi.homeaffairs.gov.au/visas/getting-a-visa/visa-processing-times/global-visa-processing-times',
          title: 'Visa Processing Times',
          external: true,
        },
        {
          href: 'https://immi.homeaffairs.gov.au/help-support/departmental-forms/online-forms/points-calculator',
          title: 'Points Test Calculator',
          external: true,
        },
        {
          href: 'https://afpnationalpolicechecks.converga.com.au/',
          title: 'Australian Police Check',
          external: true,
        },
      ],
    },
  ],
};
// Small "opens in a new tab" arrow shown beside every external link.
const extIcon =
  '<svg class="res__ext" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>';
const register = PRACTICE.regulator.registerSearchUrl;
---

<a class="skip-link" href="#main">Skip to content</a>
<div class="utility">
  <div class="utility__inner">
    <div class="utility__left">
      <a class="utility__item" href={`tel:${PRACTICE.contact.phone}`}>
        {PRACTICE.contact.phoneDisplay}
      </a>
      <span class="utility__item utility__marn">{RMA_LINE}</span>
      <a
        class="utility__item utility__verify"
        href={register}
        rel="noopener noreferrer"
        target="_blank"
      >
        Verify on the OMARA register →
      </a>
    </div>
    <SocialLinks />
  </div>
</div>
<header class="header" data-header>
  <div class="header__inner">
    <a class="brand" href="/" aria-label={`${PRACTICE.legalName} — home`}>
      <img class="brand__mark" src="/logo-vmd.png" alt="" width="80" height="80" decoding="async" />
      <span class="brand__name" aria-hidden="true">
        {PRACTICE.legalName}
      </span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        nav.map((n) =>
          n.mega && serviceNav ? (
            <div class="nav__mega" data-mega>
              <button
                class="nav__link nav__trigger"
                type="button"
                aria-expanded="false"
                aria-controls="mega-services"
                data-mega-trigger
              >
                {n.label}
                <svg
                  class="nav__chev"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="m6 9 6 6 6-6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="mega" id="mega-services" data-mega-panel>
                <div class="mega__inner">
                  <a class="mega__feat" href={serviceNav.featured.href}>
                    <span class="mega__feat-h">{serviceNav.featured.heading}</span>
                    <span class="mega__feat-blurb">{serviceNav.featured.blurb}</span>
                    <span class="mega__feat-list">
                      {serviceNav.featured.items.map((it) => (
                        <span class="mega__feat-item">{it.label}</span>
                      ))}
                    </span>
                    <span class="mega__feat-cta">Explore employer sponsorship →</span>
                  </a>
                  <div class="mega__cols">
                    {serviceNav.columns.map((col) => (
                      <div class="mega__col">
                        <p class="mega__col-h">{col.heading}</p>
                        <ul class="mega__col-list">
                          {col.items.map((it) => (
                            <li>
                              <a href={it.href}>{it.label}</a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="mega__foot">
                  <a class="mega__foot-all" href={serviceNav.seeAllHref}>
                    See all services →
                  </a>
                  <a class="mega__foot-hc" href="/#start">
                    Not sure where you fit? Start the free assessment →
                  </a>
                </div>
              </div>
            </div>
          ) : n.about ? (
            <div class="nav__mega nav__mega--compact" data-mega>
              <button
                class="nav__link nav__trigger"
                type="button"
                aria-expanded="false"
                aria-controls="mega-about"
                data-mega-trigger
              >
                {n.label}
                <svg
                  class="nav__chev"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="m6 9 6 6 6-6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="mega mega--compact" id="mega-about" data-mega-panel>
                <div class="mega__about">
                  <p class="mega__about-eyebrow">About</p>
                  <p class="mega__about-intro">{aboutNav.intro}</p>
                  <ul class="mega__about-list">
                    {aboutNav.items.map((it) => (
                      <li>
                        <a href={it.href}>
                          <span class="mega__about-ico" aria-hidden="true">
                            <svg
                              width="18"
                              height="18"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="1.7"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            >
                              <path d={it.icon} />
                            </svg>
                          </span>
                          <span class="mega__about-txt">
                            <b>{it.title}</b>
                            <small>{it.desc}</small>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                  <a class="mega__about-more" href={aboutNav.moreHref}>
                    Learn more →
                  </a>
                </div>
              </div>
            </div>
          ) : n.resources ? (
            <div class="nav__mega nav__mega--compact" data-mega>
              <button
                class="nav__link nav__trigger"
                type="button"
                aria-expanded="false"
                aria-controls="mega-resources"
                data-mega-trigger
              >
                {n.label}
                <svg
                  class="nav__chev"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="m6 9 6 6 6-6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="mega mega--compact mega--resources" id="mega-resources" data-mega-panel>
                <div class="res">
                  <div class="res__cols">
                    {resourcesNav.groups.map((g) => (
                      <div class="res__group">
                        <p class="res__heading">{g.heading}</p>
                        <ul class="res__list">
                          {g.items.map((it) =>
                            it.external ? (
                              <li>
                                <a
                                  href={it.href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  aria-label={`${it.title} (opens in a new tab)`}
                                >
                                  <span>{it.title}</span>
                                  <Fragment set:html={extIcon} />
                                </a>
                              </li>
                            ) : (
                              <li>
                                <a href={it.href}>
                                  <span>{it.title}</span>
                                </a>
                              </li>
                            ),
                          )}
                        </ul>
                      </div>
                    ))}
                  </div>
                  <p class="res__note">{resourcesNav.note}</p>
                </div>
              </div>
            </div>
          ) : (
            <a class="nav__link" href={n.href}>
              {n.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="header__cta">
      <Button variant="primary" href={bookUrl}>Book a Consultation</Button>
      <ClientPortalButton variant="desktop" />
    </div>
    <button
      class="burger"
      data-burger
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"
        ><path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path></svg
      >
    </button>
  </div>
  <div class="mnav" id="mobile-nav" data-mobile-nav hidden>
    {
      nav.map((n) =>
        n.mega && serviceNav ? (
          <details class="mnav__services">
            <summary>{n.label}</summary>
            <div class="mnav__sub">
              <a class="mnav__feat" href={serviceNav.featured.href}>
                {serviceNav.featured.heading}
              </a>
              {serviceNav.featured.items.map((it) => (
                <a href={it.href}>{it.label}</a>
              ))}
              {serviceNav.columns.map((col) => (
                <>
                  <p class="mnav__group-h">{col.heading}</p>
                  {col.items.map((it) => (
                    <a href={it.href}>{it.label}</a>
                  ))}
                </>
              ))}
              <a class="mnav__all" href={serviceNav.seeAllHref}>
                See all services →
              </a>
            </div>
          </details>
        ) : n.about ? (
          <details class="mnav__services">
            <summary>{n.label}</summary>
            <div class="mnav__sub">
              {aboutNav.items.map((it) => (
                <a href={it.href}>{it.title}</a>
              ))}
              <a class="mnav__all" href={aboutNav.moreHref}>
                Learn more →
              </a>
            </div>
          </details>
        ) : n.resources ? (
          <details class="mnav__services">
            <summary>{n.label}</summary>
            <div class="mnav__sub">
              {resourcesNav.groups.map((g) => (
                <>
                  <p class="mnav__group-h">{g.heading}</p>
                  {g.items.map((it) =>
                    it.external ? (
                      <a
                        href={it.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${it.title} (opens in a new tab)`}
                        class="mnav__ext"
                      >
                        {it.title}
                        <Fragment set:html={extIcon} />
                      </a>
                    ) : (
                      <a href={it.href}>{it.title}</a>
                    ),
                  )}
                </>
              ))}
              <p class="mnav__note">{resourcesNav.note}</p>
            </div>
          </details>
        ) : (
          <a href={n.href}>{n.label}</a>
        ),
      )
    }
    <div class="mnav__cta">
      <Button variant="primary" href={bookUrl}>Book a Consultation</Button>
      <ClientPortalButton variant="mobile" />
    </div>
  </div>
</header>
<style>
  .utility {
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
  }
  .utility__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--type-caption);
  }
  .utility a {
    color: inherit;
    text-decoration: none;
  }
  .utility__left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-inline-size: 0;
  }
  .utility__item {
    white-space: nowrap;
    transition: color var(--motion-base, 150ms) var(--ease-standard, ease);
  }
  .utility__item:hover,
  .utility__item:focus-visible {
    color: var(--color-emphasis);
  }
  .utility__marn {
    display: none;
    color: color-mix(in srgb, var(--color-text-inverse) 80%, transparent);
  }
  .utility__verify {
    display: none;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* Higher specificity than `.utility a { color: inherit }` so the verify link
     carries the gold accent (reads as an action, not plain text). */
  .utility a.utility__verify {
    color: var(--color-emphasis);
    text-decoration-color: color-mix(in srgb, var(--color-emphasis) 55%, transparent);
  }
  .utility a.utility__verify:hover,
  .utility a.utility__verify:focus-visible {
    text-decoration-color: var(--color-emphasis);
  }
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: var(--color-ground-light);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
  }
  .header__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    margin-inline-end: auto;
  }
  /* Official VMD logo (self-contained navy badge, transparent PNG). Sized to the
     original mark's footprint so there's no layout shift; served from a 1024px
     source so it stays crisp on HiDPI/Retina. */
  /* Primary brand mark — sized to read as a clear logo, not a tiny icon. Square
     aspect kept (object-fit: contain, equal dimensions) so it never distorts;
     slightly smaller on mobile so the sticky header stays compact. */
  .brand__mark {
    inline-size: 3.75rem;
    block-size: 3.75rem;
    object-fit: contain;
    display: block;
    flex: none;
  }
  @media (min-width: 1120px) {
    .brand__mark {
      inline-size: 4rem;
      block-size: 4rem;
    }
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--color-action);
    line-height: 1;
    display: flex;
    flex-direction: column;
  }
  .nav {
    display: none;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: nowrap;
  }
  .nav__link {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body);
    padding-block: var(--space-1);
    border-block-end: 1px solid transparent;
    white-space: nowrap;
  }
  .nav__link:hover {
    border-block-end-color: var(--color-emphasis);
  }

  /* ---- Our Services mega-menu (desktop) ------------------------------------ */
  .nav__mega {
    display: flex;
    align-items: center;
  }
  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    border-block-end: 1px solid transparent;
    font: inherit;
    color: var(--color-action);
    cursor: pointer;
  }
  .nav__chev {
    transition: transform var(--motion-base, 180ms) var(--ease-standard, ease);
  }
  .nav__mega:hover .nav__chev,
  .nav__mega:focus-within .nav__chev,
  .nav__trigger[aria-expanded='true'] .nav__chev {
    transform: rotate(180deg);
  }
  .mega {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    background: var(--color-ground-light);
    border-block: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    box-shadow: var(--shadow-raised, 0 18px 40px -24px rgba(14, 26, 48, 0.4));
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity var(--motion-base, 180ms) var(--ease-standard, ease),
      transform var(--motion-base, 180ms) var(--ease-standard, ease);
  }
  .nav__mega:hover .mega,
  .nav__mega:focus-within .mega,
  .mega[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }
  .mega__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-6) var(--space-4);
    display: grid;
    /* Give the four service columns more width (and the featured panel a little less)
       so a longer heading like "Student & Graduate Visa" fits on one line and reads as
       a single clear section rather than wrapping to two. */
    grid-template-columns: minmax(13rem, 0.85fr) 3.5fr;
    gap: var(--space-7);
  }
  .mega__feat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: linear-gradient(155deg, var(--color-action), var(--color-ground-deep));
    color: var(--color-text-inverse);
    text-decoration: none;
  }
  .mega__tag {
    align-self: flex-start;
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis);
    font-weight: 700;
  }
  .mega__feat-h {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: 1.15;
  }
  .mega__feat-blurb {
    font-size: var(--type-body-sm);
    color: color-mix(in srgb, var(--color-text-inverse) 82%, transparent);
    line-height: 1.5;
  }
  .mega__feat-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }
  .mega__feat-item {
    font-size: var(--type-caption);
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill, 999px);
    background: color-mix(in srgb, var(--color-text-inverse) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text-inverse) 22%, transparent);
  }
  .mega__feat-cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
    font-weight: 600;
    color: var(--color-emphasis);
  }
  .mega__feat:hover .mega__feat-cta {
    text-decoration: underline;
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-5);
    align-content: start;
  }
  .mega__col-h {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    /* Reserve two lines for every column heading so a longer name (e.g. "Student &
       Graduate Visa") that wraps stays aligned with the single-line headings beside
       it — the text sits on its underline and each column's links start on one line. */
    min-block-size: calc(3.2em + var(--space-2) + 1px);
    display: flex;
    align-items: flex-end;
    text-wrap: balance;
  }
  .mega__col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .mega__col-list a {
    display: block;
    padding: 0.3rem 0;
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body-sm);
    border-radius: var(--radius-control);
  }
  .mega__col-list a:hover {
    color: var(--color-emphasis-text);
  }
  .mega__foot {
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: center;
    justify-content: space-between;
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
  }
  .mega__foot-all {
    font-weight: 600;
    color: var(--color-emphasis-text);
    text-decoration: none;
  }
  .mega__foot-hc {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--type-body-sm);
  }
  .mega__foot a:hover {
    text-decoration: underline;
  }

  /* ---- About: a compact, self-describing panel --------------------------- */
  .nav__mega--compact {
    position: relative;
  }
  .mega--compact {
    inset-inline: auto;
    inset-inline-start: 0;
    inline-size: min(23rem, 88vw);
    border-inline: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
  }
  /* Resources: a curated hub — two grouped columns (Learning · Official Government
     Tools) with subtle headings and a footer note. Right-anchored (sits near the
     right of the bar). */
  .mega--resources {
    inline-size: min(38rem, 92vw);
    inset-inline-start: auto;
    inset-inline-end: 0;
  }
  .res {
    padding: var(--space-5);
  }
  .res__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-6);
  }
  .res__heading {
    margin: 0 0 var(--space-2);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-emphasis-text);
  }
  .res__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
  }
  .res__list a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    border-radius: var(--radius-control);
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body-sm);
    line-height: 1.3;
    transition:
      background-color 0.16s var(--ease-standard, ease),
      color 0.16s var(--ease-standard, ease);
  }
  .res__list a:hover {
    background: color-mix(in srgb, var(--color-action) 6%, transparent);
    color: var(--color-emphasis-text);
  }
  .res__list a:focus-visible {
    outline: 2px solid var(--color-action);
    outline-offset: -2px;
  }
  .res__ext {
    flex: none;
    color: var(--color-text-muted);
  }
  .res__list a:hover .res__ext {
    color: var(--color-emphasis-text);
  }
  .res__note {
    margin: var(--space-4) 0 0;
    padding-block-start: var(--space-3);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    font-size: var(--type-caption);
    color: var(--color-text-muted);
  }
  .mega__about {
    padding: var(--space-5);
  }
  .mega__about-eyebrow {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-emphasis-text);
    font-weight: 700;
    margin: 0;
  }
  .mega__about-intro {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    max-inline-size: 34ch;
  }
  .mega__about-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .mega__about-list a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    padding: var(--space-3);
    margin-inline: calc(var(--space-3) * -1);
    border-radius: var(--radius-control);
    text-decoration: none;
    color: var(--color-text);
    transition: background-color 0.16s var(--ease-standard, ease);
  }
  .mega__about-list a:hover {
    background: color-mix(in srgb, var(--color-action) 6%, transparent);
  }
  .mega__about-ico {
    display: grid;
    place-items: center;
    inline-size: 2.1rem;
    block-size: 2.1rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-emphasis) 14%, transparent);
    color: var(--color-emphasis-text);
  }
  .mega__about-txt {
    display: block;
    min-inline-size: 0;
  }
  .mega__about-txt b {
    display: block;
    font-weight: 600;
    color: var(--color-action);
    line-height: 1.2;
  }
  .mega__about-txt small {
    display: block;
    margin-block-start: 2px;
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .mega__about-more {
    display: block;
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    font-size: var(--type-body-sm);
    font-weight: 600;
    color: var(--color-emphasis-text);
    text-decoration: none;
  }
  .mega__about-more:hover {
    text-decoration: underline;
  }

  .header__cta {
    display: none;
    gap: var(--space-4);
    align-items: center;
  }
  .burger {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-action) 20%, transparent);
    border-radius: var(--radius-control);
    color: var(--color-action);
    cursor: pointer;
  }
  .mnav {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-5);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .mnav[data-open] {
    display: flex;
  }
  .mnav a {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body-lg);
    padding-block: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 6%, transparent);
  }
  .mnav__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }
  /* ---- Our Services group (mobile) ---------------------------------------- */
  .mnav__services > summary {
    list-style: none;
    cursor: pointer;
    color: var(--color-action);
    font-size: var(--type-body-lg);
    padding-block: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 6%, transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mnav__services > summary::-webkit-details-marker {
    display: none;
  }
  .mnav__services > summary::after {
    content: '+';
    font-size: 1.1em;
    color: var(--color-text-muted);
  }
  .mnav__services[open] > summary::after {
    content: '–';
  }
  .mnav__sub {
    display: flex;
    flex-direction: column;
    padding-inline-start: var(--space-3);
    margin-block-end: var(--space-2);
    border-inline-start: 2px solid color-mix(in srgb, var(--color-emphasis) 40%, transparent);
  }
  .mnav__sub a {
    font-size: var(--type-body);
    border-block-end: 0;
    padding-block: var(--space-1);
  }
  .mnav__feat {
    font-weight: 600;
    color: var(--color-emphasis-text) !important;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .mnav__feat-tag {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .mnav__group-h {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: var(--space-3) 0 var(--space-1);
  }
  .mnav__all {
    font-weight: 600;
    color: var(--color-emphasis-text) !important;
    margin-block-start: var(--space-2);
  }
  .mnav__ext {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .mnav__ext .res__ext {
    color: var(--color-text-muted);
  }
  .mnav__note {
    margin: var(--space-3) 0 0;
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  /* The header packs brand + full nav + three CTAs, so the horizontal layout only
     appears once there is comfortable room (~1120px). Below that the burger menu —
     which carries the same nav and CTAs — takes over, so items never wrap or overlap. */
  @media (min-width: 1120px) {
    .utility__marn,
    .utility__verify {
      display: inline;
    }
    .nav,
    .header__cta {
      display: flex;
    }
    .burger,
    .mnav {
      display: none !important;
    }
  }
</style>
<script>
  const burger = document.querySelector('[data-burger]');
  const panel = document.querySelector('[data-mobile-nav]');
  if (burger && panel) {
    const toggle = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        panel.hidden = false;
        panel.setAttribute('data-open', '');
      } else {
        panel.removeAttribute('data-open');
        panel.hidden = true;
      }
    };
    burger.addEventListener('click', () => toggle(burger.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }

  // Mega panels (Our Services + About): hover/focus reveal is pure CSS. This adds
  // click/tap toggling (touch has no hover), plus Escape and outside-click to close —
  // for every panel, and opening one closes the others.
  const setters = [];
  Array.prototype.slice.call(document.querySelectorAll('[data-mega]')).forEach((mega) => {
    const trigger = mega.querySelector('[data-mega-trigger]');
    const panel = mega.querySelector('[data-mega-panel]');
    if (!trigger || !panel) return;
    const setOpen = (open) => {
      trigger.setAttribute('aria-expanded', String(open));
      if (open) panel.setAttribute('data-open', '');
      else panel.removeAttribute('data-open');
    };
    setters.push({ mega, setOpen });
    trigger.addEventListener('click', () => {
      const willOpen = trigger.getAttribute('aria-expanded') !== 'true';
      setters.forEach((s) => s.mega !== mega && s.setOpen(false));
      setOpen(willOpen);
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setters.forEach((s) => s.setOpen(false));
  });
  document.addEventListener('click', (e) => {
    setters.forEach((s) => !s.mega.contains(e.target) && s.setOpen(false));
  });
</script>
