---
import { PRACTICE, RMA_LINE } from '@vmd/config';
import { Button } from '@vmd/ui';
import SocialLinks from './SocialLinks.astro';
import ClientPortalButton from './ClientPortalButton.astro';
import { cms, getCtaLinks } from '../../lib/cms.ts';
import { buildServiceNav } from '../../lib/serviceNav.ts';
import type { ServiceDoc } from '../../lib/servicePages.ts';
const { bookUrl } = await getCtaLinks();

// "Our Services" mega-menu is built from the live CMS service pages (nothing hardcoded);
// if the CMS is unreachable at build the item degrades to a plain link to /services/.
let serviceNav = null;
try {
  const docs = (await cms.servicePages()) as unknown as ServiceDoc[];
  if (Array.isArray(docs) && docs.length) serviceNav = buildServiceNav(docs);
} catch {
  /* no CMS at build — "Our Services" stays a simple link */
}

const nav = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Our Services', href: '/services/', mega: true },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
const register = PRACTICE.regulator.registerSearchUrl;
---

<a class="skip-link" href="#main">Skip to content</a>
<div class="utility">
  <div class="utility__inner">
    <div class="utility__left">
      <a class="utility__item" href={`tel:${PRACTICE.contact.phone}`}>
        {PRACTICE.contact.phoneDisplay}
      </a>
      <a class="utility__item utility__email" href={`mailto:${PRACTICE.contact.email}`}>
        {PRACTICE.contact.email}
      </a>
      <a
        class="utility__item utility__marn"
        href={register}
        rel="noopener noreferrer"
        target="_blank"
      >
        {RMA_LINE}
      </a>
    </div>
    <SocialLinks />
  </div>
</div>
<header class="header" data-header>
  <div class="header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">VMD</span>
      <span class="brand__name">{PRACTICE.legalName}</span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        nav.map((n) =>
          n.mega && serviceNav ? (
            <div class="nav__mega" data-mega>
              <button
                class="nav__link nav__trigger"
                type="button"
                aria-expanded="false"
                aria-controls="mega-services"
                data-mega-trigger
              >
                {n.label}
                <svg
                  class="nav__chev"
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="m6 9 6 6 6-6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </button>
              <div class="mega" id="mega-services" data-mega-panel>
                <div class="mega__inner">
                  <a class="mega__feat" href={serviceNav.featured.href}>
                    <span class="mega__tag">{serviceNav.featured.tag}</span>
                    <span class="mega__feat-h">{serviceNav.featured.heading}</span>
                    <span class="mega__feat-blurb">{serviceNav.featured.blurb}</span>
                    <span class="mega__feat-list">
                      {serviceNav.featured.items.map((it) => (
                        <span class="mega__feat-item">{it.label}</span>
                      ))}
                    </span>
                    <span class="mega__feat-cta">Explore employer sponsorship →</span>
                  </a>
                  <div class="mega__cols">
                    {serviceNav.columns.map((col) => (
                      <div class="mega__col">
                        <p class="mega__col-h">{col.heading}</p>
                        <ul class="mega__col-list">
                          {col.items.map((it) => (
                            <li>
                              <a href={it.href}>{it.label}</a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="mega__foot">
                  <a class="mega__foot-all" href={serviceNav.seeAllHref}>
                    See all services →
                  </a>
                  <a class="mega__foot-hc" href="/#start">
                    Not sure where you fit? Start the free assessment →
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <a class="nav__link" href={n.href}>
              {n.label}
            </a>
          ),
        )
      }
    </nav>
    <div class="header__cta">
      <a class="header__search" href="/search/" aria-label="Search the site">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"
          ><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75"></circle><path
            d="m20 20-3.2-3.2"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"></path></svg
        >
      </a>
      <Button variant="primary" href={bookUrl}>Book a Consultation</Button>
      <ClientPortalButton variant="desktop" />
    </div>
    <button
      class="burger"
      data-burger
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"
        ><path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path></svg
      >
    </button>
  </div>
  <div class="mnav" id="mobile-nav" data-mobile-nav hidden>
    {
      nav.map((n) =>
        n.mega && serviceNav ? (
          <details class="mnav__services">
            <summary>{n.label}</summary>
            <div class="mnav__sub">
              <a class="mnav__feat" href={serviceNav.featured.href}>
                <span class="mnav__feat-tag">{serviceNav.featured.tag}</span>
                {serviceNav.featured.heading}
              </a>
              {serviceNav.featured.items.map((it) => (
                <a href={it.href}>{it.label}</a>
              ))}
              {serviceNav.columns.map((col) => (
                <>
                  <p class="mnav__group-h">{col.heading}</p>
                  {col.items.map((it) => (
                    <a href={it.href}>{it.label}</a>
                  ))}
                </>
              ))}
              <a class="mnav__all" href={serviceNav.seeAllHref}>
                See all services →
              </a>
            </div>
          </details>
        ) : (
          <a href={n.href}>{n.label}</a>
        ),
      )
    }
    <a href="/search/">Search</a>
    <div class="mnav__cta">
      <Button variant="primary" href={bookUrl}>Book a Consultation</Button>
      <ClientPortalButton variant="mobile" />
    </div>
  </div>
</header>
<style>
  .utility {
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
  }
  .utility__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--type-caption);
  }
  .utility a {
    color: inherit;
    text-decoration: none;
  }
  .utility__left {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-inline-size: 0;
  }
  .utility__item {
    white-space: nowrap;
    transition: color var(--motion-base, 150ms) var(--ease-standard, ease);
  }
  .utility__item:hover,
  .utility__item:focus-visible {
    color: var(--color-emphasis);
  }
  .utility__email,
  .utility__marn {
    display: none;
    color: color-mix(in srgb, var(--color-text-inverse) 80%, transparent);
  }
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: var(--color-ground-light);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
  }
  .header__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    margin-inline-end: auto;
  }
  .brand__mark {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    background: var(--color-action);
    color: var(--color-text-inverse);
    border-radius: var(--radius-tile);
    font-weight: 800;
    letter-spacing: -0.06em;
    font-size: var(--type-caption);
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--color-action);
    line-height: 1;
    display: flex;
    flex-direction: column;
  }
  .brand__name small {
    font-family: var(--font-body);
    font-size: 0.5em;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-block-start: 3px;
  }
  .nav {
    display: none;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: nowrap;
  }
  .nav__link {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body);
    padding-block: var(--space-1);
    border-block-end: 1px solid transparent;
    white-space: nowrap;
  }
  .nav__link:hover {
    border-block-end-color: var(--color-emphasis);
  }

  /* ---- Our Services mega-menu (desktop) ------------------------------------ */
  .nav__mega {
    display: flex;
    align-items: center;
  }
  .nav__trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: none;
    border: 0;
    border-block-end: 1px solid transparent;
    font: inherit;
    color: var(--color-action);
    cursor: pointer;
  }
  .nav__chev {
    transition: transform var(--motion-base, 180ms) var(--ease-standard, ease);
  }
  .nav__mega:hover .nav__chev,
  .nav__mega:focus-within .nav__chev,
  .nav__trigger[aria-expanded='true'] .nav__chev {
    transform: rotate(180deg);
  }
  .mega {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    background: var(--color-ground-light);
    border-block: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    box-shadow: var(--shadow-raised, 0 18px 40px -24px rgba(14, 26, 48, 0.4));
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    pointer-events: none;
    transition:
      opacity var(--motion-base, 180ms) var(--ease-standard, ease),
      transform var(--motion-base, 180ms) var(--ease-standard, ease);
  }
  .nav__mega:hover .mega,
  .nav__mega:focus-within .mega,
  .mega[data-open] {
    opacity: 1;
    visibility: visible;
    transform: none;
    pointer-events: auto;
  }
  .mega__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-6) var(--space-4);
    display: grid;
    grid-template-columns: minmax(15rem, 1fr) 2.2fr;
    gap: var(--space-7);
  }
  .mega__feat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: linear-gradient(155deg, var(--color-action), var(--color-ground-deep));
    color: var(--color-text-inverse);
    text-decoration: none;
  }
  .mega__tag {
    align-self: flex-start;
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis);
    font-weight: 700;
  }
  .mega__feat-h {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: 1.15;
  }
  .mega__feat-blurb {
    font-size: var(--type-body-sm);
    color: color-mix(in srgb, var(--color-text-inverse) 82%, transparent);
    line-height: 1.5;
  }
  .mega__feat-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
  }
  .mega__feat-item {
    font-size: var(--type-caption);
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill, 999px);
    background: color-mix(in srgb, var(--color-text-inverse) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text-inverse) 22%, transparent);
  }
  .mega__feat-cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
    font-weight: 600;
    color: var(--color-emphasis);
  }
  .mega__feat:hover .mega__feat-cta {
    text-decoration: underline;
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    align-content: start;
  }
  .mega__col-h {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
  }
  .mega__col-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .mega__col-list a {
    display: block;
    padding: 0.3rem 0;
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body-sm);
    border-radius: var(--radius-control);
  }
  .mega__col-list a:hover {
    color: var(--color-emphasis-text);
  }
  .mega__foot {
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    align-items: center;
    justify-content: space-between;
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
  }
  .mega__foot-all {
    font-weight: 600;
    color: var(--color-emphasis-text);
    text-decoration: none;
  }
  .mega__foot-hc {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--type-body-sm);
  }
  .mega__foot a:hover {
    text-decoration: underline;
  }

  .header__cta {
    display: none;
    gap: var(--space-2);
    align-items: center;
  }
  .header__search {
    display: inline-grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--radius-control);
    color: var(--color-action);
    border: 1px solid color-mix(in srgb, var(--color-action) 20%, transparent);
    text-decoration: none;
    flex: 0 0 auto;
  }
  .header__search:hover {
    background: color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .header__search:focus-visible {
    outline: 3px solid var(--color-action);
    outline-offset: 2px;
  }
  .burger {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-action) 20%, transparent);
    border-radius: var(--radius-control);
    color: var(--color-action);
    cursor: pointer;
  }
  .mnav {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-5);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .mnav[data-open] {
    display: flex;
  }
  .mnav a {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body-lg);
    padding-block: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 6%, transparent);
  }
  .mnav__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }
  /* ---- Our Services group (mobile) ---------------------------------------- */
  .mnav__services > summary {
    list-style: none;
    cursor: pointer;
    color: var(--color-action);
    font-size: var(--type-body-lg);
    padding-block: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 6%, transparent);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mnav__services > summary::-webkit-details-marker {
    display: none;
  }
  .mnav__services > summary::after {
    content: '+';
    font-size: 1.1em;
    color: var(--color-text-muted);
  }
  .mnav__services[open] > summary::after {
    content: '–';
  }
  .mnav__sub {
    display: flex;
    flex-direction: column;
    padding-inline-start: var(--space-3);
    margin-block-end: var(--space-2);
    border-inline-start: 2px solid color-mix(in srgb, var(--color-emphasis) 40%, transparent);
  }
  .mnav__sub a {
    font-size: var(--type-body);
    border-block-end: 0;
    padding-block: var(--space-1);
  }
  .mnav__feat {
    font-weight: 600;
    color: var(--color-emphasis-text) !important;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .mnav__feat-tag {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    font-weight: 700;
  }
  .mnav__group-h {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: var(--space-3) 0 var(--space-1);
  }
  .mnav__all {
    font-weight: 600;
    color: var(--color-emphasis-text) !important;
    margin-block-start: var(--space-2);
  }
  @media (min-width: 640px) {
    .utility__email {
      display: inline;
    }
  }
  /* The header packs brand + full nav + three CTAs, so the horizontal layout only
     appears once there is comfortable room (~1120px). Below that the burger menu —
     which carries the same nav and CTAs — takes over, so items never wrap or overlap. */
  @media (min-width: 1120px) {
    .utility__marn {
      display: inline;
    }
    .nav,
    .header__cta {
      display: flex;
    }
    .burger,
    .mnav {
      display: none !important;
    }
  }
</style>
<script>
  const burger = document.querySelector('[data-burger]');
  const panel = document.querySelector('[data-mobile-nav]');
  if (burger && panel) {
    const toggle = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        panel.hidden = false;
        panel.setAttribute('data-open', '');
      } else {
        panel.removeAttribute('data-open');
        panel.hidden = true;
      }
    };
    burger.addEventListener('click', () => toggle(burger.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }

  // Our Services mega-menu: hover/focus reveal is pure CSS. This adds click/tap
  // toggling (touch devices have no hover) plus Escape and outside-click to close.
  const mega = document.querySelector('[data-mega]');
  const trigger = mega?.querySelector('[data-mega-trigger]');
  const megaPanel = mega?.querySelector('[data-mega-panel]');
  if (mega && trigger && megaPanel) {
    const setMega = (open) => {
      trigger.setAttribute('aria-expanded', String(open));
      if (open) megaPanel.setAttribute('data-open', '');
      else megaPanel.removeAttribute('data-open');
    };
    trigger.addEventListener('click', () => {
      setMega(trigger.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setMega(false);
        if (trigger instanceof HTMLElement) trigger.blur();
      }
    });
    document.addEventListener('click', (e) => {
      if (!mega.contains(e.target)) setMega(false);
    });
    // Close after choosing a destination so the panel doesn't linger over the new page.
    megaPanel
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', () => setMega(false)));
  }
</script>
