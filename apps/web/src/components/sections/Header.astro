---
import { PRACTICE } from '@vmd/config';
import { Button } from '@vmd/ui';
const nav = [
  { label: 'About', href: '/about/' },
  { label: 'Visa Services', href: '/visa-services/' },
  { label: 'Your Situation', href: '/your-situation/' },
  { label: 'Results', href: '/results/' },
  { label: 'Resources', href: '/resources/' },
  { label: 'Contact', href: '/contact/' },
];
const register = PRACTICE.regulator.registerSearchUrl;
---

<a class="skip-link" href="#main">Skip to content</a>
<div class="utility">
  <div class="utility__inner">
    <a class="utility__marn" href={register} rel="noopener" target="_blank"
      >MARN {PRACTICE.principal.marn} · verify on the OMARA register</a
    >
    <span class="utility__meta"
      >{PRACTICE.address.street}, {PRACTICE.address.locality} · {PRACTICE.hoursNote}</span
    >
    <a class="utility__phone" href={`tel:${PRACTICE.contact.phone}`}
      >{PRACTICE.contact.phoneDisplay}</a
    >
  </div>
</div>
<header class="header" data-header>
  <div class="header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">VMD</span>
      <span class="brand__name">{PRACTICE.legalName}<small>{PRACTICE.descriptor}</small></span>
    </a>
    <nav class="nav" aria-label="Primary">
      {
        nav.map((n) => (
          <a class="nav__link" href={n.href}>
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="header__cta">
      <Button variant="secondary" href="/book/">Book</Button>
      <Button variant="primary" href="/health-check/">Free Health Check</Button>
    </div>
    <button
      class="burger"
      data-burger
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"
        ><path
          d="M4 7h16M4 12h16M4 17h16"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path></svg
      >
    </button>
  </div>
  <div class="mnav" id="mobile-nav" data-mobile-nav hidden>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <div class="mnav__cta">
      <Button variant="secondary" href="/book/">Book a consultation</Button>
      <Button variant="primary" href="/health-check/">Free Health Check</Button>
    </div>
  </div>
</header>
<style>
  .utility {
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
  }
  .utility__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-2) var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    font-size: var(--type-caption);
  }
  .utility a {
    color: inherit;
    text-decoration: none;
  }
  .utility__marn {
    border-block-end: 1px solid var(--color-emphasis);
  }
  .utility__meta {
    color: color-mix(in srgb, var(--color-text-inverse) 78%, transparent);
    display: none;
  }
  .utility__phone {
    font-weight: 500;
  }
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: var(--color-ground-light);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
  }
  .header__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    margin-inline-end: auto;
  }
  .brand__mark {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    background: var(--color-action);
    color: var(--color-text-inverse);
    border-radius: var(--radius-tile);
    font-weight: 800;
    letter-spacing: -0.06em;
    font-size: var(--type-caption);
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--color-action);
    line-height: 1;
    display: flex;
    flex-direction: column;
  }
  .brand__name small {
    font-family: var(--font-body);
    font-size: 0.5em;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-block-start: 3px;
  }
  .nav {
    display: none;
    gap: var(--space-4);
  }
  .nav__link {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body);
    padding-block: var(--space-1);
    border-block-end: 1px solid transparent;
  }
  .nav__link:hover {
    border-block-end-color: var(--color-emphasis);
  }
  .header__cta {
    display: none;
    gap: var(--space-2);
  }
  .burger {
    display: inline-grid;
    place-items: center;
    inline-size: var(--space-6);
    block-size: var(--space-6);
    background: none;
    border: 1px solid color-mix(in srgb, var(--color-action) 20%, transparent);
    border-radius: var(--radius-control);
    color: var(--color-action);
    cursor: pointer;
  }
  .mnav {
    display: none;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-5);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .mnav[data-open] {
    display: flex;
  }
  .mnav a {
    color: var(--color-action);
    text-decoration: none;
    font-size: var(--type-body-lg);
    padding-block: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 6%, transparent);
  }
  .mnav__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }
  @media (min-width: 1024px) {
    .utility__meta {
      display: inline;
    }
    .nav,
    .header__cta {
      display: flex;
    }
    .burger,
    .mnav {
      display: none !important;
    }
  }
</style>
<script>
  const burger = document.querySelector('[data-burger]');
  const panel = document.querySelector('[data-mobile-nav]');
  if (burger && panel) {
    const toggle = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      if (open) {
        panel.hidden = false;
        panel.setAttribute('data-open', '');
      } else {
        panel.removeAttribute('data-open');
        panel.hidden = true;
      }
    };
    burger.addEventListener('click', () => toggle(burger.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') toggle(false);
    });
  }
</script>
