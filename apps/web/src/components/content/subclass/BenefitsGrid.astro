---
interface Props { benefits?: any }
const { benefits = {} } = Astro.props;
const icons: Record<string, string> = {
  permanentResidency: '<path d="M4 11l8-6 8 6M6 10v9h12v-9" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  familyInclusion: '<circle cx="8" cy="8" r="2.4" stroke="currentColor" stroke-width="1.6"/><circle cx="16" cy="8" r="2.4" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 19c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4M12.5 19c.4-2.2 2-3.4 4-3.4 2.2 0 3.9 1.4 4 3.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  workRights: '<rect x="4" y="8" width="16" height="11" rx="1.5" stroke="currentColor" stroke-width="1.6"/><path d="M9 8V6a2 2 0 012-2h2a2 2 0 012 2v2" stroke="currentColor" stroke-width="1.6"/>',
  studyRights: '<path d="M12 5l9 4-9 4-9-4 9-4zM6 11v4c0 1.5 2.7 3 6 3s6-1.5 6-3v-4" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
  medicare: '<path d="M12 20s-7-4.3-7-9a4 4 0 017-2.6A4 4 0 0119 11c0 4.7-7 9-7 9z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9.5 11h5M12 8.5v5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
  travelRights: '<path d="M4 13l16-6-6 16-2.5-6L4 13z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
};
const labels: Record<string, string> = {
  permanentResidency: 'Permanent residency pathway', familyInclusion: 'Include your family',
  workRights: 'Full work rights', studyRights: 'Study rights', medicare: 'Medicare eligibility', travelRights: 'Travel rights',
};
const active = Object.keys(labels).filter((k) => benefits[k]);
const custom = benefits.custom ?? [];
---
{(active.length > 0 || custom.length > 0) && (
  <ul class="bg">
    {active.map((k) => (
      <li class="bg__card">
        <span class="bg__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" set:html={icons[k]} /></span>
        <span class="bg__label">{labels[k]}</span>
      </li>
    ))}
    {custom.map((c: any) => (
      <li class="bg__card"><span class="bg__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span class="bg__label">{c.title}{c.detail && <small>{c.detail}</small>}</span></li>
    ))}
  </ul>
)}
<style>
  .bg { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); grid-template-columns: 1fr; }
  .bg__card { display: flex; gap: var(--space-3); align-items: center; padding: var(--space-4); border: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent); border-radius: var(--radius-card); }
  .bg__icon { flex: none; color: var(--color-action); }
  .bg__label { font-weight: 500; display: flex; flex-direction: column; }
  .bg__label small { font-weight: 400; font-size: var(--type-body-sm); color: var(--color-text-muted); }
  @media (min-width: 600px) { .bg { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .bg { grid-template-columns: repeat(3, 1fr); } }
</style>
