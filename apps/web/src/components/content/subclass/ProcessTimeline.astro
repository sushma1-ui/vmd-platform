---
interface Props { steps?: any[] }
const { steps = [] } = Astro.props;
---
{steps.length > 0 && (
  <ol class="tl">
    {steps.map((s: any, i: number) => (
      <li class="tl__step">
        <div class="tl__marker" aria-hidden="true">{i + 1}</div>
        <div class="tl__body">
          <div class="tl__head"><h3 class="tl__title">{s.stepTitle}</h3>{s.estimatedDuration && <span class="tl__dur">{s.estimatedDuration}</span>}</div>
          {s.description && <p class="tl__desc">{s.description}</p>}
          {s.documents?.length > 0 && (
            <details class="tl__docs">
              <summary>Documents at this stage</summary>
              <ul>{s.documents.map((d: any) => <li>{d.doc}</li>)}</ul>
            </details>
          )}
        </div>
      </li>
    ))}
  </ol>
)}
<style>
  .tl { list-style: none; padding: 0; margin: 0; }
  .tl__step { position: relative; display: grid; grid-template-columns: var(--space-6) 1fr; gap: var(--space-4); padding-block-end: var(--space-5); }
  .tl__step:not(:last-child)::before { content: ''; position: absolute; inset-block: var(--space-6) 0; inset-inline-start: calc(var(--space-6) / 2); inline-size: 2px; background: color-mix(in srgb, var(--color-emphasis) 40%, transparent); }
  .tl__marker { inline-size: var(--space-6); block-size: var(--space-6); border-radius: var(--radius-chip); background: var(--color-action); color: var(--color-text-inverse); display: grid; place-items: center; font-weight: 500; position: relative; z-index: 1; }
  .tl__head { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: baseline; }
  .tl__title { font-size: var(--type-h4); margin: 0; color: var(--color-action); font-family: var(--font-display); }
  .tl__dur { font-size: var(--type-caption); color: var(--color-text-muted); border: 1px solid color-mix(in srgb, var(--color-emphasis) 45%, transparent); border-radius: var(--radius-chip); padding: 0 var(--space-2); }
  .tl__desc { margin-block: var(--space-2); line-height: 1.6; }
  .tl__docs summary { cursor: pointer; font-size: var(--type-body-sm); color: var(--color-action); }
  .tl__docs ul { margin-block: var(--space-2); padding-inline-start: var(--space-4); line-height: 1.8; font-size: var(--type-body-sm); }
</style>
