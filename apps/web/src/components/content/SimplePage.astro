---
import Base from '../../layouts/Base.astro';
import { breadcrumbSchema } from '@vmd/seo';
import { pathnameToTrail } from '../../lib/breadcrumbs.ts';
import { Disclaimer } from '@vmd/ui';
import LastReviewed from './LastReviewed.astro';

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
  lead?: string;
  cta?: { href: string; label: string };
  emptyState?: string;
  disclaimer?: boolean;
}
const { title, description, eyebrow, lead, cta, emptyState, disclaimer } = Astro.props;
const trail = pathnameToTrail(Astro.url.pathname);
---

<Base title={title} description={description} schemas={[breadcrumbSchema(trail)]}>
  <article class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      {
        trail.map((t, i) => (
          <span>
            {i > 0 && <span aria-hidden="true"> / </span>}
            <a href={t.path}>{t.name}</a>
          </span>
        ))
      }
    </nav>
    {eyebrow && <p class="page__eyebrow">{eyebrow}</p>}
    <h1 class="page__title">{title}</h1>
    {lead && <p class="page__lead">{lead}</p>}
    <div class="page__body"><slot /></div>
    {emptyState && <div class="page__empty">{emptyState}</div>}
    {disclaimer && <Disclaimer variant="generalInformation" />}
    {
      cta && (
        <p class="page__cta">
          <a href={cta.href}>{cta.label} →</a>
        </p>
      )
    }
    <LastReviewed />
  </article>
</Base>
<style>
  .page {
    max-inline-size: var(--container-prose);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4) var(--space-9);
  }
  .crumbs {
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    border-block-end: 1px solid var(--color-emphasis);
  }
  .page__eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .page__title {
    font-size: var(--type-display-2);
    margin-block: var(--space-2) var(--space-4);
  }
  .page__lead {
    font-size: var(--type-body-lg);
    line-height: 1.5;
    margin-block-end: var(--space-4);
  }
  .page__body {
    font-size: var(--type-body);
    line-height: 1.7;
  }
  .page__body :global(p) {
    margin-block-end: var(--space-3);
  }
  .page__empty {
    border: 1px dashed color-mix(in srgb, var(--color-emphasis) 55%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    color: var(--color-text-muted);
    margin-block: var(--space-4);
  }
  .page__cta {
    margin-block-start: var(--space-5);
  }
  .page__cta a {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
    font-size: var(--type-body-lg);
  }
</style>
