---
import SimplePage from '../../components/content/SimplePage.astro';
import { PRACTICE } from '@vmd/config';
import { cms, getAboutPage, type TeamMember, type TermItem } from '../../lib/cms.ts';

// CMS-editable About copy, falling back to the built-in text if the global is empty.
const a = await getAboutPage();
const bodyParas = (a?.body ?? []).map((p) => p?.text).filter((t): t is string => !!t);

// Map a CMS term/description list to [term, description] pairs, or return the
// built-in fallback if the CMS didn't supply any — so the page renders the same
// approved copy whether or not the CMS is reachable.
const pairsFrom = (items: TermItem[] | null | undefined, fallback: [string, string][]) => {
  const pairs = (items ?? [])
    .map((i): [string, string] => [i?.term ?? '', i?.description ?? ''])
    .filter(([t, d]) => t || d);
  return pairs.length ? pairs : fallback;
};

// "Our story" — the clinical method (Diagnosis → Pathway → Outcome).
const DISCIPLINES_FALLBACK: [string, string][] = [
  [
    'Diagnosis.',
    'A thorough assessment of your circumstances — history, eligibility, risks — before anything is recommended, lodged or promised.',
  ],
  [
    'Pathway.',
    'A clear written strategy tailored to your situation and goals: your realistic options, with the trade-offs explained in plain language.',
  ],
  [
    'Outcome.',
    'Careful preparation and guidance throughout the application process, with you informed at every stage.',
  ],
];

// "What we believe"
const BELIEFS_FALLBACK: [string, string][] = [
  [
    'Integrity.',
    'Honest advice, even when the honest answer is to wait or to pursue a different pathway.',
  ],
  [
    'Professional competence.',
    'Recommendations grounded in current law, policy and evidence, and tailored to your circumstances.',
  ],
  [
    'Client-centred service.',
    'Clear communication, regular updates and support at every stage of the process.',
  ],
  [
    'Independence.',
    'Professional judgement is exercised independently and is not directed by any referral or commercial arrangement.',
  ],
];

// "Care. Clarity. Consistency." — the practice's core value (Corporate Profile).
const CORE_VALUE_FALLBACK: [string, string][] = [
  [
    'Care.',
    'Every matter is received with attention to the person behind it — including honest advice when the honest answer is to wait.',
  ],
  [
    'Clarity.',
    'Advice in plain language, a written strategy for every engagement, and transparent scope and fees from the outset.',
  ],
  [
    'Consistency.',
    'Documented processes and careful record-keeping, so every matter is handled to the same professional standard.',
  ],
];

// Prefer the CMS-managed lists; fall back to the built-in approved copy.
// (Why VMD now lives on its own page, /about/why-vmd/.)
const disciplines = pairsFrom(a?.method, DISCIPLINES_FALLBACK);
const coreValue = pairsFrom(a?.coreValue, CORE_VALUE_FALLBACK);
const beliefs = pairsFrom(a?.beliefs, BELIEFS_FALLBACK);

// Practice activity (Corporate Profile, as at 3 August 2026). These describe the
// VOLUME and BREADTH of work prepared and managed — not outcomes. The disclaimer
// below is mandatory and must remain with the figures.
const ACTIVITY = {
  total: '1,653',
  period: '19 September 2023 – 3 August 2026',
  breakdown: [
    ['1,070', 'Visa applications'],
    ['284', 'Expressions of Interest (SkillSelect) & related lodgements'],
    ['239', 'Skills assessment applications'],
    ['60', 'Administrative Review Tribunal matters'],
  ] as [string, string][],
};

// "Meet the team" — CMS-managed via the Team Members collection (Website Content →
// Team Members). Section heading/intro come from the About Page global. Falls back
// to the approved team copy if no members are published yet, so the section is
// never empty and reflects the currently adopted About content.
const teamHeading = a?.team?.heading || 'The people behind your matter';
const teamIntro =
  a?.team?.intro ||
  'When you engage Visa & Migration Doctors, you work directly with the people responsible for preparing and managing your matter.';
const cmsMembers = (await cms.teamMembers()).filter((m): m is TeamMember => !!m?.name);
const members: TeamMember[] = cmsMembers.length
  ? cmsMembers
  : [
      {
        name: PRACTICE.principal.name,
        position: 'Director | Registered Migration Agent',
        credential: `MARN ${PRACTICE.principal.marn}`,
        shortBio:
          'Sunil leads the practice and personally assesses every migration matter. With a background spanning education, migration, business and compliance, he provides practical, honest and tailored advice to clients building their future in Australia.',
        motto:
          'Good migration advice starts with an honest diagnosis — even when the honest answer is to wait.',
        photo: { url: '/team/sunil.jpg' },
      },
      {
        name: 'Sudeep Bartaula',
        position: 'Data & Compliance Officer',
        shortBio:
          'Sudeep supports the practice through document management, compliance processes and application coordination, working under the supervision of the Registered Migration Agent. He combines strong analytical skills with extensive client-service experience, helping keep each matter organised, accurate and on time.',
        motto: 'Clients and compliance.',
        photo: { url: '/team/sudeep.jpg' },
      },
    ];
// Normalise new (position/shortBio/expertise) and legacy (role/bio/specialisations)
// field names so the current card design keeps working with either data source.
const roleOf = (m: TeamMember) => m.position || m.role || '';
const bioOf = (m: TeamMember) => m.shortBio || m.bio || '';
const mottoOf = (m: TeamMember) => m.motto || '';
const specOf = (m: TeamMember) =>
  m.specialisations ||
  (m.expertise ?? [])
    .map((e) => e?.item)
    .filter(Boolean)
    .join(' · ') ||
  '';
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
const photoUrl = (m: TeamMember): string | null =>
  (m.photo && typeof m.photo === 'object' ? m.photo.url : null) || null;
---

<SimplePage
  title={a?.title || 'A migration practice built like a consulting room'}
  description={a?.seo?.metaDescription ||
    'A boutique, appointment-only migration practice in Perth, led by a Registered Migration Agent.'}
  eyebrow={a?.eyebrow || 'The practice'}
  lead={a?.lead ||
    "Visa & Migration Doctors is a boutique, appointment-only migration practice in Perth, Western Australia, led personally by Sunil Uprety, Registered Migration Agent (MARN 2318234). We assist individuals, couples, families, students, skilled workers and employers to navigate Australia's migration system with clarity."}
  cta={{
    href: a?.ctaHref || '/about/sunil-uprety/',
    label: a?.ctaLabel || 'Meet Sunil Uprety, RMA',
  }}
  disclaimer={true}
>
  {
    bodyParas.length > 0 ? (
      bodyParas.map((t) => <p>{t}</p>)
    ) : (
      <>
        <p>
          We work by appointment, deliberately. Every matter receives considered attention. Before
          any pathway is recommended, we take the time to understand your circumstances in full, and
          every matter is assessed on its individual merits against current migration law, policy
          and professional standards.
        </p>
        <p>
          The name is a method, not a metaphor. A good doctor doesn't prescribe before examining,
          and we don't recommend a visa pathway before understanding your situation. Every
          engagement follows the same discipline:
        </p>
      </>
    )
  }
  <div class="deflist">
    {
      disciplines.map(([term, desc]) => (
        <p>
          <strong>{term}</strong> {desc}
        </p>
      ))
    }
  </div>

  <figure class="story-photo">
    <img
      src="/our-story.webp"
      width="1200"
      height="800"
      alt="A team working together around a table with laptops, notebooks and shared notes"
      loading="lazy"
      decoding="async"
    />
  </figure>

  <section class="about-section" aria-label="Our core value">
    <p class="about-section__eyebrow">Our core value</p>
    <h2 class="about-section__h about-section__h--tight">Care. Clarity. Consistency.</h2>
    <div class="deflist">
      {
        coreValue.map(([term, desc]) => (
          <p>
            <strong>{term}</strong> {desc}
          </p>
        ))
      }
    </div>
  </section>

  <section class="about-section" aria-label="What we believe">
    <h2 class="about-section__h">What we believe</h2>
    <div class="deflist">
      {
        beliefs.map(([term, desc]) => (
          <p>
            <strong>{term}</strong> {desc}
          </p>
        ))
      }
    </div>
  </section>

  <section class="about-section" aria-label="Experience">
    <h2 class="about-section__h">A new brand. An established practitioner.</h2>
    <p>
      Visa &amp; Migration Doctors is a young brand built on an established professional record.
      Immigration assistance at the practice is provided by its Principal, Sunil Uprety, who has
      practised as a Registered Migration Agent since 19 September 2023.
    </p>
    <p>
      Since registration, Sunil has prepared and managed the following volume of applications and
      lodgements across skilled, family, student, graduate and review matters:
    </p>
    <div class="stats">
      <div class="stats__lead">
        <span class="stats__num">{ACTIVITY.total}</span>
        <span class="stats__caption">applications and lodgements prepared and managed</span>
        <span class="stats__period">{ACTIVITY.period}</span>
      </div>
      <dl class="stats__grid">
        {
          ACTIVITY.breakdown.map(([n, label]) => (
            <div class="stats__item">
              <dt class="stats__item-num">{n}</dt>
              <dd class="stats__item-label">{label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <p class="stats__note">
      Figures are drawn from the practitioner's activity records as at 3 August 2026 and record
      applications and lodgements prepared and managed. They describe the volume and breadth of work
      undertaken; they are not statements about outcomes, and no outcome can be guaranteed.
    </p>
    <p>
      Behind the practitioner sits a deliberately built practice: matter management on dedicated
      practice software, documented processes for every stage of a matter, structured compliance and
      document control, and administrative support that keeps each file organised, accurate and on
      time.
    </p>
  </section>

  <section class="team" id="team" aria-label={teamHeading} style="scroll-margin-top: 6rem">
    <h2 class="team__h">{teamHeading}</h2>
    {teamIntro && <p class="team__intro">{teamIntro}</p>}
    <ul class="team__list" role="list">
      {
        members.map((m) => (
          <li class="tm">
            <div class="tm__avatar">
              {photoUrl(m) ? (
                <img src={photoUrl(m)} alt={m.name ?? ''} loading="lazy" />
              ) : (
                <span class="tm__mono" aria-hidden="true">
                  {initials(m.name ?? '')}
                </span>
              )}
            </div>
            <div class="tm__text">
              <p class="tm__name">
                {m.name}
                {m.credential && <span class="tm__cred"> · {m.credential}</span>}
              </p>
              {roleOf(m) && <p class="tm__role">{roleOf(m)}</p>}
              {specOf(m) && <p class="tm__spec">{specOf(m)}</p>}
              {bioOf(m) && <p class="tm__bio">{bioOf(m)}</p>}
              {mottoOf(m) && <p class="tm__quote">“{mottoOf(m)}”</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</SimplePage>

<style>
  /* Our Story photo — a full-width visual break in the narrative. Fixed aspect
     ratio + width/height prevent layout shift; lazy-loaded (below the fold). */
  .story-photo {
    margin-block: var(--space-7);
  }
  .story-photo img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius-card, 14px);
    border: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    box-shadow: var(--shadow-subtle, 0 12px 32px -20px rgba(14, 26, 48, 0.42));
  }

  /* Content sections that sit below the story, each separated by the same thin
     divider the team section uses — keeps the page rhythm consistent. */
  .about-section {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
  }
  .about-section__h {
    font-size: var(--type-h2);
    margin: 0 0 var(--space-4);
  }
  .about-section__h--tight {
    margin-block-end: var(--space-4);
  }
  .about-section__eyebrow {
    margin: 0 0 var(--space-1);
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-emphasis-text);
  }
  /* Practice-activity figures — a restrained stats treatment (no charts). The
     lead figure is emphasised; the four-way breakdown sits in a simple grid. The
     accompanying note is mandatory and describes volume, never outcomes. */
  .stats {
    margin-block: var(--space-5);
    padding: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
    border-radius: var(--radius-card, 14px);
    background: var(--color-ground-warm);
  }
  .stats__lead {
    display: grid;
    gap: var(--space-1);
    padding-block-end: var(--space-4);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
  }
  .stats__num {
    font-family: var(--font-display);
    font-size: var(--type-display-2);
    line-height: 1;
    color: var(--color-action);
  }
  .stats__caption {
    font-size: var(--type-body);
    color: var(--color-text);
  }
  .stats__period {
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .stats__grid {
    margin: 0;
    margin-block-start: var(--space-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  .stats__item {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }
  .stats__item-num {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    color: var(--color-emphasis-text);
    min-inline-size: 3.5rem;
  }
  .stats__item-label {
    margin: 0;
    line-height: 1.5;
    color: var(--color-text);
  }
  .stats__note {
    font-size: var(--type-body-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  @media (min-width: 560px) {
    .stats__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  /* Definition-style blocks (bold lead-in term + description), reused by the
     "Diagnosis/Pathway/Outcome", "What we believe" and "Why VMD" lists. */
  .deflist {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }
  .deflist p {
    margin: 0;
    line-height: 1.7;
  }
  .deflist strong {
    color: var(--color-text);
  }
  .team {
    margin-block-start: var(--space-8);
    padding-block-start: var(--space-6);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
  }
  .team__h {
    font-size: var(--type-h2);
    margin: 0 0 var(--space-2);
  }
  .team__intro {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
  }
  .team__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }
  .tm {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .tm__avatar {
    flex: none;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--color-ground-warm);
    border: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
  }
  .tm__avatar img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .tm__mono {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    color: var(--color-action);
  }
  .tm__name {
    font-family: var(--font-display);
    font-size: var(--type-h3);
    margin: 0;
    color: var(--color-text);
  }
  .tm__cred {
    font-family: var(--font-body);
    font-size: var(--type-body-sm);
    font-weight: 600;
    color: var(--color-emphasis-text);
  }
  .tm__role {
    margin: 0.15rem 0 0;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .tm__spec {
    margin: 0.15rem 0 0;
    font-size: var(--type-body-sm);
    color: var(--color-emphasis-text);
  }
  .tm__bio {
    margin-block-start: var(--space-2);
    line-height: 1.6;
    color: var(--color-text);
  }
  .tm__quote {
    margin-block-start: var(--space-2);
    font-family: var(--font-display);
    font-style: italic;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
