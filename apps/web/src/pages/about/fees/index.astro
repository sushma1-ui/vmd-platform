---
import SimplePage from '../../../components/content/SimplePage.astro';
import { getCtaLinks } from '../../../lib/cms.ts';
const { bookUrl } = await getCtaLinks();
---

<SimplePage
  title="Our Fees"
  description="Published, fixed-fee ranges for Australian visa and migration services in Perth."
  eyebrow="Our fees"
  lead="We publish fees because the category hides them. Fixed ranges, quoted before you commit."
  cta={{ href: bookUrl, label: 'Book a Consultation' }}
>
  <p>
    The Visa Health Check is free. Consultations are a fixed fee, quoted clearly before you book.
    Each service is a fixed-fee engagement, with what's included set out upfront and disbursements
    itemised separately — so you always know the cost before you commit.
  </p>
</SimplePage>
