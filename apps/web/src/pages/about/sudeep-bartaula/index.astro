---
import SimplePage from '../../../components/content/SimplePage.astro';
import { getCtaLinks } from '../../../lib/cms.ts';
const { bookUrl } = await getCtaLinks();

const qualifications = [
  'Master of Business Analytics (current), The University of Western Australia',
  'Bachelor of Business Administration, Tribhuvan University',
];

const areasOfFocus = [
  'Application compliance',
  'Document management',
  'Data accuracy and privacy',
  'Client file integrity',
  'Process improvement',
  'Reporting and administration',
  'Deadline tracking',
];
---

<SimplePage
  title="Sudeep Bartaula, Data & Compliance Officer"
  description="Meet Sudeep Bartaula, Data & Compliance Officer at Visa & Migration Doctors — supporting documentation, compliance and application coordination under the supervision of the Registered Migration Agent."
  eyebrow="The team"
  lead="Data & Compliance Officer"
  cta={{ href: bookUrl, label: 'Book a Consultation' }}
  disclaimer={true}
>
  <figure class="pf__portrait">
    <img
      src="/team/sudeep-portrait.jpg"
      alt="Sudeep Bartaula, Data & Compliance Officer, at the Visa & Migration Doctors office"
      width="720"
      height="900"
      loading="eager"
      decoding="async"
    />
  </figure>

  <p>
    Sudeep Bartaula joined Visa &amp; Migration Doctors in February 2025 as Data &amp; Compliance
    Officer, supporting the practice's documentation, compliance and operational functions under the
    supervision of the Registered Migration Agent.
  </p>

  <p>
    Currently pursuing a Master of Business Analytics at The University of Western Australia, Sudeep
    combines analytical thinking with a strong client-service mindset. He holds a Bachelor of
    Business Administration from Shanker Dev Campus, Tribhuvan University, Nepal. Since 2021 he has
    worked in client-facing and operational roles, developing experience in stakeholder
    communication, process coordination, documentation management and service delivery.
  </p>

  <p>
    Before joining the migration industry, Sudeep worked as a Loan Processing Associate for an
    Australian mortgage brokerage and as a Vendor Correspondence Coordinator for a recovery audit
    firm. These roles strengthened his ability to manage complex documentation, maintain compliance
    standards and coordinate with clients and stakeholders.
  </p>

  <p>
    At Visa &amp; Migration Doctors, Sudeep helps keep applications organised, accurate and prepared
    in accordance with regulatory requirements.
  </p>

  <h2 class="pf__h">Qualifications</h2>
  <ul class="pf__list">
    {qualifications.map((item) => <li>{item}</li>)}
  </ul>

  <h2 class="pf__h">Areas of focus</h2>
  <ul class="pf__list">
    {areasOfFocus.map((item) => <li>{item}</li>)}
  </ul>

  <p>
    Outside work and study, Sudeep enjoys exploring developments in data analytics, business
    intelligence and emerging technologies.
  </p>

  <h2 class="pf__h">Direct contact</h2>
  <p class="pf__contact">
    <a href="tel:+61493719431">+61 493 719 431</a>
    <span class="pf__dot" aria-hidden="true">·</span>
    <a href="mailto:sudeep@migrationdoctors.com.au">sudeep@migrationdoctors.com.au</a>
  </p>

  <p class="pf__note">
    Sudeep does not provide immigration assistance. All immigration assistance at the practice is
    provided by the Registered Migration Agent.
  </p>
</SimplePage>

<style>
  /* Premium editorial portrait — framed, floated beside the intro on wider
     screens, full-width above it on mobile. Natural aspect ratio, no distortion. */
  .pf__portrait {
    margin: 0 0 var(--space-4);
    border-radius: var(--radius-card, 14px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-emphasis) 32%, transparent);
    box-shadow: var(--shadow-subtle, 0 12px 30px -16px rgba(20, 40, 77, 0.4));
    background: var(--color-ground-warm);
    line-height: 0;
  }
  .pf__portrait img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  @media (min-width: 640px) {
    .pf__portrait {
      float: inline-end;
      inline-size: 15.5rem;
      margin-inline-start: var(--space-6);
      margin-block-start: var(--space-1);
    }
  }
  .pf__h {
    font-size: var(--type-h3);
    margin-block: var(--space-6) var(--space-2);
    color: var(--color-action);
    clear: both;
  }
  .pf__contact {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    line-height: 1.6;
  }
  .pf__contact a {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
    font-weight: 600;
  }
  .pf__dot {
    color: var(--color-text-muted);
  }
  .pf__note {
    clear: both;
    margin-block-start: var(--space-5);
    padding-block-start: var(--space-3);
    border-block-start: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
  }
  .pf__list {
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .pf__list li {
    position: relative;
    padding-inline-start: var(--space-5);
    line-height: 1.6;
  }
  .pf__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--color-emphasis, #c99a52);
  }
</style>
