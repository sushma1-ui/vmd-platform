---
import SimplePage from '../../../components/content/SimplePage.astro';
import { getCtaLinks } from '../../../lib/cms.ts';
const { bookUrl } = await getCtaLinks();
---

<SimplePage
  title="Sunil Uprety, Registered Migration Agent"
  description="Registered Migration Agent (RMA): Sunil Uprety · MARN 2318234 — Principal of Visa & Migration Doctors, Perth, bound by the OMARA Code of Conduct."
  eyebrow="The practitioner"
  lead="A named, registered and verifiable Registered Migration Agent — not a call centre."
  cta={{ href: bookUrl, label: 'Book a Consultation' }}
>
  <p>
    Sunil Uprety is a Registered Migration Agent (MARN 2318234) practising in Perth, bound by the
    Migration Agents Code of Conduct administered by OMARA. His registration is verifiable on the
    OMARA register today.
  </p>
  <p>
    As the principal of the practice, he personally assesses each matter — you deal with the
    Registered Migration Agent, not a salesperson — and gives you an honest read on where your case
    stands, including when the better answer is to wait.
  </p>
</SimplePage>
