---
import SimplePage from '../../../components/content/SimplePage.astro';
import { getCtaLinks } from '../../../lib/cms.ts';
import { PRACTICE } from '@vmd/config';
const { bookUrl } = await getCtaLinks();
const register = PRACTICE.regulator.registerSearchUrl;

const qualifications = [
  'Registered Migration Agent (MARN 2318234)',
  'Graduate Diploma in Australian Migration Law and Practice',
  'Master of Business Administration (MBA)',
  'Master of Global Project Management',
  'MSc in Professional Accountancy',
  'ACCA Member',
  'QEAC Certified Education Counsellor',
];

const areasOfPractice = [
  'Skilled migration',
  'Employer sponsored visas',
  'Student and graduate visas',
  'Family and partner visas',
  'Tribunal and review matters',
];
---

<SimplePage
  title="Sunil Uprety, Registered Migration Agent"
  description="Registered Migration Agent (RMA): Sunil Uprety · MARN 2318234 — Director and Principal of Visa & Migration Doctors, Perth, bound by the OMARA Code of Conduct."
  eyebrow="The practitioner"
  lead="Director | Registered Migration Agent (MARN 2318234)"
  cta={{ href: bookUrl, label: 'Book a Consultation' }}
  disclaimer={true}
>
  <p>
    Sunil Uprety is the Principal and Registered Migration Agent of Visa &amp; Migration Doctors.
  </p>

  <p>
    His professional journey began in the education sector in 2015 as a QEAC Certified Education
    Counsellor, helping international students make informed decisions about their study and
    migration goals. Over the following years he gained broad experience supporting clients across
    education, migration and business advisory services.
  </p>

  <p>
    Sunil became an ACCA Member in May 2017 and completed a Master of Business Administration and a
    Master of Global Project Management in 2019. His interest in Australian migration law led him to
    complete the Graduate Diploma in Australian Migration Law and Practice at Griffith University.
    From 2019, he worked under a Registered Migration Agent, supporting him across a broad range of
    visa matters in a clerical and case-support capacity, before obtaining his own registration on
    19 September 2023.
  </p>

  <p>
    Today, Sunil leads Visa &amp; Migration Doctors with a focus on ethical practice and
    personalised advice. He believes migration advice should never be one-size-fits-all: every
    client deserves a diagnosis of their own circumstances and a strategy built on it.
  </p>

  <h2 class="pf__h">Qualifications &amp; credentials</h2>
  <ul class="pf__list">
    {qualifications.map((item) => <li>{item}</li>)}
  </ul>

  <h2 class="pf__h">Areas of practice</h2>
  <ul class="pf__list">
    {areasOfPractice.map((item) => <li>{item}</li>)}
  </ul>

  <p>
    Outside professional practice, Sunil enjoys continuous learning, following developments in
    migration and education policy, and time with family and friends.
  </p>

  <p>
    <a class="pf__verify" href={register} rel="noopener" target="_blank">
      Verify Sunil on the OMARA register →
    </a>
  </p>
</SimplePage>

<style>
  .pf__h {
    font-size: var(--type-h3);
    margin-block: var(--space-6) var(--space-2);
    color: var(--color-action);
  }
  .pf__list {
    margin: 0 0 var(--space-3);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }
  .pf__list li {
    position: relative;
    padding-inline-start: var(--space-5);
    line-height: 1.6;
  }
  .pf__list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.6em;
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--color-emphasis, #c99a52);
  }
  .pf__verify {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
    font-weight: 600;
  }
</style>
