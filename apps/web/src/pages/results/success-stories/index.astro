---
import Base from '../../../layouts/Base.astro';
import { breadcrumbSchema } from '@vmd/seo';
import { Disclaimer } from '@vmd/ui';
import { cms, getSettings } from '../../../lib/cms.ts';
import type { PinnedReview, Testimonial, SiteSettings } from '@vmd/schema';

/**
 * Client Stories — ONE place for every kind of real, consented client story:
 * verified Google reviews, written testimonials, and individual visa/skills
 * outcomes. Outcomes render as native cards (visa + lodged/decision dates + an
 * optional quote); the branded "Congratulations" graphic opens full-size on tap.
 *
 * Compliance: every item is consent-gated at the query; nothing claims a success
 * rate or guarantees an outcome, and a standing "individual results" line is shown.
 * Content is fully CMS-managed (success-stories, testimonials, pinned-reviews).
 */
interface Story {
  id: string | number;
  title: string;
  type:
    | 'client-photo'
    | 'grant-letter'
    | 'skills-assessment'
    | 'written-testimonial'
    | 'success-story'
    | string;
  category: string;
  description?: string | null;
  quote?: string | null;
  clientName?: string | null;
  visaSubclass?: string | null;
  lodgedDate?: string | null;
  decisionDate?: string | null;
  image?: { url?: string | null; alt?: string | null } | number | null;
  graphic?: { url?: string | null; alt?: string | null } | number | null;
  featured?: boolean | null;
  order?: number | null;
}

const CATEGORIES: { key: string; heading: string }[] = [
  { key: 'employer-sponsored', heading: 'Employer-sponsored visas' },
  { key: 'skilled', heading: 'Skilled migration' },
  { key: 'student', heading: 'Student & graduate visas' },
  { key: 'partner', heading: 'Partner visas' },
  { key: 'visitor', heading: 'Visitor visas' },
  { key: 'other', heading: 'Other outcomes' },
];

// The three streams, all consent-gated at the query layer.
let stories: Story[] = [];
let testimonials: Testimonial[] = [];
let pinned: PinnedReview[] = [];
let settings: SiteSettings | null = null;
try {
  [stories, testimonials, pinned, settings] = await Promise.all([
    cms.successStories() as unknown as Promise<Story[]>,
    cms.testimonials(),
    cms.pinnedReviews(),
    getSettings(),
  ]);
} catch {
  /* degrade to honest empty states */
}
const gr = settings?.googleReviews;

// Outcome cards = grants, skills assessments and success stories (not the written
// testimonials, which have their own lane below).
const OUTCOME_TYPES = new Set([
  'grant-letter',
  'skills-assessment',
  'success-story',
  'client-photo',
]);
const outcomeGroups = CATEGORIES.map((c) => ({
  ...c,
  items: stories
    .filter((s) => OUTCOME_TYPES.has(s.type) && s.category === c.key)
    .sort((a, b) => (a.order ?? 999) - (b.order ?? 999)),
})).filter((g) => g.items.length > 0);
const hasOutcomes = outcomeGroups.some((g) => g.items.length > 0);

// Written testimonials come from BOTH the Testimonials collection and any
// success-stories flagged as written-testimonial — merged into one lane.
const writtenFromStories = stories
  .filter((s) => s.type === 'written-testimonial' && s.quote)
  .map((s) => ({
    quote: s.quote as string,
    name: s.clientName ?? '',
    situation: s.visaSubclass ?? '',
    date: s.decisionDate ?? '',
  }));
const testimonialCards = [
  ...testimonials.map((t) => ({
    quote: t.quote,
    name: t.name,
    situation: t.situation ?? '',
    date: t.date ?? '',
  })),
  ...writtenFromStories,
].filter((t) => t.quote);

const mediaUrl = (m: Story['image']) =>
  m && typeof m === 'object' && m.url ? { url: m.url, alt: m.alt || '' } : null;

const stars = (n?: number) => '★'.repeat(Math.round(n ?? 5));
const badgeFor = (t: string) =>
  t === 'grant-letter'
    ? 'Visa granted'
    : t === 'skills-assessment'
      ? 'Skills assessment · positive'
      : t === 'client-photo'
        ? 'Client'
        : 'Success story';

// Dates in the same clipped style as the graphics: "21 APR 2026".
const fmtDate = (iso?: string | null) => {
  if (!iso) return '';
  const d = new Date(iso);
  if (isNaN(d.getTime())) return '';
  return d
    .toLocaleDateString('en-AU', { day: '2-digit', month: 'short', year: 'numeric' })
    .replace(/\./g, '')
    .toUpperCase();
};
const tYear = (iso?: string) => {
  if (!iso) return '';
  const d = new Date(iso);
  return isNaN(d.getTime()) ? '' : String(d.getFullYear());
};

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Results', path: '/results/' },
  { name: 'Client stories', path: '/results/success-stories/' },
];
---

<Base
  title="Client stories — reviews, testimonials & visa outcomes"
  description="Real, consented client stories: verified Google reviews, testimonials, and individual visa and skills-assessment outcomes. Every case is decided on its own merits; this is not a guarantee of any outcome."
  schemas={[breadcrumbSchema(trail)]}
>
  <section class="cs">
    <header class="cs__head">
      <p class="cs__eyebrow">Real clients · real stories · shared with permission</p>
      <h1 class="cs__title">Client stories</h1>
      <p class="cs__lead">
        The reviews, testimonials and outcomes on this page are real and shared with each client's
        permission. Every case is different and is decided on its own merits — these stories are not
        a guarantee of any outcome.
      </p>
      {
        gr?.rating && (
          <div class="cs__agg">
            <span class="cs__agg-num">{gr.rating.toFixed(1)}</span>
            <span class="cs__agg-stars" aria-hidden="true">
              ★★★★★
            </span>
            <span class="cs__agg-txt">
              {gr.count ? `average from ${gr.count} verified Google reviews` : 'average on Google'}
            </span>
          </div>
        )
      }
    </header>

    {/* ---- 1 · VISA & SKILLS OUTCOMES (native cards) ---------------------- */}
    {
      hasOutcomes && (
        <div class="cs__block">
          <p class="cs__k">Recent outcomes</p>
          <h2 class="cs__h">Visa grants & positive assessments</h2>
          {outcomeGroups.map((g) => (
            <section class="cs__group" aria-label={g.heading}>
              <h3 class="cs__group-h">{g.heading}</h3>
              <ul class="cs__grid" role="list">
                {g.items.map((s, i) => {
                  const proof = mediaUrl(s.image);
                  const graphic = mediaUrl(s.graphic);
                  const dialogId = `story-${s.id ?? i}`;
                  return (
                    <li class="oc">
                      <div class="oc__top">
                        <span class:list={['oc__badge', `oc__badge--${s.type}`]}>
                          {badgeFor(s.type)}
                        </span>
                        {s.visaSubclass && <span class="oc__chip">{s.visaSubclass}</span>}
                      </div>
                      <h4 class="oc__title">{s.title}</h4>
                      {s.description && <p class="oc__desc">{s.description}</p>}
                      {s.quote && <blockquote class="oc__quote">“{s.quote}”</blockquote>}
                      {(s.lodgedDate || s.decisionDate) && (
                        <dl class="oc__dates">
                          {s.lodgedDate && (
                            <div>
                              <dt>Lodged</dt>
                              <dd>{fmtDate(s.lodgedDate)}</dd>
                            </div>
                          )}
                          {s.decisionDate && (
                            <div>
                              <dt>{s.type === 'skills-assessment' ? 'Outcome' : 'Decision'}</dt>
                              <dd>{fmtDate(s.decisionDate)}</dd>
                            </div>
                          )}
                        </dl>
                      )}
                      <div class="oc__foot">
                        {s.clientName && <span class="oc__client">— {s.clientName}</span>}
                        {(graphic || proof) && (
                          <button class="oc__view" type="button" data-open={dialogId}>
                            View {s.type === 'skills-assessment' ? 'assessment' : 'grant'}
                          </button>
                        )}
                      </div>
                      {(graphic || proof) && (
                        <dialog class="oc__lb" id={dialogId} aria-label={`${s.title} — document`}>
                          <button class="oc__lb-x" type="button" data-close aria-label="Close">
                            ✕
                          </button>
                          <img
                            src={(graphic ?? proof)!.url}
                            alt={(graphic ?? proof)!.alt || `${s.title} — redacted document`}
                            loading="lazy"
                            decoding="async"
                          />
                        </dialog>
                      )}
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      )
    }

    {/* ---- 2 · TESTIMONIALS --------------------------------------------- */}
    {
      testimonialCards.length > 0 && (
        <div class="cs__block">
          <p class="cs__k">In their words</p>
          <h2 class="cs__h">What it's like to work with us</h2>
          <ul class="cs__grid cs__grid--testi" role="list">
            {testimonialCards.map((t) => (
              <li class="tc">
                <p class="tc__stars" aria-hidden="true">
                  ★★★★★
                </p>
                <blockquote class="tc__quote">“{t.quote}”</blockquote>
                <p class="tc__by">
                  {t.name}
                  {t.situation && <span class="tc__ctx"> · {t.situation}</span>}
                  {tYear(t.date) && <span class="tc__ctx"> · {tYear(t.date)}</span>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {/* ---- 3 · GOOGLE REVIEWS ------------------------------------------- */}
    {
      pinned.length > 0 && (
        <div class="cs__block">
          <p class="cs__k">Verified on Google</p>
          <h2 class="cs__h">Google reviews</h2>
          <ul class="cs__grid cs__grid--rev" role="list">
            {pinned.map((r) => (
              <li class="rc">
                {r.rating && (
                  <p class="rc__stars" aria-label={`${r.rating} out of 5`}>
                    {stars(r.rating)}
                  </p>
                )}
                {r.text && <blockquote class="rc__quote">“{r.text}”</blockquote>}
                <p class="rc__by">
                  {r.reviewerName}
                  {r.reviewDate && <span class="rc__ctx"> · {r.reviewDate}</span>}
                </p>
              </li>
            ))}
          </ul>
          {gr?.profileUrl && (
            <p class="cs__more">
              <a href={gr.profileUrl} rel="noopener" target="_blank">
                Read every review on Google →
              </a>
            </p>
          )}
        </div>
      )
    }

    {
      !hasOutcomes && testimonialCards.length === 0 && pinned.length === 0 && (
        <p class="cs__empty">
          Client stories are published here with each client's permission. The first stories are
          being prepared — in the meantime, see our
          <a href="/results/reviews/">verified Google reviews</a>.
        </p>
      )
    }

    <div class="cs__cta">
      <p>Want an honest read on your own case?</p>
      <a class="cs__cta-btn" href="/book-consultation">Book a consultation</a>
    </div>

    <Disclaimer variant="outcomes" />
  </section>
</Base>

<script>
  // Lightbox: each "View" button opens its <dialog>; Esc and the ✕ close it.
  // Native <dialog> gives us focus-trapping and backdrop for free.
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    const dlg = document.getElementById(btn.dataset.open || '') as HTMLDialogElement | null;
    if (!dlg) return;
    btn.addEventListener('click', () => dlg.showModal());
    dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // click on backdrop
    });
  });
</script>

<style>
  .cs {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4) var(--space-9);
  }
  .cs__head {
    max-inline-size: 70ch;
    margin-block-end: var(--space-8);
  }
  .cs__eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis-text);
    font-weight: 600;
  }
  .cs__title {
    font-size: var(--type-display-2);
    margin-block: var(--space-2) var(--space-3);
  }
  .cs__lead {
    color: var(--color-text-muted);
    max-inline-size: 62ch;
  }
  .cs__agg {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    flex-wrap: wrap;
  }
  .cs__agg-num {
    font-family: var(--font-display);
    font-size: var(--type-h1);
    color: var(--color-emphasis-text);
    line-height: 1;
  }
  .cs__agg-stars {
    color: var(--color-emphasis-text);
    letter-spacing: 0.08em;
  }
  .cs__agg-txt {
    color: var(--color-text-muted);
    font-size: var(--type-body-sm);
  }

  .cs__block {
    margin-block-start: var(--space-9);
  }
  .cs__k {
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis-text);
    font-weight: 600;
    margin: 0;
  }
  .cs__h {
    font-size: var(--type-h2);
    margin-block: var(--space-2) var(--space-5);
  }
  .cs__group {
    margin-block-start: var(--space-6);
  }
  .cs__group-h {
    font-size: var(--type-h4);
    color: var(--color-action);
    margin-block-end: var(--space-4);
    padding-block-end: var(--space-2);
    border-block-end: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
  }
  .cs__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }

  /* Outcome card */
  .oc {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-subtle);
  }
  .oc__top {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .oc__badge {
    font-size: var(--type-caption);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-inverse);
    background: var(--color-action);
    padding: 0.28rem 0.6rem;
    border-radius: var(--radius-pill, 999px);
  }
  .oc__badge--skills-assessment {
    background: var(--color-emphasis-text);
  }
  .oc__chip {
    font-size: var(--type-caption);
    font-weight: 600;
    color: var(--color-action);
    border: 1px solid color-mix(in srgb, var(--color-action) 22%, transparent);
    padding: 0.22rem 0.55rem;
    border-radius: var(--radius-pill, 999px);
  }
  .oc__title {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: 1.2;
    margin: var(--space-1) 0 0;
    color: var(--color-text);
  }
  .oc__desc {
    color: var(--color-text-muted);
    font-size: var(--type-body-sm);
    margin: 0;
  }
  .oc__quote {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--type-body-lg);
    line-height: 1.5;
    color: var(--color-text);
  }
  .oc__dates {
    display: flex;
    gap: var(--space-5);
    margin: var(--space-2) 0 0;
  }
  .oc__dates dt {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .oc__dates dd {
    margin: 2px 0 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }
  .oc__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }
  .oc__client {
    color: var(--color-text-muted);
    font-size: var(--type-body-sm);
    font-style: italic;
  }
  .oc__view {
    margin-inline-start: auto;
    font: inherit;
    font-size: var(--type-body-sm);
    font-weight: 600;
    color: var(--color-action);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-action) 25%, transparent);
    border-radius: var(--radius-control);
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    transition: background-color var(--motion-fast, 150ms) var(--ease-standard, ease);
  }
  .oc__view:hover {
    background: color-mix(in srgb, var(--color-action) 8%, transparent);
  }
  .oc__view:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: 2px;
  }
  .oc__lb {
    border: 0;
    padding: 0;
    background: transparent;
    max-inline-size: min(92vw, 40rem);
    max-block-size: 92vh;
    overflow: visible;
  }
  .oc__lb::backdrop {
    background: color-mix(in srgb, var(--color-ground-deep) 82%, transparent);
    backdrop-filter: blur(2px);
  }
  .oc__lb img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-card);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }
  .oc__lb-x {
    position: absolute;
    inset-block-start: -1rem;
    inset-inline-end: -1rem;
    inline-size: 2.2rem;
    block-size: 2.2rem;
    border-radius: 50%;
    border: 0;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 1rem;
    cursor: pointer;
    box-shadow: var(--shadow-raised, 0 6px 18px rgba(0, 0, 0, 0.3));
  }
  .oc__lb-x:focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: 2px;
  }

  /* Testimonial + review cards */
  .tc,
  .rc {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    background: var(--color-ground-light);
    border: 1px solid color-mix(in srgb, var(--color-action) 9%, transparent);
    border-radius: var(--radius-card);
  }
  .tc__stars,
  .rc__stars {
    color: var(--color-emphasis-text);
    letter-spacing: 0.1em;
    margin: 0;
  }
  .tc__quote,
  .rc__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--type-body-lg);
    line-height: 1.5;
    color: var(--color-text);
  }
  .tc__by,
  .rc__by {
    font-weight: 600;
    color: var(--color-action);
    margin: 0;
  }
  .tc__ctx,
  .rc__ctx {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .cs__more {
    margin-block-start: var(--space-4);
  }
  .cs__more a {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
  }
  .cs__empty {
    color: var(--color-text-muted);
    padding: var(--space-6);
    background: var(--color-ground-warm);
    border-radius: var(--radius-card);
  }

  .cs__cta {
    margin-block-start: var(--space-9);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .cs__cta p {
    font-size: var(--type-body-lg);
    color: var(--color-text-muted);
  }
  .cs__cta-btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-5);
    background: var(--color-interactive-strong);
    color: var(--color-text-inverse);
    border-radius: var(--radius-control);
    font-weight: 600;
    text-decoration: none;
  }
  .cs__cta-btn:hover {
    background: color-mix(in srgb, var(--color-interactive-strong) 88%, black);
  }

  @media (min-width: 640px) {
    .cs__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .cs__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .cs__grid--testi,
    .cs__grid--rev {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
