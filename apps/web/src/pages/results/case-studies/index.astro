---
import Base from '../../../layouts/Base.astro';
import { breadcrumbSchema } from '@vmd/seo';
import { Chip, Rule, Disclaimer } from '@vmd/ui';
import BookCta from '../../../components/cta/BookCta.astro';
import { cms } from '../../../lib/cms.ts';
import { lexicalToHtml } from '../../../lib/lexical.ts';
import { pathnameToTrail } from '../../../lib/breadcrumbs.ts';
import type { CaseStudy } from '@vmd/schema';

/**
 * Case Studies — anonymised problem → approach → outcome (Blueprint §10.3). Each study
 * is a <details> so the index scans quickly and expands on demand (zero JS). Coarse
 * subclass tag only; never combined with identifying detail. Typed CaseStudy[].
 */
const studies: CaseStudy[] = await cms.caseStudies();
const trail = pathnameToTrail(Astro.url.pathname);
const subCode = (s: CaseStudy) =>
  s.subclass && typeof s.subclass === 'object' ? (s.subclass as any).code : null;
---

<Base
  title="Case studies — anonymised, problem to outcome"
  description="Anonymised migration case studies: the problem, the approach, and the outcome. No names, no photos, no success rates — a record of how real matters were worked, from a Registered Migration Agent in Perth."
  schemas={[breadcrumbSchema(trail)]}
>
  <section class="cs-hero">
    <div class="cs-hero__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        {
          trail.map((t, i) => (
            <span>
              {i > 0 && <span aria-hidden="true"> / </span>}
              <a href={t.path}>{t.name}</a>
            </span>
          ))
        }
      </nav>
      <p class="eyebrow">How real matters were worked</p>
      <h1 class="cs-hero__title">Case studies</h1>
      <Rule width="short" />
      <p class="cs-hero__lead">
        Each one is anonymised and follows the same honest arc — the problem, the approach, the
        outcome. No names, no photos, and never a success rate.
      </p>
    </div>
  </section>

  <section class="cs-body">
    {
      studies.length > 0 ? (
        <div class="cs-list">
          {studies.map((s, i) => (
            <details class="cs-item" open={i === 0}>
              <summary>
                <span class="cs-item__title">{s.title}</span>
                {subCode(s) && <Chip>{subCode(s)}</Chip>}
              </summary>
              <div class="cs-item__body">
                {s.problem && (
                  <div class="cs-block">
                    <h3>The problem</h3>
                    <div class="cs-rt" set:html={lexicalToHtml(s.problem)} />
                  </div>
                )}
                {s.approach && (
                  <div class="cs-block">
                    <h3>The approach</h3>
                    <div class="cs-rt" set:html={lexicalToHtml(s.approach)} />
                  </div>
                )}
                {s.outcome && (
                  <div class="cs-block">
                    <h3>The outcome</h3>
                    <div class="cs-rt" set:html={lexicalToHtml(s.outcome)} />
                  </div>
                )}
              </div>
            </details>
          ))}
        </div>
      ) : (
        <div class="cs-empty">
          Anonymised case studies are published here as client consent is confirmed. In the
          meantime, the Grant Ledger records dated outcomes, and the Free Visa Health Check gives
          you an honest read on your own position.
        </div>
      )
    }

    <div class="cs-disc"><Disclaimer variant="outcomes" /></div>

    <div class="cs-cta">
      <p>Wondering how your own matter would be approached?</p>
      <BookCta variant="primary" label="Book a consultation" />
    </div>
  </section>
</Base>

<style>
  .crumbs {
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    border-block-end: 1px solid var(--color-emphasis);
  }
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .cs-hero {
    background: var(--color-ground-warm);
  }
  .cs-hero__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4);
  }
  .cs-hero__title {
    font-size: var(--type-display-1);
    line-height: var(--leading-display-1);
    margin-block: var(--space-2) 0;
  }
  .cs-hero__lead {
    font-size: var(--type-body-lg);
    line-height: 1.5;
    margin-block-start: var(--space-3);
    max-inline-size: 60ch;
  }

  .cs-body {
    max-inline-size: var(--container-prose);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
  }
  .cs-list {
    display: grid;
    gap: var(--space-3);
  }
  .cs-item {
    border: 1px solid color-mix(in srgb, var(--color-action) 12%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-4) var(--space-5);
    background: var(--color-ground-light);
  }
  .cs-item summary {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .cs-item__title {
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: var(--color-action);
  }
  .cs-item__body {
    margin-block-start: var(--space-4);
  }
  .cs-block {
    margin-block-end: var(--space-4);
  }
  .cs-block h3 {
    font-size: var(--type-h4);
    color: var(--color-action);
    margin-block-end: var(--space-2);
  }
  .cs-rt {
    line-height: 1.7;
  }
  .cs-rt :global(p) {
    margin-block-end: var(--space-3);
  }

  .cs-empty {
    border: 1px dashed color-mix(in srgb, var(--color-emphasis) 55%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    color: var(--color-text-muted);
  }
  .cs-empty a,
  .cs-rt :global(a) {
    color: var(--color-action);
  }
  .cs-disc {
    margin-block-start: var(--space-5);
  }
  .cs-cta {
    margin-block-start: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .cs-cta p {
    font-size: var(--type-body-lg);
    color: var(--color-text-muted);
  }
</style>
