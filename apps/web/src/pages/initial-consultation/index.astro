---
import ServicePageView from '../../components/pages/ServicePageView.astro';
import Base from '../../layouts/Base.astro';
import { cms } from '../../lib/cms.ts';
import type { ServiceDoc } from '../../lib/servicePages.ts';

// Single root-level service page. Its URL is /initial-consultation (the document's slug).
const all = (await cms.servicePages()) as unknown as ServiceDoc[];
const page = all.find((p) => p.slug === 'initial-consultation') ?? null;
---

{
  page ? (
    <ServicePageView page={page} allPages={all} />
  ) : (
    <Base
      title="Initial Consultation | Visa & Migration Doctors"
      description="Book an initial consultation with a Perth Registered Migration Agent for honest advice on your options."
    >
      <section class="empty">
        <h1>Initial Consultation</h1>
        <p>This page is being prepared. In the meantime, you can book a consultation.</p>
        <a class="empty__btn" href="/book/">
          Book a consultation
        </a>
      </section>
    </Base>
  )
}

<style>
  .empty {
    max-inline-size: var(--container-prose);
    margin-inline: auto;
    padding: var(--space-9) var(--space-4);
    text-align: center;
  }
  .empty__btn {
    display: inline-block;
    margin-block-start: var(--space-4);
    background: var(--color-accent, #0a5);
    color: #fff;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-button, 6px);
    text-decoration: none;
    font-weight: 600;
  }
</style>
