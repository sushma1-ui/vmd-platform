---
import ServicePageView from '../../components/pages/ServicePageView.astro';
import Base from '../../layouts/Base.astro';
import { cms, getCtaLinks } from '../../lib/cms.ts';
import type { ServiceDoc } from '../../lib/servicePages.ts';

// Single root-level service page. Its URL is /initial-consultation (the document's slug).
const all = (await cms.servicePages()) as unknown as ServiceDoc[];
const page = all.find((p) => p.slug === 'initial-consultation') ?? null;
const { bookUrl } = await getCtaLinks();
---

{
  page ? (
    <ServicePageView page={page} allPages={all} />
  ) : (
    <Base
      title="Initial Consultation | Visa & Migration Doctors"
      description="Book an initial consultation with a Registered Migration Agent in Perth for honest advice on your options."
    >
      <section class="empty">
        <h1>Initial Consultation</h1>
        <p>This page is being prepared. In the meantime, you can book a consultation.</p>
        <a class="empty__btn" href={bookUrl}>
          Book a Consultation
        </a>
      </section>
    </Base>
  )
}

<style>
  .empty {
    max-inline-size: var(--container-prose);
    margin-inline: auto;
    padding: var(--space-9) var(--space-4);
    text-align: center;
  }
  .empty__btn {
    display: inline-block;
    margin-block-start: var(--space-4);
    background: var(--color-action);
    color: var(--color-action-contrast);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-control);
    text-decoration: none;
    font-weight: 600;
  }
</style>
