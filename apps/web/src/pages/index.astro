---
// build-bust: team members collection live
import Base from '../layouts/Base.astro';
import { PRACTICE, RMA_LINE } from '@vmd/config';
import { Button, Card, Rule } from '@vmd/ui';
import { localBusinessSchema, personSchema } from '@vmd/seo';
import { cms, getSettings, getHomepage } from '../lib/cms.ts';
import BookCta from '../components/cta/BookCta.astro';
import TrustGateway from '../components/sections/TrustGateway.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import MeetTeam from '../components/sections/MeetTeam.astro';
import HealthCheck from '../components/islands/HealthCheck.island.astro';
import Icon from '../components/Icon.astro';

// "How we work" icons: examine → route → verified outcome (the clinical brand arc).
const STEP_ICONS = [
  'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M20 20l-4.3-4.3', // magnifier — diagnosis
  'M6 21V4 M6 5h11l-2.5 3 2.5 3H6', // signpost — pathway
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M8.5 12l2.5 2.5 4.5-4.5', // check seal — outcome
];
// "Diagnosis promise" icons: transparency → fixed fee → the registered agent.
const PROMISE_ICONS = [
  'M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z', // eye
  'M4 4h8l8 8-8 8-8-8z M8.4 8.4h.01', // price tag
  'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M5 20a7 7 0 0 1 14 0', // person
];
// Client-journey fallback (used only if an editor hasn't set the steps in the CMS).
const DEFAULT_STEPS = [
  {
    label: 'Diagnosis',
    description: 'A thorough, evidence-based assessment of exactly where you stand — no guesswork.',
  },
  {
    label: 'Pathway',
    description:
      'A clear plan matched to your circumstances and the law, with fixed fees quoted upfront.',
  },
  {
    label: 'Outcome',
    description:
      'Careful preparation and honest guidance, right through to the decision on your case.',
  },
];

const settings = await getSettings();
// Homepage global (CMS-editable, section by section). Every read falls back to
// the built-in copy below, so the page is identical until an editor changes it,
// and never breaks if the CMS is unreachable. `show !== false` keeps a section
// visible unless an editor has explicitly switched it off.
const hp = await getHomepage();
const shown = (s?: { show?: boolean | null }) => s?.show !== false;

// Hero copy: the deployed CMS still serves the PREVIOUS hero default, and CMS
// writes are pending, so treat those exact old strings as "unset" — the current
// copy wins until an editor sets a genuinely new value (which is still honoured).
const OLD_HERO_TITLE = 'Find the Right Australian Visa Pathway — Before You Spend a Dollar';
const OLD_HERO_LEAD =
  'Honest, expert guidance from a Registered Migration Agent — clear answers and a plan you can trust, entirely at your pace.';
const heroTitle =
  hp?.hero?.title && hp.hero.title.trim() !== OLD_HERO_TITLE
    ? hp.hero.title
    : 'Find the Right Australian Visa Pathway with Expert Guidance';
const heroLead =
  hp?.hero?.lead && hp.hero.lead.trim() !== OLD_HERO_LEAD
    ? hp.hero.lead
    : "Helping individuals, families, and businesses navigate Australia's migration system with ethical, personalised advice from a Registered Migration Agent.";

const register = PRACTICE.regulator.registerSearchUrl;
// A concrete, verifiable trust line beats a vague claim. Use the live Google
// rating when available, falling back to a worldwide-reach line.
const googleRating = settings?.googleReviews?.rating;
const heroRating = googleRating
  ? `Rated ${googleRating.toFixed(1)} on Google`
  : 'Trusted by clients across multiple countries';

// "Diagnosis promise" intro: the deployed CMS still serves the previous
// (comparative) default, so treat that exact string as "unset" — positive,
// simpler copy wins until an editor sets a genuinely new value.
const OLD_WHYCHOOSE_INTRO =
  'The commitments that set us apart are the ones we are glad to be held to.';
const whyChooseIntro =
  hp?.whyChoose?.intro && hp.whyChoose.intro.trim() !== OLD_WHYCHOOSE_INTRO
    ? hp.whyChoose.intro
    : "The commitments we're glad to be held to.";

// "Where are you in your journey?" — situation-first navigation that speaks the
// client's language (not subclass numbers) and routes to the most relevant hub.
// It complements the hero: the hero's assessment gives a personal answer; this
// grid is the "browse straight to your pathway" path. Mirrors the six situations
// the hero assessment opens with.
const SITUATIONS = [
  {
    label: "I'm a skilled professional",
    desc: 'Turn your qualifications and experience into a skilled visa.',
    href: '/visas/subclass-189-skilled-independent-visa',
    icon: 'M4 8h16v11H4z',
    extra: 'M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2 M4 13h16',
  },
  {
    label: "I'm a student",
    desc: 'Study in Australia, with clear post-study work options.',
    href: '/visas/subclass-500-student-visa',
    icon: 'M12 4 2 9l10 5 10-5-10-5z',
    extra: 'M6 11.5V16c0 1 2.7 2 6 2s6-1 6-2v-4.5',
  },
  {
    label: "I'm partnered with an Australian",
    desc: 'Build your life together — partner visas, prepared properly.',
    href: '/visas/partner-visa-onshore-820-801',
    icon: 'M12 20s-7-4.5-7-9.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 1.5c0 5-7 10-7 10z',
  },
  {
    label: "I'm an employer",
    desc: 'Sponsor the skilled workers your business needs.',
    href: '/visas/subclass-482-skills-in-demand-visa',
    icon: 'M4 21V4h10v17',
    extra: 'M14 9h6v12 M7 8h1 M7 12h1 M7 16h1',
  },
  {
    label: 'My visa was refused',
    desc: "A refusal isn't the end — understand your review options.",
    href: '/services/refusal-recovery/',
    icon: 'M3 12a9 9 0 1 0 3-6.7',
    extra: 'M3 4v4h4',
  },
  {
    label: "I'm on a bridging visa",
    desc: 'Unsure where you stand? Get a clear read on your next step.',
    href: '/services/second-opinion/',
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z',
    extra: 'M12 7.5V12l3 2',
  },
];

// Featured Blogs — featured articles first, then most recent, from the CMS.
let posts: any[] = [];
try {
  const all = await cms.articles();
  const feat = all.filter((p: any) => p.featured);
  posts = (feat.length ? feat : all).slice(0, 3);
} catch {}

// Curated Google reviews (pinned) — shown in the homepage reviews section when the
// live Google API isn't configured, so the section shows real content, not a placeholder.
let pinnedReviews: any[] = [];
try {
  pinnedReviews = await cms.pinnedReviews();
} catch {}
---

<Base
  title="Australian Visa & Migration Experts — Registered Migration Agents"
  description={`Honest, expert guidance on Australian visas from Registered Migration Agent ${PRACTICE.principal.name} (MARN ${PRACTICE.principal.marn}). Start a free assessment — for people already in Australia and around the world.`}
  schemas={[localBusinessSchema(), { '@context': 'https://schema.org', ...personSchema() }]}
>
  <!-- 3 · HERO — the free assessment leads -->
  <section class="hero" id="start">
    {
      /* Atmospheric Opera House — the real photo, treated to a whisper: low
       opacity, brightened, warm-toned, low-contrast, masked so it lives centre-
       right and dissolves into the light. Behind the content only; hidden intent
       is "feel Australia before you notice the landmark". Decorative. */
    }
    <div class="hero__photo" aria-hidden="true">
      <img
        src="/opera-house.avif"
        alt=""
        width="1600"
        height="1000"
        loading="eager"
        fetchpriority="low"
        decoding="async"
      />
    </div>
    <div class="hero__copy">
      <h1 class="hero__title">{heroTitle}</h1>
      <Rule width="short" />
      <p class="hero__lead">{heroLead}</p>
      <ul class="hero__checks" aria-label="What you can count on">
        <li>Registered Migration Agent</li>
        <li>Personalised Migration Advice</li>
        <li>Assisting Clients Worldwide</li>
      </ul>
      <p class="hero__rating">
        <span class="hero__rating-stars" aria-hidden="true">★★★★★</span>
        <span>{heroRating}</span>
      </p>
      <div class="hero__cta">
        <BookCta variant="primary" label="Book a Consultation" />
      </div>
    </div>
    <div class="hero__form">
      <div class="hero__form-head">
        <p class="hero__form-eyebrow">Free · takes 90 seconds</p>
        <h2 class="hero__form-title">Answer a few quick questions</h2>
        <p class="hero__form-sub">
          A Registered Migration Agent reviews your answers and comes back with your clear next
          steps — free, and yours to act on when you're ready.
        </p>
      </div>
      <HealthCheck />
    </div>
  </section>

  <!-- 3b · TRUST BAR (verifiable credentials) -->
  <TrustBar />

  {
    /* The "Which of these is you?" cards were removed — the hero assessment now
      captures the same six situations as its first step, so the section was redundant. */
  }

  <!-- 5 · DIAGNOSIS PROMISE (Why Choose Us) -->
  {
    shown(hp?.whyChoose) && (
      <section data-reveal class="section">
        <div class="section__inner">
          <h2 class="section__h">{hp?.whyChoose?.heading || 'The diagnosis promise'}</h2>
          <p class="section__sub">{whyChooseIntro}</p>
          <div class="grid grid--3 promises">
            {hp?.whyChoose?.promises?.length ? (
              hp.whyChoose.promises.map((p, i) => (
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[i % PROMISE_ICONS.length]} />
                  </span>
                  <p>{p.text}</p>
                </div>
              ))
            ) : (
              <>
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[0]} />
                  </span>
                  <p>
                    An <strong>honest read</strong> on your eligibility — including the right time
                    to apply.
                  </p>
                </div>
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[1]} />
                  </span>
                  <p>
                    A <strong>fixed fee</strong>, quoted before you commit — so you always know the
                    cost.
                  </p>
                </div>
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[2]} />
                  </span>
                  <p>
                    You work directly with the <strong>Registered Migration Agent</strong>, from
                    start to finish.
                  </p>
                </div>
              </>
            )}
          </div>
        </div>
      </section>
    )
  }

  {
    /* Client testimonials + visa outcomes are merged into the single "Client stories"
      section below (reviews + testimonials + outcomes in one place). */
  }

  <!-- 7 · WHERE ARE YOU IN YOUR JOURNEY? (situation-first navigation) -->
  <section data-reveal class="section section--bone">
    <div class="section__inner">
      <p class="eyebrow">Explore your pathway</p>
      <h2 class="section__h">Where are you in your journey?</h2>
      <p class="section__sub">
        Prefer to look around first? Choose what fits and go straight to the right pathway — or take
        the free assessment above for a personal answer.
      </p>
      <ul class="sit__grid" role="list">
        {
          SITUATIONS.map((s) => (
            <li>
              <a class="sit__card" href={s.href}>
                <span class="sit__icon" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path
                      d={s.icon}
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    {s.extra && (
                      <path
                        d={s.extra}
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    )}
                  </svg>
                </span>
                <span class="sit__label">{s.label}</span>
                <span class="sit__desc">{s.desc}</span>
                <span class="sit__cta">
                  Explore <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="section__more">
        <a href="/services/">See all services →</a>
      </p>
    </div>
  </section>

  <!-- 8 · YOUR JOURNEY (How we work — client journey timeline) -->
  {
    shown(hp?.howWeWork) && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <h2 class="section__h">{hp?.howWeWork?.heading || 'How we work'}</h2>
          {hp?.howWeWork?.intro && <p class="section__sub">{hp.howWeWork.intro}</p>}
          <ol class="journey">
            {(hp?.howWeWork?.steps?.length ? hp.howWeWork.steps : DEFAULT_STEPS).map((step, i) => (
              <li class="journey__step">
                <div class="journey__marker">
                  <span class="journey__icon" aria-hidden="true">
                    <Icon path={STEP_ICONS[i % STEP_ICONS.length]} size={22} />
                  </span>
                  <span class="journey__num">{i + 1}</span>
                </div>
                <div class="journey__content">
                  <p class="journey__label">{step.label}</p>
                  <p class="journey__desc">{step.description}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="section__more section__more--center">
            <a href="/#start">Start with a free diagnosis →</a>
          </p>
        </div>
      </section>
    )
  }

  <!-- 8b · WHY CHOOSE VMD (reasons to choose — trust + conversion) -->
  <section data-reveal class="section">
    <div class="section__inner">
      <p class="eyebrow">Why choose us</p>
      <h2 class="section__h">Why clients choose Visa &amp; Migration Doctors</h2>
      <p class="section__sub">
        Practical reasons people trust us with one of the biggest decisions of their lives.
      </p>
      <ul class="why__grid" role="list">
        <li class="why__item">
          <h3 class="why__t">A registered agent you can verify</h3>
          <p class="why__d">
            Your matter is handled by a Registered Migration Agent (MARN {PRACTICE.principal.marn}),
            bound by the OMARA Code of Conduct — and checkable on the public register.
          </p>
        </li>
        <li class="why__item">
          <h3 class="why__t">One point of contact, start to finish</h3>
          <p class="why__d">
            You work directly with the agent and a dedicated team — the same people, from your first
            assessment through to the decision.
          </p>
        </li>
        <li class="why__item">
          <h3 class="why__t">Honest, personalised advice</h3>
          <p class="why__d">
            A straight read on your situation and the pathway that actually fits — including the
            best time to act.
          </p>
        </li>
        <li class="why__item">
          <h3 class="why__t">Support wherever you are</h3>
          <p class="why__d">
            Perth-based and assisting clients across Australia and around the world, in person or
            online.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 9 · MEET SUNIL (Trust & Credentials) -->
  {
    shown(hp?.practitioner) && (
      <section data-reveal class="section">
        <div class="section__inner meet">
          <figure class="meet__portrait meet__portrait--photo">
            <img
              class="meet__img"
              src="/team/sunil.jpg"
              alt={`${PRACTICE.principal.name}, Registered Migration Agent`}
              width="640"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <div class="meet__copy">
            <p class="eyebrow">{hp?.practitioner?.eyebrow || 'The practitioner'}</p>
            <h2 class="section__h">
              {hp?.practitioner?.heading || `You'll speak to ${PRACTICE.principal.name}.`}
            </h2>
            {hp?.practitioner?.body?.length ? (
              hp.practitioner.body.map((para) => <p>{para.text}</p>)
            ) : (
              <>
                <p>
                  A Registered Migration Agent bound by the Migration Agents Code of Conduct,
                  helping people with Australian visas from onshore and around the world. When you
                  come to us, you get an honest read on where your case stands — including the best
                  time and way to move forward.
                </p>
                <p>
                  What you can count on: a straight assessment, careful preparation, and honesty
                  about whether we're the right people to help. That's the whole practice.
                </p>
              </>
            )}
            <ul class="meet__points">
              <li>Bound by the Migration Agents Code of Conduct</li>
              <li>Fixed fees, quoted before you commit</li>
              <li>You work directly with the Registered Migration Agent</li>
            </ul>
            <p class="meet__marn">
              <a href={register} rel="noopener" target="_blank">
                {RMA_LINE} — verify on the OMARA register →
              </a>
            </p>
            <Button
              variant="secondary"
              href={hp?.practitioner?.button?.href || '/about/sunil-uprety/'}
            >
              {hp?.practitioner?.button?.label || 'More about Sunil'}
            </Button>
          </div>
        </div>
      </section>
    )
  }

  <!-- 10 · TRUST & SUCCESS (gateway cards → dedicated Client Stories hub) -->
  {
    shown(hp?.googleReviews) && (
      <TrustGateway
        rating={settings?.googleReviews?.rating}
        count={settings?.googleReviews?.count}
        review={pinnedReviews?.[0] ?? null}
        href="/results/success-stories/"
      />
    )
  }

  <!-- 11 · INSIGHTS (Featured Blogs) -->
  {
    shown(hp?.featuredBlogs) && (
      <section data-reveal class="section">
        <div class="section__inner">
          <h2 class="section__h">{hp?.featuredBlogs?.heading || 'From our blog'}</h2>
          <p class="section__sub">
            {hp?.featuredBlogs?.intro ||
              'Migration law changes constantly. Every piece is authored by a Registered Migration Agent.'}
          </p>
          {posts.length > 0 ? (
            <>
              <div class="grid grid--3">
                {posts.map((p) => (
                  <Card
                    title={p.title}
                    href={`/blog/${p.slug}/`}
                    eyebrow={String(p.category).replace(/-/g, ' ')}
                  >
                    {p.excerpt ?? ''}
                  </Card>
                ))}
              </div>
              <p class="section__more">
                <a href={hp?.featuredBlogs?.link?.href || '/blog/'}>
                  {hp?.featuredBlogs?.link?.label || 'Read the blog →'}
                </a>
              </p>
            </>
          ) : (
            <div class="ledger-empty ledger-empty--light">
              Articles appear here once published — every piece is reviewed by {RMA_LINE}.
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 11b · FAQs (optional; off unless an editor enables it) -->
  {
    hp?.faqs?.show && hp.faqs.items && hp.faqs.items.length > 0 && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <h2 class="section__h">{hp.faqs.heading || 'Frequently asked questions'}</h2>
          {hp.faqs.intro && <p class="section__sub">{hp.faqs.intro}</p>}
          <div class="faqs">
            {hp.faqs.items.map((f) => (
              <details class="faq">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 11c · MEET YOUR TEAM (homepage glimpse → full team page) -->
  <MeetTeam />

  <!-- 12 · CLOSING (Final CTA) -->
  {
    shown(hp?.finalCta) && (
      <section data-reveal class="band band--close">
        <div class="band__inner band__inner--center">
          <h2 class="band__h">{hp?.finalCta?.heading || 'Ready to get clear on your options?'}</h2>
          <p class="band__lead band__lead--center">
            {hp?.finalCta?.lead ||
              'Book a consultation for a straight, honest read on your case — with a Registered Migration Agent, and a fixed fee quoted before you commit.'}
          </p>
          <BookCta variant="primary" label={hp?.finalCta?.buttonLabel || 'Book a consultation'} />
          <p class="band__promise">
            <a href="/#start">Prefer to start free? Take the visa assessment →</a>
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .section {
    padding-block: var(--space-8);
  }
  .section--bone {
    background: var(--color-ground-warm);
  }
  .section__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .section__h {
    font-size: var(--type-h2);
  }
  .section__sub {
    font-size: var(--type-body-lg);
    color: var(--color-text-muted);
    margin-block: var(--space-2) var(--space-5);
    max-inline-size: 62ch;
  }
  .section__more {
    margin-block-start: var(--space-4);
  }
  .section__more a {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
  }

  .hero {
    position: relative;
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: grid;
    gap: var(--space-6);
    align-items: center;
    /* A luxury-architectural LIGHT quality — morning haze, not a landmark.
       Directional left→right: bright and clean on the left (behind the copy, so
       the headline stays crisply readable), warming to a soft golden haze toward
       the centre-right. Airy whites, warm neutrals only (no grey/blue), edge-
       faded so there's no visible box. All values tunable here; layout untouched. */
    background:
      /* clean bright highlight over the copy — airy + high readability */
      radial-gradient(44% 42% at 15% 4%, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0) 62%),
      /* directional morning light: bright-clean left → warm gold right */
      linear-gradient(
          100deg,
          rgba(255, 255, 255, 0.9) 0%,
          rgba(255, 255, 255, 0.34) 36%,
          color-mix(in srgb, var(--color-ground-warm) 42%, transparent) 74%,
          color-mix(in srgb, var(--color-emphasis) 11%, transparent) 100%
        ),
      /* soft golden haze emerging toward the centre-right */
      radial-gradient(
          56% 66% at 82% 40%,
          color-mix(in srgb, var(--color-emphasis) 13%, transparent),
          transparent 66%
        ),
      /* morning-haze veil — airiness, lifts any muddiness */
      radial-gradient(120% 112% at 48% 16%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 82%),
      /* warm base glow rising — grounding warmth + depth */
      radial-gradient(
          130% 84% at 46% 114%,
          color-mix(in srgb, var(--color-ground-warm) 52%, transparent),
          transparent 62%
        );
  }
  /* Keep the copy and form above the atmospheric photo. */
  .hero__copy,
  .hero__form {
    position: relative;
    z-index: 1;
  }
  /* The Opera House photo, treated as atmosphere: it sits BEHIND the content,
     within the hero only, and is deliberately faint. Opacity + filter + mask are
     the tuning knobs; readability always wins, so keep it low. */
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    /* Live centre-right; dissolve toward the copy (left) and all edges so it
       never touches the headline, the nav above, or the section below. */
    -webkit-mask-image: radial-gradient(115% 110% at 68% 30%, #000 22%, transparent 70%);
    mask-image: radial-gradient(115% 110% at 68% 30%, #000 22%, transparent 70%);
  }
  .hero__photo img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 70% 24%;
    /* Atmospheric, not photographic — brightened, warm-toned, low-contrast.
       Strength raised from a whisper to a clearer presence (still masked away
       from the headline so readability holds). */
    opacity: 0.26;
    filter: brightness(1.05) contrast(0.95) saturate(1.08) sepia(0.05);
  }
  /* Mobile: a different, lighter treatment — focal point moved up and away from
     the stacked copy/form, and visibility reduced so the hero stays clean. */
