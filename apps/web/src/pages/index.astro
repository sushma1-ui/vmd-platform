---
import Base from '../layouts/Base.astro';
import { PRACTICE, RMA_LINE } from '@vmd/config';
import { Button, Card, Rule, Disclaimer } from '@vmd/ui';
import { localBusinessSchema, personSchema } from '@vmd/seo';
import { cms, getSettings, getHomepage } from '../lib/cms.ts';
import { servicePageHref } from '../lib/servicePages.ts';
import BookCta from '../components/cta/BookCta.astro';
import HealthCheckCta from '../components/cta/HealthCheckCta.astro';
import GoogleReviews from '../components/sections/GoogleReviews.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import Icon from '../components/Icon.astro';

// "How we work" icons: examine → route → verified outcome (the clinical brand arc).
const STEP_ICONS = [
  'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z M20 20l-4.3-4.3', // magnifier — diagnosis
  'M6 21V4 M6 5h11l-2.5 3 2.5 3H6', // signpost — pathway
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M8.5 12l2.5 2.5 4.5-4.5', // check seal — outcome
];
// "Diagnosis promise" icons: transparency → fixed fee → the registered agent.
const PROMISE_ICONS = [
  'M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12z M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z', // eye
  'M4 4h8l8 8-8 8-8-8z M8.4 8.4h.01', // price tag
  'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M5 20a7 7 0 0 1 14 0', // person
];

const settings = await getSettings();
// Homepage global (CMS-editable, section by section). Every read falls back to
// the built-in copy below, so the page is identical until an editor changes it,
// and never breaks if the CMS is unreachable. `show !== false` keeps a section
// visible unless an editor has explicitly switched it off.
const hp = await getHomepage();
const shown = (s?: { show?: boolean | null }) => s?.show !== false;

const register = PRACTICE.regulator.registerSearchUrl;
const situationsFallback = [
  [
    "I'm a skilled professional",
    'Points, nominations and the right subclass — mapped to your occupation.',
    '/your-situation/skilled-professional/',
  ],
  [
    "I'm a student",
    'The genuine-student test, working rights and what comes after study.',
    '/your-situation/student/',
  ],
  [
    "I'm partnered with an Australian Citizen or Permanent Resident",
    'Onshore or offshore, and the evidence a case officer actually weighs.',
    '/your-situation/partnered-to-australian/',
  ],
  [
    "I'm an employer",
    'Whether you can sponsor, your obligations, and the compliance exposure.',
    '/your-situation/employer/',
  ],
  [
    'My visa was refused',
    'Deadlines are short. A fixed-fee Second Opinion on whether review is worth it.',
    '/your-situation/visa-refused/',
  ],
  [
    "I'm on a bridging visa",
    "What you can and can't do, and what you're actually bridging to.",
    '/your-situation/bridging-visa/',
  ],
];
// Situation cards come from the CMS when an editor has added them, else the fallback.
const cmsSituations = (hp?.situations?.items ?? [])
  .filter((i) => i?.label && i?.href)
  .map((i) => [i.label as string, i.description ?? '', i.href as string] as const);
const situations = cmsSituations.length ? cmsSituations : situationsFallback;
// Wayfinding icons for the situation cards (SVG path `d`, 24x24, single path w/ subpaths).
const SITUATION_ICONS = [
  'M3 8h18v11H3z M8 8V6a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2', // briefcase — skilled
  'M12 5 2 9l10 4 10-4-10-4z M6 11.5V16c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-4.5', // cap — student
  'M12 20s-6.5-4.4-6.5-9A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 6.5 3c0 4.6-6.5 9-6.5 9z', // heart — partner
  'M5 21V4h9v17 M14 21V9h5v12 M3 21h18', // buildings — employer
  'M12 4 2 20h20z M12 10v4 M12 17h.01', // warning — refused
  'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z M12 7v5l3 2', // clock — bridging
];

// Featured Services — pulled from the CMS (service pages flagged "featured"), linking
// to their canonical URLs. Editors curate via the Featured checkbox.
let featuredServices: any[] = [];
try {
  const all = await cms.servicePages();
  featuredServices = all.filter((s: any) => s.featured).slice(0, 6);
} catch {}
const sectionLabel = (s: any) => (s.section === 'visas' ? 'Visa pathway' : 'Service');

// Featured Blogs — featured articles first, then most recent, from the CMS.
let posts: any[] = [];
try {
  const all = await cms.articles();
  const feat = all.filter((p: any) => p.featured);
  posts = (feat.length ? feat : all).slice(0, 3);
} catch {}
---

<Base
  title="Registered Migration Agent in Perth"
  description={`Honest migration advice in Perth from Registered Migration Agent (RMA) ${PRACTICE.principal.name} (MARN: ${PRACTICE.principal.marn}). Know exactly where you stand before you spend a dollar — clear pathways, no false promises.`}
  schemas={[localBusinessSchema(), { '@context': 'https://schema.org', ...personSchema() }]}
>
  <!-- 3 · HERO -->
  <section class="hero">
    <div class="hero__copy">
      <p class="eyebrow">{hp?.hero?.eyebrow || PRACTICE.descriptor}</p>
      <h1 class="hero__title">
        {hp?.hero?.title || 'Know exactly where you stand — before you spend a dollar.'}
      </h1>
      <Rule width="short" />
      <p class="hero__lead">
        {
          hp?.hero?.lead ||
            `Migration advice in Perth, provided by Registered Migration Agent (RMA) ${PRACTICE.principal.name}. Clear pathways, honest answers, no false promises.`
        }
      </p>
      <div class="hero__cta">
        <HealthCheckCta
          variant="primary"
          label={hp?.hero?.primaryCta?.label || 'Start your Free Visa Health Check'}
        />
        <BookCta
          variant="secondary"
          label={hp?.hero?.secondaryCta?.label || 'Book a consultation'}
        />
      </div>
    </div>
    <aside class="hero__cred" aria-label="Registered Migration Agent credentials">
      <p class="hero__cred-eyebrow">Registered Migration Agent (RMA)</p>
      <p class="hero__cred-name">{PRACTICE.principal.name}</p>
      <p class="hero__cred-marn">MARN {PRACTICE.principal.marn}</p>
      <ul class="hero__cred-points">
        <li>Bound by the Migration Agents Code of Conduct</li>
        <li>Fixed fees — quoted before you commit</li>
        <li>You deal with the agent, not a salesperson</li>
      </ul>
      <a class="hero__cred-verify" href={register} rel="noopener" target="_blank">
        Verify on the OMARA register →
      </a>
    </aside>
  </section>

  <!-- 3b · TRUST BAR (verifiable credentials) -->
  <TrustBar />

  <!-- 4 · SITUATION -->
  {
    shown(hp?.situations) && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <h2 class="section__h">{hp?.situations?.heading || 'Which of these is you?'}</h2>
          <p class="section__sub">
            {hp?.situations?.intro ||
              "People don't think in subclass numbers. Start where you are — we'll translate."}
          </p>
          <div class="grid grid--3">
            {situations.map(([label, line, href], i) => (
              <Card
                title={label}
                href={href}
                eyebrow="Your situation"
                icon={SITUATION_ICONS[i % SITUATION_ICONS.length]}
              >
                {line}
              </Card>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 5 · DIAGNOSIS PROMISE (Why Choose Us) -->
  {
    shown(hp?.whyChoose) && (
      <section data-reveal class="section">
        <div class="section__inner">
          <h2 class="section__h">{hp?.whyChoose?.heading || 'The diagnosis promise'}</h2>
          <p class="section__sub">
            {hp?.whyChoose?.intro ||
              'The only differentiation that survives scrutiny is the kind that visibly costs us something.'}
          </p>
          <div class="grid grid--3 promises">
            {hp?.whyChoose?.promises?.length ? (
              hp.whyChoose.promises.map((p, i) => (
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[i % PROMISE_ICONS.length]} />
                  </span>
                  <p>{p.text}</p>
                </div>
              ))
            ) : (
              <>
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[0]} />
                  </span>
                  <p>
                    We tell you if you're <strong>not</strong> eligible — including when the honest
                    answer is to wait.
                  </p>
                </div>
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[1]} />
                  </span>
                  <p>
                    A <strong>fixed fee</strong>, quoted before you commit. No surprises.
                  </p>
                </div>
                <div class="promise">
                  <span class="promise__icon" aria-hidden="true">
                    <Icon path={PROMISE_ICONS[2]} />
                  </span>
                  <p>
                    You deal with the <strong>registered agent</strong> — not a salesperson.
                  </p>
                </div>
              </>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- 6 · SUCCESS STORIES (evidence, navy band) -->
  {
    shown(hp?.successStories) && (
      <section data-reveal class="band">
        <div class="band__inner">
          <p class="band__eyebrow">
            {hp?.successStories?.eyebrow || 'Real clients, real outcomes'}
          </p>
          <h2 class="band__h">{hp?.successStories?.heading || 'Success stories'}</h2>
          <p class="band__lead">
            {hp?.successStories?.intro ||
              "Testimonial videos, client stories and redacted visa grants — every one shared with the client's permission, organised by visa type."}
          </p>
          <p class="band__lead">
            <a
              class="band__link"
              href={hp?.successStories?.link?.href || '/results/success-stories/'}
            >
              {hp?.successStories?.link?.label || 'Browse client success stories →'}
            </a>
          </p>
          <Disclaimer variant="outcomes" />
        </div>
      </section>
    )
  }

  <!-- 7 · WHAT WE DO (Featured Services) -->
  {
    shown(hp?.featuredServices) && (
      <section data-reveal class="section">
        <div class="section__inner">
          <h2 class="section__h">{hp?.featuredServices?.heading || 'Featured services'}</h2>
          <p class="section__sub">
            {hp?.featuredServices?.intro ||
              'Find yourself in one scan. Every service is a problem we solve, not a product we sell.'}
          </p>
          <div class="grid grid--2">
            {featuredServices.map((s) => (
              <Card title={s.title} href={servicePageHref(s)} eyebrow={sectionLabel(s)}>
                {s.seo?.metaDescription || s.subtitle || ''}
              </Card>
            ))}
          </div>
          <p class="section__more">
            <a href={hp?.featuredServices?.seeAll?.href || '/services/'}>
              {hp?.featuredServices?.seeAll?.label || 'See all our services →'}
            </a>
            <br />
            <a
              href={
                hp?.featuredServices?.secondaryLink?.href || '/services/art-review-applications'
              }
            >
              {hp?.featuredServices?.secondaryLink?.label ||
                'Visa refused or cancelled? ART Review Applications — act fast, deadlines are strict →'}
            </a>
          </p>
        </div>
      </section>
    )
  }

  <!-- 8 · HOW WE WORK -->
  {
    shown(hp?.howWeWork) && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <h2 class="section__h">{hp?.howWeWork?.heading || 'How we work'}</h2>
          <div class="grid grid--3 steps">
            {hp?.howWeWork?.steps?.length ? (
              hp.howWeWork.steps.map((step, i) => (
                <div class="step">
                  <span class="step__icon" aria-hidden="true">
                    <Icon path={STEP_ICONS[i % STEP_ICONS.length]} size={24} />
                  </span>
                  <p class="step__label">{step.label}</p>
                  <p class="step__desc">{step.description}</p>
                </div>
              ))
            ) : (
              <>
                <div class="step">
                  <span class="step__icon" aria-hidden="true">
                    <Icon path={STEP_ICONS[0]} size={24} />
                  </span>
                  <p class="step__label">1 · Diagnosis</p>
                  <p class="step__desc">
                    A thorough, evidence-based assessment of where you stand.
                  </p>
                </div>
                <div class="step">
                  <span class="step__icon" aria-hidden="true">
                    <Icon path={STEP_ICONS[1]} size={24} />
                  </span>
                  <p class="step__label">2 · Pathway</p>
                  <p class="step__desc">A clear plan matched to your circumstances and the law.</p>
                </div>
                <div class="step">
                  <span class="step__icon" aria-hidden="true">
                    <Icon path={STEP_ICONS[2]} size={24} />
                  </span>
                  <p class="step__label">3 · Outcome</p>
                  <p class="step__desc">
                    Careful preparation and honest guidance through to decision.
                  </p>
                </div>
              </>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- 9 · MEET SUNIL (Trust & Credentials) -->
  {
    shown(hp?.practitioner) && (
      <section data-reveal class="section">
        <div class="section__inner meet">
          <figure class="meet__portrait" aria-hidden="true">
            <span class="meet__mono">
              {PRACTICE.principal.name
                .split(' ')
                .map((w) => w[0])
                .join('')}
            </span>
          </figure>
          <div class="meet__copy">
            <p class="eyebrow">{hp?.practitioner?.eyebrow || 'The practitioner'}</p>
            <h2 class="section__h">
              {hp?.practitioner?.heading || `You'll speak to ${PRACTICE.principal.name}.`}
            </h2>
            {hp?.practitioner?.body?.length ? (
              hp.practitioner.body.map((para) => <p>{para.text}</p>)
            ) : (
              <>
                <p>
                  I'm a Registered Migration Agent in Perth, bound by the Migration Agents Code of
                  Conduct. When you come to me, you get an honest read on where your case stands —
                  including when the better answer is to wait, take a different pathway, or that I'm
                  not the right person to help.
                </p>
                <p>
                  What I won't do: promise an outcome, quote a success rate, or take a matter I
                  don't believe in. That's the whole practice.
                </p>
              </>
            )}
            <p class="meet__marn">
              <a href={register} rel="noopener" target="_blank">
                {RMA_LINE} — verify on the OMARA register →
              </a>
            </p>
            <Button
              variant="secondary"
              href={hp?.practitioner?.button?.href || '/about/sunil-uprety/'}
            >
              {hp?.practitioner?.button?.label || 'More about Sunil'}
            </Button>
          </div>
        </div>
      </section>
    )
  }

  <!-- 10 · REVIEWS -->
  {
    shown(hp?.googleReviews) && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <GoogleReviews
            profileUrl={settings?.googleReviews?.profileUrl}
            heading={hp?.googleReviews?.heading ?? 'Google Reviews'}
            intro={
              hp?.googleReviews?.intro ??
              'Placed here, after the evidence and the person, reviews read as corroboration — not advertising.'
            }
            limit={hp?.googleReviews?.count ?? 3}
          />
        </div>
      </section>
    )
  }

  <!-- 11 · INSIGHTS (Featured Blogs) -->
  {
    shown(hp?.featuredBlogs) && (
      <section data-reveal class="section">
        <div class="section__inner">
          <h2 class="section__h">{hp?.featuredBlogs?.heading || 'From our blog'}</h2>
          <p class="section__sub">
            {hp?.featuredBlogs?.intro ||
              'Migration law changes constantly. Every piece is authored by a Registered Migration Agent.'}
          </p>
          {posts.length > 0 ? (
            <>
              <div class="grid grid--3">
                {posts.map((p) => (
                  <Card
                    title={p.title}
                    href={`/blog/${p.slug}/`}
                    eyebrow={String(p.category).replace(/-/g, ' ')}
                  >
                    {p.excerpt ?? ''}
                  </Card>
                ))}
              </div>
              <p class="section__more">
                <a href={hp?.featuredBlogs?.link?.href || '/blog/'}>
                  {hp?.featuredBlogs?.link?.label || 'Read the blog →'}
                </a>
              </p>
            </>
          ) : (
            <div class="ledger-empty ledger-empty--light">
              Articles appear here once published — every piece is reviewed by {RMA_LINE}.
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 11b · FAQs (optional; off unless an editor enables it) -->
  {
    hp?.faqs?.show && hp.faqs.items && hp.faqs.items.length > 0 && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <h2 class="section__h">{hp.faqs.heading || 'Frequently asked questions'}</h2>
          {hp.faqs.intro && <p class="section__sub">{hp.faqs.intro}</p>}
          <div class="faqs">
            {hp.faqs.items.map((f) => (
              <details class="faq">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 12 · CLOSING (Final CTA) -->
  {
    shown(hp?.finalCta) && (
      <section data-reveal class="band band--close">
        <div class="band__inner band__inner--center">
          <h2 class="band__h">{hp?.finalCta?.heading || 'Not sure where you stand?'}</h2>
          <p class="band__lead band__lead--center">
            {hp?.finalCta?.lead ||
              "Ninety seconds, six questions, a real answer — including if you're not yet eligible."}
          </p>
          <HealthCheckCta
            variant="primary"
            label={hp?.finalCta?.buttonLabel || 'Start your Free Visa Health Check'}
          />
          <p class="band__promise">
            {hp?.finalCta?.promise || "If we don't think we can help you, we'll say so."}
          </p>
        </div>
      </section>
    )
  }
</Base>

<style>
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .section {
    padding-block: var(--space-8);
  }
  .section--bone {
    background: var(--color-ground-warm);
  }
  .section__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .section__h {
    font-size: var(--type-h2);
  }
  .section__sub {
    font-size: var(--type-body-lg);
    color: var(--color-text-muted);
    margin-block: var(--space-2) var(--space-5);
    max-inline-size: 62ch;
  }
  .section__more {
    margin-block-start: var(--space-4);
  }
  .section__more a {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
  }

  .hero {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-8) var(--space-4);
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .hero__title {
    font-size: var(--type-display-1);
    line-height: var(--leading-display-1);
  }
  .hero__lead {
    font-size: var(--type-body-lg);
    line-height: 1.5;
    margin-block: var(--space-3) var(--space-4);
    max-inline-size: 52ch;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-end: var(--space-4);
  }
  /* Hero credentials card — turns the space into a trust + verification asset. */
  .hero__cred {
    margin: 0;
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-ground-deep) 22%, transparent);
  }
  .hero__cred-eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-emphasis);
    margin: 0;
  }
  .hero__cred-name {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: 1.1;
    color: var(--color-text-inverse);
    margin: 0;
  }
  .hero__cred-marn {
    font-size: var(--type-body-sm);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--color-text-inverse) 80%, transparent);
    margin: 0;
  }
  .hero__cred-points {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .hero__cred-points li {
    position: relative;
    padding-inline-start: var(--space-4);
    font-size: var(--type-body-sm);
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-text-inverse) 92%, transparent);
  }
  .hero__cred-points li::before {
    content: '✓';
    position: absolute;
    inset-inline-start: 0;
    color: var(--color-emphasis);
    font-weight: 700;
  }
  .hero__cred-verify {
    margin-block-start: var(--space-4);
    color: var(--color-emphasis);
    font-weight: 600;
    font-size: var(--type-body-sm);
    text-decoration: none;
  }
  .hero__cred-verify:hover {
    text-decoration: underline;
  }
  .meet__mono {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: 0.05em;
    color: var(--color-action);
  }

  .grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  .promise {
    padding: var(--space-4);
    background: var(--color-ground-light);
    border-radius: var(--radius-card);
  }
  .section--bone .promise {
    background: var(--color-ground-warm);
  }
  .promise__icon,
  .step__icon {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    color: var(--color-emphasis-text);
    background: color-mix(in srgb, var(--color-emphasis) 14%, transparent);
  }
  .promise p {
    margin-block-start: var(--space-3);
    font-size: var(--type-body-lg);
    line-height: 1.45;
  }
  .step__label {
    margin-block-start: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--type-h3);
    color: var(--color-action);
  }
  .step__desc {
    margin-block-start: var(--space-1);
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--color-text);
  }

  .band {
    background: var(--color-ground-deep);
    color: var(--color-text-inverse);
  }
  .band__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-9) var(--space-4);
  }
  .band__inner--center {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .band__eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-emphasis);
  }
  .band__h {
    font-size: var(--type-h2);
