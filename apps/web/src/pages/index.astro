---
// build-bust: team members collection live
import Base from '../layouts/Base.astro';
import { PRACTICE, RMA_LINE } from '@vmd/config';
import { Rule } from '@vmd/ui';
import { localBusinessSchema, personSchema } from '@vmd/seo';
import { cms, getSettings, getHomepage } from '../lib/cms.ts';
import BookCta from '../components/cta/BookCta.astro';
import ClientTestimonials from '../components/sections/ClientTestimonials.astro';
import MeetTeam from '../components/sections/MeetTeam.astro';
import HealthCheck from '../components/islands/HealthCheck.island.astro';

// "How we work" — the practice's real method (Diagnosis → Pathway → Outcome).
// Client-journey fallback (used only if an editor hasn't set the steps in the CMS).
const DEFAULT_STEPS = [
  {
    label: 'Diagnosis',
    description:
      'A thorough, evidence-based assessment of your circumstances, history and eligibility — before anything is recommended.',
  },
  {
    label: 'Pathway',
    description:
      'A clear written strategy matched to your situation and the law, with the trade-offs explained in plain language.',
  },
  {
    label: 'Outcome',
    description:
      'Careful preparation and honest guidance through the application, keeping you informed at every stage.',
  },
];

const settings = await getSettings();
// Homepage global (CMS-editable, section by section). Every read falls back to
// the built-in copy below, so the page is identical until an editor changes it,
// and never breaks if the CMS is unreachable. `show !== false` keeps a section
// visible unless an editor has explicitly switched it off.
const hp = await getHomepage();
const shown = (s?: { show?: boolean | null }) => s?.show !== false;

// Hero copy: the deployed CMS still serves the PREVIOUS hero default, and CMS
// writes are pending, so treat those exact old strings as "unset" — the current
// copy wins until an editor sets a genuinely new value (which is still honoured).
const OLD_HERO_TITLE = 'Find the Right Australian Visa Pathway — Before You Spend a Dollar';
// Superseded CMS hero titles — treated as "unset" so the branded styled default
// (with the gold "Made Clear" accent) wins until an editor sets a genuinely new value.
const SUPERSEDED_HERO_TITLES = [OLD_HERO_TITLE, 'Australian Migration, Made Clear...'];
const OLD_HERO_LEAD =
  'Honest, expert guidance from a Registered Migration Agent — clear answers and a plan you can trust, entirely at your pace.';
const HERO_DEFAULT = 'Find the Right Australian Visa Pathway with Honest Guidance';
const heroTitle =
  hp?.hero?.title && !SUPERSEDED_HERO_TITLES.includes(hp.hero.title.trim())
    ? hp.hero.title
    : HERO_DEFAULT;
// Prototype-approved concise lead. The previous long default is also treated as
// "unset" so this shorter version wins until an editor sets a genuinely new value.
const OLD_HERO_LEAD_2 =
  "Helping individuals, families, and businesses navigate Australia's migration system with ethical, personalised advice from a Registered Migration Agent.";
const heroLead =
  hp?.hero?.lead && hp.hero.lead.trim() !== OLD_HERO_LEAD && hp.hero.lead.trim() !== OLD_HERO_LEAD_2
    ? hp.hero.lead
    : 'Ethical, professional guidance on Australian visas and migration — for individuals, families and businesses — direct from a Registered Migration Agent.';

// "Where are you in your journey?" — situation-first navigation that speaks the
// client's language (not subclass numbers) and routes to the most relevant hub.
// It complements the hero: the hero's assessment gives a personal answer; this
// grid is the "browse straight to your pathway" path. Mirrors the six situations
// the hero assessment opens with.
const SITUATIONS = [
  {
    label: "I'm a skilled professional",
    desc: 'Turn your qualifications and experience into a skilled visa.',
    href: '/visas/subclass-189-skilled-independent-visa',
    icon: 'M4 8h16v11H4z',
    extra: 'M9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2 M4 13h16',
  },
  {
    label: "I'm a student",
    desc: 'Study in Australia, with clear post-study work options.',
    href: '/visas/subclass-500-student-visa',
    icon: 'M12 4 2 9l10 5 10-5-10-5z',
    extra: 'M6 11.5V16c0 1 2.7 2 6 2s6-1 6-2v-4.5',
  },
  {
    label: "I'm partnered with an Australian",
    desc: 'Build your life together — partner visas, prepared properly.',
    href: '/visas/partner-visa-onshore-820-801',
    icon: 'M12 20s-7-4.5-7-9.5A3.5 3.5 0 0 1 12 8a3.5 3.5 0 0 1 7 1.5c0 5-7 10-7 10z',
  },
  {
    label: "I'm an employer",
    desc: 'Sponsor the skilled workers your business needs.',
    href: '/visas/subclass-482-skills-in-demand-visa',
    icon: 'M4 21V4h10v17',
    extra: 'M14 9h6v12 M7 8h1 M7 12h1 M7 16h1',
  },
  {
    label: 'My visa was refused',
    desc: "A refusal isn't the end — understand your review options.",
    href: '/services/refusal-recovery/',
    icon: 'M3 12a9 9 0 1 0 3-6.7',
    extra: 'M3 4v4h4',
  },
  {
    label: "I'm on a bridging visa",
    desc: 'Unsure where you stand? Get a clear read on your next step.',
    href: '/services/second-opinion/',
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z',
    extra: 'M12 7.5V12l3 2',
  },
];

// Featured Blogs — featured articles first, then most recent, from the CMS.
let posts: any[] = [];
try {
  const all = await cms.articles();
  const feat = all.filter((p: any) => p.featured);
  posts = (feat.length ? feat : all).slice(0, 3);
} catch {}

// Curated Google reviews (pinned) — shown in the homepage reviews section when the
// live Google API isn't configured, so the section shows real content, not a placeholder.
let pinnedReviews: any[] = [];
try {
  pinnedReviews = await cms.pinnedReviews();
} catch {}

// Official Government & trusted third-party tools — the same links as the nav's
// Resources menu (single source of truth for the URLs).
const QUICK_LINKS = [
  { label: 'Home Affairs', href: 'https://immi.homeaffairs.gov.au/' },
  { label: 'VEVO Check', href: 'https://online.immi.gov.au/evo/firstParty?actionType=query' },
  { label: 'Visa Pricing', href: 'https://immi.homeaffairs.gov.au/visas/visa-pricing-estimator' },
  {
    label: 'Processing Times',
    href: 'https://immi.homeaffairs.gov.au/visas/getting-a-visa/visa-processing-times/global-visa-processing-times',
  },
  {
    label: 'Points Calculator',
    href: 'https://immi.homeaffairs.gov.au/help-support/departmental-forms/online-forms/points-calculator',
  },
  { label: 'Police Check', href: 'https://afpnationalpolicechecks.converga.com.au/' },
];
---

<Base
  title="Australian Visa & Migration — Registered Migration Agent in Perth"
  description={`Honest guidance on Australian visas from Registered Migration Agent ${PRACTICE.principal.name} (MARN ${PRACTICE.principal.marn}). Start a free assessment — for people already in Australia and around the world.`}
  schemas={[localBusinessSchema(), { '@context': 'https://schema.org', ...personSchema() }]}
>
  <!-- 3 · HERO — the free assessment leads -->
  <section class="hero" id="start">
    {
      /* Atmospheric Opera House — the real photo, treated to a whisper: low
       opacity, brightened, warm-toned, low-contrast, masked so it lives centre-
       right and dissolves into the light. Behind the content only; hidden intent
       is "feel Australia before you notice the landmark". Decorative. */
    }
    <div class="hero__photo" aria-hidden="true">
      <img
        src="/opera-house.avif"
        alt=""
        width="1600"
        height="1000"
        loading="eager"
        fetchpriority="low"
        decoding="async"
      />
    </div>
    <div class="hero__copy">
      <h1 class="hero__title">
        {
          heroTitle === HERO_DEFAULT ? (
            <Fragment>
              Australian Visa &amp; Migration, <span class="hl">Made Clear</span>
            </Fragment>
          ) : (
            heroTitle
          )
        }
      </h1>
      <Rule width="short" />
      <p class="hero__lead">{heroLead}</p>
      <ul class="hero__checks" aria-label="What you can count on">
        <li>One dedicated point of contact</li>
        <li>Personalised Migration Advice</li>
        <li>Assisting Clients Worldwide</li>
      </ul>
      <div class="hero__cta">
        <BookCta variant="primary" label="Book a Consultation" />
      </div>
    </div>
    <div class="hero__form">
      <div class="hero__form-head">
        <p class="hero__form-eyebrow">Free · takes 90 seconds</p>
        <h2 class="hero__form-title">Answer a few quick questions</h2>
        <p class="hero__form-sub">
          A Registered Migration Agent reviews your answers and replies with your clear next steps.
        </p>
      </div>
      <div class="hero__form-body">
        <HealthCheck />
      </div>
    </div>
  </section>

  {
    /* The "Which of these is you?" cards were removed — the hero assessment now
      captures the same six situations as its first step, so the section was redundant. */
  }

  {
    /* Client testimonials + visa outcomes are merged into the single "Client stories"
      section below (reviews + testimonials + outcomes in one place). */
  }

  <!-- 7 · WHERE ARE YOU IN YOUR JOURNEY? (situation-first navigation) -->
  <section data-reveal class="section">
    <div class="section__inner">
      <p class="eyebrow">Explore your pathway</p>
      <h2 class="section__h">Where are you in your journey?</h2>
      <p class="section__sub">
        Prefer to browse first? Choose what fits and go straight to the right pathway.
      </p>
      <ul class="sit__grid" role="list">
        {
          SITUATIONS.map((s) => (
            <li>
              <a class="sit__card" href={s.href}>
                <span class="sit__icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                    <path
                      d={s.icon}
                      stroke="currentColor"
                      stroke-width="1.6"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                    {s.extra && (
                      <path
                        d={s.extra}
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    )}
                  </svg>
                </span>
                <span class="sit__text">
                  <span class="sit__label">{s.label}</span>
                  <span class="sit__desc">{s.desc}</span>
                </span>
                <span class="sit__arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="section__more">
        <a href="/services/">See all services →</a>
      </p>
    </div>
  </section>

  <!-- 8 · HOW WE WORK — "A method, not a metaphor" (three numbered steps) -->
  {
    shown(hp?.howWeWork) && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <p class="eyebrow">How we work</p>
          <h2 class="section__h">
            {hp?.howWeWork?.heading && hp.howWeWork.heading.trim() !== 'How we work' ? (
              hp.howWeWork.heading
            ) : (
              <Fragment>
                A method, <span class="hl">not a metaphor</span>
              </Fragment>
            )}
          </h2>
          {hp?.howWeWork?.intro && <p class="section__sub">{hp.howWeWork.intro}</p>}
          <div class="steps">
            {(hp?.howWeWork?.steps?.length ? hp.howWeWork.steps : DEFAULT_STEPS).map((step) => (
              <div class="step">
                <h3 class="step__h">{step.label}</h3>
                <p class="step__d">{step.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- 8b · WHEREVER YOU ARE — real map + reach (benchmark layout) -->
  <section data-reveal class="ausmap">
    <div class="ausmap__inner">
      <figure class="ausmap__map">
        <img
          src="/aus-map.webp"
          alt="Map of Australia"
          width="1200"
          height="750"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="ausmap__copy">
        <p class="eyebrow">Wherever you are</p>
        <h2 class="section__h">
          Australian migration advice, <span class="hl">wherever you are</span>
        </h2>
        <p class="section__sub">
          Based in Perth and working with clients onshore and overseas — the same registered
          practice, the same standard of care, whether you meet us in person or online.
        </p>
        <div class="ausmap__stat">
          <div>
            <div class="ausmap__k">1,653</div>
            <div class="ausmap__v">applications &amp; lodgements prepared since 2023</div>
          </div>
          <div>
            <div class="ausmap__k">Perth&nbsp;CBD</div>
            <div class="ausmap__v">{PRACTICE.address.street} · by appointment</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9 · MEET YOUR TEAM (homepage glimpse → full team page) -->
  <MeetTeam />

  <!-- 11 · RESOURCES — dark section (blog · guides · official tools) -->
  {
    shown(hp?.featuredBlogs) && (
      <section data-reveal class="section res">
        <div class="section__inner">
          <p class="eyebrow res__eyebrow">Resources</p>
          <h2 class="section__h res__h">
            Guides, insights and <span class="hl">official tools</span>
          </h2>
          <div class="res__grid">
            <div class="res__main">
              <p class="res__k">Blog &amp; insights</p>
              {posts.length > 0 ? (
                <div class="res__posts">
                  {posts.map((p) => (
                    <a class="rpost" href={`/blog/${p.slug}/`}>
                      <span class="rpost__cat">{String(p.category).replace(/-/g, ' ')}</span>
                      <h3 class="rpost__t">{p.title}</h3>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="res__empty">
                  Articles appear here once published — every piece is reviewed by {RMA_LINE}.
                </div>
              )}
              <a class="res__more" href={hp?.featuredBlogs?.link?.href || '/blog/'}>
                {hp?.featuredBlogs?.link?.label || 'Read the blog →'}
              </a>
            </div>
            <div class="res__side">
              <div class="res__box">
                <h3 class="res__box-h">Visa Guides &amp; Checklists</h3>
                <p class="res__box-p">
                  Step-by-step guides and document checklists for common pathways.
                </p>
                <a class="res__more" href="/resources/">
                  Browse guides &amp; checklists →
                </a>
              </div>
              <div class="res__box">
                <h3 class="res__box-h">Quick Links</h3>
                <div class="quicklinks">
                  {QUICK_LINKS.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener noreferrer">
                      {l.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- 11b · FAQs (optional; off unless an editor enables it) -->
  {
    hp?.faqs?.show && hp.faqs.items && hp.faqs.items.length > 0 && (
      <section data-reveal class="section section--bone">
        <div class="section__inner">
          <h2 class="section__h">{hp.faqs.heading || 'Frequently asked questions'}</h2>
          {hp.faqs.intro && <p class="section__sub">{hp.faqs.intro}</p>}
          <div class="faqs">
            {hp.faqs.items.map((f) => (
              <details class="faq">
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CLIENT TESTIMONIALS — Google reviews, kept as the final section just above the footer -->
  {
    shown(hp?.googleReviews) && (
      <ClientTestimonials
        reviews={pinnedReviews}
        profileUrl={settings?.googleReviews?.profileUrl}
      />
    )
  }
</Base>

<style>
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-emphasis-text);
  }
  /* Gold heading accent (matches the benchmark's <span class="hl">). */
  .section__h .hl {
    color: var(--color-emphasis-text);
  }
  .section {
    padding-block: var(--space-6);
  }
  .section--bone {
    background: var(--color-ground-warm);
  }

  /* ── Australia — a sense of place. Real map photo, warm and quiet. ───────── */
  .ausmap {
    background: var(--color-ground-light);
    padding-block: var(--space-6);
  }
  .ausmap__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: grid;
    gap: var(--space-6);
    align-items: center;
    grid-template-columns: 1fr;
  }
  /* The map — a rounded, hairline-framed card on a soft shadow, at a calm 16:10. */
  .ausmap__map {
    margin: 0;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-overlay);
    background: var(--color-ground-warm);
  }
  .ausmap__map img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 600ms var(--ease-standard, ease);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ausmap__map:hover img {
      transform: scale(1.02);
    }
  }
  /* Reach — two calm, gold-numeral figures (real, client-approved work volumes). */
  .ausmap__stat {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    margin-block-start: var(--space-6);
  }
  .ausmap__k {
    font-family: var(--font-display);
    font-size: var(--type-h2);
    line-height: 1;
    color: var(--color-emphasis-text);
  }
  .ausmap__v {
    margin-block-start: var(--space-1);
    font-size: var(--type-body-sm);
    color: var(--color-text-muted);
    line-height: 1.4;
    max-inline-size: 24ch;
  }
  @media (min-width: 880px) {
    .ausmap__inner {
      grid-template-columns: 0.95fr 1.05fr;
      gap: var(--space-8);
    }
  }

  /* ── Resources — the closing dark section: blog posts + guides + official
        tools, on a navy→ink gradient (matches the benchmark). ──────────────── */
  .res {
    background: linear-gradient(180deg, var(--color-action), var(--color-ground-deep));
  }
  .res__eyebrow {
    color: var(--color-emphasis);
  }
  /* Higher specificity than the navy `.section__h` default, so the heading stays
     white on the dark ground; its .hl accent uses the brighter gold for contrast. */
  .res .section__h {
    color: #fff;
  }
  .res .section__h .hl {
    color: var(--color-emphasis);
  }
  .res__grid {
    display: grid;
    gap: var(--space-6);
    margin-block-start: var(--space-6);
    grid-template-columns: 1fr;
  }
  .res__k {
    margin: 0 0 var(--space-3);
    font-size: var(--type-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: color-mix(in srgb, #fff 78%, transparent);
  }
  .res__posts {
    display: grid;
    gap: var(--space-3);
  }
  .rpost {
    display: block;
    padding: var(--space-4);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, #fff 5%, transparent);
    border: 1px solid color-mix(in srgb, #fff 14%, transparent);
    text-decoration: none;
    transition:
      background-color 160ms var(--ease-standard, ease),
      transform 160ms var(--ease-standard, ease);
  }
  .rpost:hover {
    background: color-mix(in srgb, #fff 9%, transparent);
  }
  .rpost__cat {
    font-size: var(--type-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-emphasis);
  }
  .rpost__t {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--type-h4);
    line-height: 1.25;
    color: #fff;
  }
  .res__more {
    display: inline-block;
    margin-block-start: var(--space-4);
    color: var(--color-emphasis);
    font-weight: 600;
    text-decoration: none;
  }
  .res__more:hover,
  .res__more:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .res__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .res__box {
    padding: var(--space-5);
    border-radius: var(--radius-control);
    background: color-mix(in srgb, #fff 5%, transparent);
    border: 1px solid color-mix(in srgb, #fff 14%, transparent);
  }
  .res__box-h {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--type-h4);
    color: #fff;
  }
  .res__box-p {
    margin: 0 0 var(--space-2);
    font-size: var(--type-body-sm);
    line-height: 1.5;
    color: color-mix(in srgb, #fff 78%, transparent);
  }
  .res__box .res__more {
    margin-block-start: var(--space-1);
  }
  .quicklinks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2) var(--space-4);
  }
  .quicklinks a {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: 0.1rem;
    font-size: var(--type-body-sm);
    color: color-mix(in srgb, #fff 82%, transparent);
    text-decoration: none;
  }
  .quicklinks a::before {
    content: '↗';
    color: var(--color-emphasis);
    font-size: 0.8em;
  }
  .quicklinks a:hover,
  .quicklinks a:focus-visible {
    color: var(--color-emphasis);
  }
  .res__empty {
    padding: var(--space-5);
    border-radius: var(--radius-control);
    border: 1px dashed color-mix(in srgb, #fff 24%, transparent);
    color: color-mix(in srgb, #fff 78%, transparent);
  }
  @media (min-width: 880px) {
    .res__grid {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-7);
    }
  }
  .section__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }
  .section__h {
    font-size: var(--type-h2);
    color: var(--color-action);
  }
  .section__sub {
    font-size: var(--type-body);
    color: var(--color-text-muted);
    margin-block: var(--space-2) var(--space-4);
    max-inline-size: 62ch;
  }
  .section__more {
    margin-block-start: var(--space-4);
  }
  .section__more a {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
  }
  /* Brief company introduction — a single confident lead line, generously spaced. */
  .intro__lead {
    font-size: var(--type-body-lg);
    line-height: 1.6;
    max-inline-size: 68ch;
    color: var(--color-text);
    margin-block: var(--space-2) var(--space-4);
  }

  .hero {
    position: relative;
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-6) var(--space-4);
    display: grid;
    gap: var(--space-6);
    align-items: center;
    /* A luxury-architectural LIGHT quality — morning haze, not a landmark.
       Directional left→right: bright and clean on the left (behind the copy, so
       the headline stays crisply readable), warming to a soft golden haze toward
       the centre-right. Airy whites, warm neutrals only (no grey/blue), edge-
       faded so there's no visible box. All values tunable here; layout untouched. */
    background:
      /* clean highlight over the copy — airy, but eased so the warm ground reads */
