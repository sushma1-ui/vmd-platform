---
import Base from '../../layouts/Base.astro';
import { articleSchema, breadcrumbSchema } from '@vmd/seo';
import { Disclaimer } from '@vmd/ui';
import { cms } from '../../lib/cms.ts';
import { lexicalToHtml } from '../../lib/lexical.ts';

// ONE renderer for the whole Knowledge Centre (ARCHITECTURE.md §2.2). Static paths
// come from the CMS; if the CMS is unreachable at build, zero paths are generated
// (the /resources/blog listing still renders its empty state).
export async function getStaticPaths() {
  const posts = await cms.articles();
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
const path = Astro.url.pathname;
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Resources', path: '/resources/' },
  { name: 'Migration Insights', path: '/resources/blog/' },
  { name: post.title, path },
];
---
<Base
  title={post.title}
  description={post.excerpt ?? post.title}
  type="article"
  schemas={[articleSchema(post, path), breadcrumbSchema(trail)]}
>
  <article class="post">
    <nav class="crumbs" aria-label="Breadcrumb">{trail.map((t, i) => <span>{i > 0 && <span aria-hidden="true"> / </span>}<a href={t.path}>{t.name}</a></span>)}</nav>
    <p class="post__eyebrow">{String(post.category).replace(/-/g, ' ')}</p>
    <h1 class="post__title">{post.title}</h1>
    <p class="post__byline">By Sunil Uprety, Registered Migration Agent · MARN 2318234{post.reviewedBy?.lastReviewedAt && ` · Last reviewed ${new Date(post.reviewedBy.lastReviewedAt).toLocaleDateString('en-AU')}`}</p>
    <div class="post__body" set:html={lexicalToHtml(post.content)} />
    <Disclaimer variant="generalInformation" />
  </article>
</Base>
<style>
  .post { max-inline-size: var(--container-prose); margin-inline: auto; padding: var(--space-7) var(--space-4) var(--space-9); }
  .crumbs { font-size: var(--type-caption); color: var(--color-text-muted); margin-block-end: var(--space-4); }
  .crumbs a { color: inherit; text-decoration: none; }
  .post__eyebrow { font-size: var(--type-caption); letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-text-muted); }
  .post__title { font-size: var(--type-display-2); margin-block: var(--space-2) var(--space-2); }
  .post__byline { font-size: var(--type-body-sm); color: var(--color-text-muted); margin-block-end: var(--space-5); }
  .post__body { font-size: var(--type-body); line-height: 1.75; }
  .post__body :global(p) { margin-block-end: var(--space-3); }
</style>
