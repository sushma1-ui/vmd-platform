---
import SimplePage from '../../components/content/SimplePage.astro';
import { getCtaLinks } from '../../lib/cms.ts';
const { healthCheckUrl } = await getCtaLinks();
---

<SimplePage
  title="Resources"
  description="Guides, the Visa Health Check, processing times and FAQs for Australian migration."
  eyebrow="Knowledge Centre"
  lead="Plain-English guidance on Australian migration — gathered in one place, and reviewed by a Registered Migration Agent."
  cta={{ href: healthCheckUrl, label: 'Start the Visa Health Check' }}
>
  <p>
    Here you'll find the Free Visa Health Check, migration insights, current processing times,
    frequently asked questions and practical guides — written to make the process clearer, whatever
    stage you're at.
  </p>
</SimplePage>
