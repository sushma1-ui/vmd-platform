---
import SimplePage from '../../../components/content/SimplePage.astro';
import { PRACTICE, RMA_STATEMENT } from '@vmd/config';
import { getCtaLinks } from '../../../lib/cms.ts';
const { bookUrl } = await getCtaLinks();
const address = `${PRACTICE.address.street}, ${PRACTICE.address.locality} ${PRACTICE.address.region} ${PRACTICE.address.postcode}`;
---

<SimplePage
  title="Migration Agent Perth"
  description={`Registered Migration Agent (RMA): ${PRACTICE.principal.name} in Perth CBD — ${PRACTICE.legalName} | MARN: ${PRACTICE.principal.marn}.`}
  eyebrow="Perth"
  lead={`The head term. A practice led by a named Registered Migration Agent at ${PRACTICE.address.street}.`}
  cta={{ href: bookUrl, label: 'Book in Perth' }}
>
  <p>
    {RMA_STATEMENT} Find us at {address} — by appointment, in person or online.
  </p>
</SimplePage>
