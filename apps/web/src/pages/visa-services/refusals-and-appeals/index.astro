---
import Base from '../../../layouts/Base.astro';
import { breadcrumbSchema } from '@vmd/seo';
import { Disclaimer, Chip } from '@vmd/ui';
import DeadlineChecker from '../../../components/islands/DeadlineChecker.island.astro';
import SecondOpinionForm from '../../../components/islands/SecondOpinionForm.island.astro';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Visa Services', path: '/visa-services/' },
  { name: 'Refusals & Appeals', path: '/visa-services/refusals-and-appeals/' },
];
---

<Base
  title="Visa Refused or Cancelled? Reviews & Appeals in Perth"
  description="A refusal is not always the end — but the deadlines are short. ART review, a fixed-fee Second Opinion, and a deadline checker from a Registered Migration Agent in Perth."
  schemas={[breadcrumbSchema(trail)]}
>
  <article class="ref">
    <nav class="crumbs" aria-label="Breadcrumb">
      {
        trail.map((t, i) => (
          <span>
            {i > 0 && <span aria-hidden="true"> / </span>}
            <a href={t.path}>{t.name}</a>
          </span>
        ))
      }
    </nav>

    <header class="ref__hero">
      <p class="ref__eyebrow">Refusals, cancellations &amp; appeals</p>
      <h1 class="ref__title">
        A refusal is not always the end. But the deadlines are short, and they are strict.
      </h1>
      <p class="ref__lead">
        If a visa was refused or cancelled, the first thing that matters is time. Check your window,
        then talk to a registered agent.
      </p>
    </header>

    <section class="ref__tool"><DeadlineChecker /></section>

    <section class="ref__three">
      <div>
        <h2>What the ART is</h2><p>
          The Administrative Review Tribunal independently reviews many visa refusal and
          cancellation decisions. It can affirm, vary, or set a decision aside.
        </p>
      </div>
      <div>
        <h2>What it costs</h2><p>
          An application fee applies, and our work is a fixed fee quoted before you commit. We
          itemise disbursements separately.
        </p>
      </div>
      <div>
        <h2>What we can't do</h2><p>
          We can't change the law or guarantee an outcome. We can tell you honestly whether review
          is worth pursuing, and prepare it properly if it is.
        </p>
      </div>
    </section>

    <section class="ref__second">
      <div class="ref__second-copy">
        <Chip>Flagship</Chip>
        <h2>The Second Opinion</h2>
        <p>
          A fixed-fee, independent review of an application or refusal prepared by someone else.
          Second opinions are what doctors give — and the person seeking one has already learned
          what bad advice costs.
        </p>
        <ul class="ref__list">
          <li>Independent read of what happened and why</li>
          <li>An honest view on whether review is worth pursuing</li>
          <li>A clear next step, in plain language</li>
        </ul>
      </div>
      <SecondOpinionForm />
    </section>

    <section class="ref__ledger">
      <h2>ART outcomes</h2>
      <div class="ref__ledger-empty">
        Set-aside and favourable-review outcomes are published here — dated, anonymised, ART only —
        as client consent is confirmed. No names, no photos, no success rates.
      </div>
      <Disclaimer variant="outcomes" />
    </section>
  </article>
</Base>
<style>
  .ref {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4) var(--space-9);
  }
  .crumbs {
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    margin-block-end: var(--space-5);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .ref__hero {
    max-inline-size: var(--container-prose);
    margin-block-end: var(--space-7);
  }
  .ref__eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .ref__title {
    font-size: var(--type-display-2);
    line-height: 1.08;
    margin-block: var(--space-2) var(--space-4);
  }
  .ref__lead {
    font-size: var(--type-body-lg);
    line-height: 1.5;
  }
  .ref__tool {
    max-inline-size: var(--container-prose);
    margin-block-end: var(--space-8);
  }
  .ref__three {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    margin-block-end: var(--space-8);
  }
  .ref__three h2 {
    font-size: var(--type-h3);
    margin-block-end: var(--space-2);
  }
  .ref__three p {
    font-size: var(--type-body);
    line-height: 1.6;
    color: var(--color-text);
  }
  .ref__second {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
    margin-block-end: var(--space-8);
    align-items: start;
  }
  .ref__second h2 {
    font-size: var(--type-h2);
    margin-block: var(--space-3);
  }
  .ref__second p {
    font-size: var(--type-body-lg);
    line-height: 1.5;
  }
  .ref__list {
    margin-block-start: var(--space-3);
    padding-inline-start: var(--space-4);
    line-height: 1.8;
  }
  .ref__ledger {
    max-inline-size: var(--container-prose);
  }
  .ref__ledger h2 {
    font-size: var(--type-h2);
    margin-block-end: var(--space-3);
  }
  .ref__ledger-empty {
    border: 1px dashed color-mix(in srgb, var(--color-emphasis) 55%, transparent);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }
  @media (min-width: 768px) {
    .ref__three {
      grid-template-columns: repeat(3, 1fr);
    }
    .ref__second {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
