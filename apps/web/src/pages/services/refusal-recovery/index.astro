---
import Base from '../../../layouts/Base.astro';
import { breadcrumbSchema, serviceSchema } from '@vmd/seo';
import { Disclaimer, Rule, Button } from '@vmd/ui';
import DeadlineChecker from '../../../components/islands/DeadlineChecker.island.astro';
import LastReviewed from '../../../components/content/LastReviewed.astro';

/**
 * Refusal Recovery — a named service line (register F9). The urgency-led landing for a
 * visa refusal or cancellation: understand the deadline, get a fixed-fee Second Opinion
 * on whether review is worth it, then (if it is) an ART review application. No outcome
 * or success-rate claims — deadlines are hedged, not asserted.
 */
const path = '/services/refusal-recovery/';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Migration Services', path: '/services/' },
  { name: 'Refusal Recovery', path },
];
const schemas = [
  breadcrumbSchema(trail),
  serviceSchema({
    name: 'Refusal Recovery',
    description:
      'Help after a visa refusal or cancellation — a fixed-fee Second Opinion and, where worthwhile, an ART review application, from a Registered Migration Agent in Perth.',
    path,
    serviceType: 'Migration advice',
  }),
];
---

<Base
  title="Refusal Recovery — visa refused or cancelled? Act now"
  description="Visa refused or cancelled? Review deadlines are strict. Start with a fixed-fee Second Opinion on whether a review is worth it, then an ART review application if it is — from a Registered Migration Agent in Perth."
  schemas={schemas}
>
  <section class="rr-hero">
    <div class="rr-hero__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        {
          trail.map((t, i) => (
            <span>
              {i > 0 && <span aria-hidden="true"> / </span>}
              <a href={t.path}>{t.name}</a>
            </span>
          ))
        }
      </nav>
      <p class="rr-flag">Priority · deadlines are strict</p>
      <h1 class="rr-hero__title">Refusal Recovery</h1>
      <Rule width="short" />
      <p class="rr-hero__lead">
        A visa refusal or cancellation isn't always the end — but the clock is running. Review
        deadlines are short and set by law, so the first step is knowing where you stand and how
        long you have.
      </p>
      <div class="rr-hero__cta">
        <Button variant="primary" href="/services/second-opinion/">Request a Second Opinion</Button>
        <Button variant="secondary" href="/contact/">Talk to us today</Button>
      </div>
    </div>
  </section>

  <div class="rr-body">
    <section class="rr-sec">
      <h2 class="rr-h">How long do you have?</h2>
      <p class="rr-sub">
        Review periods are short — often measured in working days from the date on your decision.
        This gives a general sense of urgency only; your actual deadline is set by law and your
        specific circumstances.
      </p>
      <DeadlineChecker />
    </section>

    <section class="rr-sec rr-sec--bone">
      <div class="rr-sec__inner">
        <h2 class="rr-h">Your path, in two steps</h2>
        <ol class="rr-steps">
          <li class="rr-step">
            <span class="rr-step__n" aria-hidden="true">1</span>
            <div>
              <h3>A fixed-fee Second Opinion</h3>
              <p>
                An independent review of your decision to tell you honestly whether a review is
                worth pursuing — a clear, straight answer either way.
              </p>
              <a class="rr-link" href="/services/second-opinion/">About the Second Opinion →</a>
            </div>
          </li>
          <li class="rr-step">
            <span class="rr-step__n" aria-hidden="true">2</span>
            <div>
              <h3>An ART review application</h3>
              <p>
                If review is the right move, we prepare and lodge your application to the
                Administrative Review Tribunal, carefully and on time.
              </p>
              <a class="rr-link" href="/services/art-review-applications/"
                >About ART review applications →</a
              >
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="rr-sec rr-sec--tight">
      <Disclaimer variant="generalInformation" />
      <LastReviewed />
    </section>
  </div>
</Base>

<style>
  .crumbs {
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    border-block-end: 1px solid var(--color-emphasis);
  }
  .rr-hero {
    background: var(--color-ground-warm);
  }
  .rr-hero__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4);
  }
  .rr-flag {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-critical);
    font-weight: 600;
  }
  .rr-hero__title {
    font-size: var(--type-display-1);
    line-height: var(--leading-display-1);
    margin-block: var(--space-2) 0;
  }
  .rr-hero__lead {
    font-size: var(--type-body-lg);
    line-height: 1.5;
    margin-block: var(--space-3) var(--space-4);
    max-inline-size: 60ch;
  }
  .rr-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .rr-body {
    max-inline-size: var(--container-max);
    margin-inline: auto;
  }
  .rr-sec {
    padding: var(--space-8) var(--space-4);
  }
  .rr-sec--tight {
    padding-block: var(--space-4);
  }
  .rr-sec--bone {
    background: var(--color-ground-warm);
  }
  .rr-sec__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
  }
  .rr-h {
    font-size: var(--type-h2);
    margin-block-end: var(--space-4);
  }
  .rr-sub {
    font-size: var(--type-body-lg);
    color: var(--color-text-muted);
    margin-block-end: var(--space-5);
    max-inline-size: 62ch;
  }
  .rr-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
    max-inline-size: 70ch;
  }
  .rr-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-5);
    background: var(--color-ground-light);
    border: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    border-radius: var(--radius-card);
  }
  .rr-step__n {
    inline-size: 2.4rem;
    block-size: 2.4rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--color-action);
    color: var(--color-text-inverse);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .rr-step h3 {
    font-size: var(--type-h3);
    color: var(--color-action);
    margin-block-end: var(--space-2);
  }
  .rr-step p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-block-end: var(--space-2);
  }
  .rr-link {
    color: var(--color-action);
    border-block-end: 1px solid var(--color-emphasis);
    text-decoration: none;
    font-size: var(--type-body-sm);
  }
</style>
