---
import Base from '../../../layouts/Base.astro';
import { breadcrumbSchema, serviceSchema } from '@vmd/seo';
import { Disclaimer, Rule, Button } from '@vmd/ui';
import SecondOpinionForm from '../../../components/islands/SecondOpinionForm.island.astro';
import LastReviewed from '../../../components/content/LastReviewed.astro';

/**
 * Second Opinion — a named service line (register F9). A fixed-fee, independent review
 * of a matter already underway, or a refusal/cancellation to assess. The intake is the
 * SecondOpinionForm; no outcome/success-rate claims anywhere.
 */
const path = '/services/second-opinion/';
const trail = [
  { name: 'Home', path: '/' },
  { name: 'Our Services', path: '/services/' },
  { name: 'Second Opinion', path },
];
const schemas = [
  breadcrumbSchema(trail),
  serviceSchema({
    name: 'Second Opinion',
    description:
      'A fixed-fee, independent review of a migration matter — from a Registered Migration Agent in Perth.',
    path,
    serviceType: 'Migration advice',
  }),
];
---

<Base
  title="Second Opinion — an independent review of where you stand"
  description="A fixed-fee, independent review of a migration matter already underway — or a visa refusal or cancellation you want assessed — from a Registered Migration Agent in Perth."
  schemas={schemas}
>
  <section class="so-hero">
    <div class="so-hero__inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        {
          trail.map((t, i) => (
            <span>
              {i > 0 && <span aria-hidden="true"> / </span>}
              <a href={t.path}>{t.name}</a>
            </span>
          ))
        }
      </nav>
      <p class="eyebrow">Fixed fee · independent</p>
      <h1 class="so-hero__title">Second Opinion</h1>
      <Rule width="short" />
      <p class="so-hero__lead">
        A fresh, independent review of where your matter really stands — from a Registered Migration
        Agent. Honest, quoted before you commit, and the next step is always yours to decide.
      </p>
      <div class="so-hero__cta">
        <Button variant="primary" href="#request">Request a Second Opinion</Button>
      </div>
    </div>
  </section>

  <div class="so-body">
    <section class="so-sec">
      <h2 class="so-h">When a second opinion helps</h2>
      <ul class="so-list">
        <li>You're partway through a matter and unsure the advice you've had is right for you.</li>
        <li>
          Your visa was <strong>refused or cancelled</strong> and you need to know if a review is worth
          pursuing.
        </li>
        <li>
          You're about to lodge something important and want it checked by an independent agent
          first.
        </li>
      </ul>
    </section>

    <section class="so-sec so-sec--bone">
      <div class="so-sec__inner">
        <h2 class="so-h">What you get</h2>
        <div class="so-grid">
          <div class="so-card">
            <h3>An honest read</h3>
            <p>
              A clear, plain-English assessment of where your case genuinely stands — including the
              best time and way to move forward.
            </p>
          </div>
          <div class="so-card">
            <h3>Clear next steps</h3>
            <p>
              What your realistic options are, what each involves, and what we would do next if you
              engaged us.
            </p>
          </div>
          <div class="so-card">
            <h3>Yours to decide</h3>
            <p>
              You work directly with the Registered Migration Agent, and the next step is always
              yours to decide.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="so-sec" id="request">
      <h2 class="so-h">Request a Second Opinion</h2>
      <p class="so-sub">
        Tell us a little about your matter and we'll come back to you. If a deadline applies, say so
        — we prioritise time-critical matters.
      </p>
      <SecondOpinionForm />
    </section>

    <section class="so-sec so-sec--tight">
      <Disclaimer variant="generalInformation" />
      <LastReviewed />
    </section>
  </div>
</Base>

<style>
  .crumbs {
    font-size: var(--type-caption);
    color: var(--color-text-muted);
    margin-block-end: var(--space-4);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    border-block-end: 1px solid var(--color-emphasis);
  }
  .eyebrow {
    font-size: var(--type-caption);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .so-hero {
    background: var(--color-ground-warm);
  }
  .so-hero__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
    padding: var(--space-7) var(--space-4);
  }
  .so-hero__title {
    font-size: var(--type-display-1);
    line-height: var(--leading-display-1);
    margin-block: var(--space-2) 0;
  }
  .so-hero__lead {
    font-size: var(--type-body-lg);
    line-height: 1.5;
    margin-block: var(--space-3) var(--space-4);
    max-inline-size: 60ch;
  }
  .so-body {
    max-inline-size: var(--container-max);
    margin-inline: auto;
  }
  .so-sec {
    padding: var(--space-8) var(--space-4);
  }
  .so-sec--tight {
    padding-block: var(--space-4);
  }
  .so-sec--bone {
    background: var(--color-ground-warm);
  }
  .so-sec__inner {
    max-inline-size: var(--container-max);
    margin-inline: auto;
  }
  .so-h {
    font-size: var(--type-h2);
    margin-block-end: var(--space-4);
  }
  .so-sub {
    font-size: var(--type-body-lg);
    color: var(--color-text-muted);
    margin-block-end: var(--space-5);
    max-inline-size: 62ch;
  }
  .so-list {
    display: grid;
    gap: var(--space-3);
    padding-inline-start: var(--space-4);
    max-inline-size: 66ch;
    line-height: 1.6;
  }
  .so-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
  }
  .so-card {
    padding: var(--space-5);
    background: var(--color-ground-light);
    border: 1px solid color-mix(in srgb, var(--color-action) 10%, transparent);
    border-radius: var(--radius-card);
  }
  .so-card h3 {
    font-size: var(--type-h3);
    color: var(--color-action);
    margin-block-end: var(--space-2);
  }
  .so-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  @media (min-width: 860px) {
    .so-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
